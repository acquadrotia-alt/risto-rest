				Dim vObjectToCharSequence As Object = "Si sono verificati problemi nella procedura di " & SmartStringFormatter("", testo) & ""
				Dim vObjectToCharSequence2 As Object = vStr8
				Msgbox2(vObjectToCharSequence, vObjectToCharSequence2, "OK", "", "", vBmp1)
				Continue
			Case 7
				rsState = 8
				Continue
			Case 8
				rsState = -1
				Continue
			Case 9
				rsState = 1
				pnl = wf9_0
				pnl.LoadLayout("schedalottery")
				edtLotteryDAZ.RequestFocus
				vCustomLayoutDialog2.GetButton(-1).Enabled = False
