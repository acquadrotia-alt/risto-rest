Sub Sub094
	Dim z As Boolean
	Dim dirDefaultExternal As String = File.DirDefaultExternal
	File.Copy(dirDefaultExternal, "Anagra.db", File.DirDefaultExternal, "AnagraCopy.db")
	Dim archiverForB4A As ArchiverForB4A
	Dim dirDefaultExternal2 As String = File.DirDefaultExternal
	archiverForB4A.ZipFiles(dirDefaultExternal2, Array As String("AnagraCopy.db"), mod1.vStr4, "BKAnagra.zip", "")
	If v_salvavd = 1 Then
		CallSub3(httpclient, "UpdVis2", "BKAnagra.zip", 10)
		Return
	End If
	If v_salvavd = 2 Then
		Try
			If File.Exists(v_usbpath, "BKAnagra.Anon_1") Then
				mod1.Sub147(v_usbpath, "BKAnagra.Anon_1", v_usbpath, "BKAnagra.Anon_2")
			End If
			File.Copy(mod1.vStr4, "BKAnagra.zip", v_usbpath, "BKAnagra.Anon_1")
			z = True
		Catch
			z = False
		End Try
		If z Then
			z = File.Exists(v_usbpath, "BKAnagra.Anon_1")
		End If
		If Not(z) Then
			ToastMessageShow("ATTENZIONE ... il sistema non sta eseguendo le copie di emergenza ... " & CRLF & "Errore durante la copia nel percorso " & v_usbpath & CRLF & "Chiamare assistenza tecnica", True)
			Return
		End If
		Return
	End If
	If v_salvavd = 3 Then
		Dim object As Class = rpidevice
		CallSub3(object, "tUpload", mod1.vStr4, "BKAnagra.zip")
		Return
	End If
End Sub

Sub Sub095(str As String, sql As SQL)
	mod1.vStr2 = "Sub CorreggiGiacenza"
	Try
	Catch
		mod1.Sub217(LastException.Message)
	End Try
	If vInt25 > 0 Or vBln83 Then
		Return
	End If
	Dim cursorWrapper As Cursor = sql.ExecQuery("select * from Venduto where nmov = " & str)
	Dim rowCount As Int = cursorWrapper.RowCount - 1
	Dim i As Int
	For i = 0 To rowCount
		cursorWrapper.Position = i
		Dim replace As String = NumberFormat2(cursorWrapper.GetDouble("qta"), 1, 3, 3, False).Replace(",", ".")
		If vStr6 <> "" And cursorWrapper.GetInt("brep") = 0 Then
			If vStr6 = "in" Then
				replace = vSql3.ExecQuerySingleResult("Select sum(qta) from Venduto  where nmov = " & vLng11 & " and  codint ='" & cursorWrapper.GetString("codint") & "'")
			End If
			vSql1.ExecNonQuery("update anagra set flgmag = 1," & Sub177(replace) & " where flgusointerno=0 and codint ='" & cursorWrapper.GetString("codint") & "'")
		Else If vStr6 = "" And cursorWrapper.GetInt("brep") = 0 Then
			vSql1.ExecNonQuery("update anagra set  " & Sub177(replace) & " where flgmag = 1 and codint ='" & cursorWrapper.GetString("codint") & "'")
		End If
		If vSql1.ExecQuerySingleResult("Select count(*) from anagra where distinta = 1 and codint ='" & cursorWrapper.GetString("codint") & "'") > 0 And vStr6 <> "in" Then
			Dim cursorWrapper2 As Cursor = vSql1.ExecQuery("Select * from distintabase where codint = '" & cursorWrapper.GetString("codint") & "'")
			If cursorWrapper2.RowCount > 0 Then
				Dim rowCount2 As Int = cursorWrapper2.RowCount - 1
				Dim i2 As Int
				For i2 = 0 To rowCount2
					cursorWrapper2.Position = i2
					Dim replace2 As String = NumberFormat2(cursorWrapper2.GetDouble("qta") * cursorWrapper.GetDouble("qta"), 1, 3, 3, False).Replace(",", ".")
					If vStr6 <> "" Then
						vSql1.ExecNonQuery("update anagra set flgmag = 1," & Sub177(replace2) & " where flgusointerno=0 and codint ='" & cursorWrapper2.GetString("codintpadre") & "'")
					Else
						vSql1.ExecNonQuery("update anagra set  " & Sub177(replace2) & " where  codint ='" & cursorWrapper2.GetString("codintpadre") & "'")
					End If
				Next
			End If
			cursorWrapper2.Close
		End If
	Next
	cursorWrapper.Close
End Sub

