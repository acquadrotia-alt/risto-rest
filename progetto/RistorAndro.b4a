Sub Sub260
	Dim str As String
	Dim d As Double
	Dim i As Int
	mod1.vStr2 = "Sub ShowTotArticolo"
	Dim d2 As Double = 0
	Try
		If Not(vBln4) Then
			d2 = vCur13.GetDouble("importo")
		End If
		Dim i2 As Int = 0
		Dim rowCount As Int = vCur9.RowCount - 1
		Dim d3 As Double = d2
		Dim i3 As Int = 0
		Do While i3 <= rowCount
			vCur9.Position = i3
			Dim vObjectToNumber As Double = IIf(v_checkvarianti, vDbl3, 1)
			Dim vObjectToString As String = vLst29.Get(vCur9.Position)
			Dim f As Float = 0
			If vObjectToString.Trim <> "" Then
				Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select bvar,list1,list2,list3,list4,list5 from anagra where lower(ltrim(rtrim(codint))) = '" & vCur9.GetString("codint") & "'")
				If cursorWrapper.RowCount > 0 Then
					cursorWrapper.Position = 0
					f = cursorWrapper.GetDouble("list1") * vObjectToNumber
					i2 = i2 + 1
					If cursorWrapper.GetInt("bvar") = 1 Then
						If vObjectToString.Trim.ToLowerCase = "-" Then
							f = vObjectToNumber * cursorWrapper.GetDouble("list2")
						Else If vObjectToString.Trim.ToLowerCase = "molto" Then
							If v_listmolto > 0 Then
								f = vObjectToNumber * Round2(cursorWrapper.GetDouble("list1") * (1 + v_listmolto / 100), 2)
							End If
						Else If vObjectToString.Trim.ToLowerCase = "poco" And v_listpoco > 0 Then
							f = Round2(cursorWrapper.GetDouble("list1") - cursorWrapper.GetDouble("list1") * v_listpoco / 100, 2)
						End If
					End If
				End If
				cursorWrapper.Close
				Dim f2 As Float = IIf(vBln99 And vMap16.ContainsKey(vCur9.GetString("codint")), 0, f)
				If vBln4 Then
					If v_tipofrazionamentovariazioni = 3 Then
						d = d3 + Round2(f2, v_arrotondav)
						i = i2
					Else If v_tipofrazionamentovariazioni <> 1 Then
						d = d3 + Round2(f2 * vDbl4, v_arrotondav)
						i = i2
					End If
				Else
					d = d3 + f2
					i = i2
				End If
				i3 = i3 + 1
				d3 = d
				i2 = i
			End If
			d = d3
			i = i2
			i3 = i3 + 1
			d3 = d
			i2 = i
		Loop
		If vInt33 > 0 Then
			If vInt33 <= 10 Then
				If i2 > vInt33 Then
					str = "_Superato il numero massimo di variazioni per questo articolo"
					lblTotaleV.Text = "Totale Articolo: " & NumberFormat2(d3, 1, 2, 2, False) & " €"
					lblTotaleV.Tag = d3 & str
					Return
				End If
			Else If vInt33 > 10 And i2 <> vInt33 - 10 Then
				str = "_Devi inserire " & vInt33 - 10 & " variazioni"
				lblTotaleV.Text = "Totale Articolo: " & NumberFormat2(d3, 1, 2, 2, False) & " €"
				lblTotaleV.Tag = d3 & str
				Return
			End If
		End If
		str = "_OK"
		lblTotaleV.Text = "Totale Articolo: " & NumberFormat2(d3, 1, 2, 2, False) & " €"
		lblTotaleV.Tag = d3 & str
		Return
	Catch
		mod1.Sub217(LastException.Message)
		Return
	End Try
End Sub

