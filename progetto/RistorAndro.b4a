Sub Sub226(buttonWrapper As Button)
	vBtn3 = buttonWrapper
	Dim vSplit() As String = Regex.Split(",", vBtn3.Tag)
	Dim trim As String = vSplit(0).Trim
	Dim trim2 As String = vSplit(1).Trim
	Dim str As String = ""
	If IsNumber(trim2) Then
		str = vfunzioni1.Sub024(trim, trim2)
	End If
	If trim = t_tavolo Then
		GetMenuTavolo(trim2, buttonWrapper)
	Else If trim = t_tastierino Then
		Dim trim3 As String = vSplit(2).Trim
		Dim trim4 As String = vSplit(3).Trim
		Dim text As String = vBtn3.Text
		If vLbl2(trim3, trim4).Visible Then
			text = vLbl2(trim3, trim4).Text
		End If
		If text = "C" Then
			If vLng11 > 0 And Not(Sub072(vCur3.GetString("funzioni"), f_cancellatutto, False)) Then
				lblDisplay.Text = ""
				Return
			End If
			If Sub056() Then
				Return
			End If
			eseguifunzione(f_cancellatutto)
		End If
	Else If trim = t_reparto Then
		Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select codint,descrizione from anagra where  bvar=0 and reparto ='" & trim2 & "' and substr(codint,1,3)='mnu' and locked=0 order by indice, upper(descrizione)")
		Dim list As List
		Dim list2 As List
		If cursorWrapper.RowCount > 0 Then
			list.Initialize
			list2.Initialize
			Dim rowCount As Int = cursorWrapper.RowCount - 1
			Dim i As Int
			For i = 0 To rowCount
				cursorWrapper.Position = i
				Dim replace As String = cursorWrapper.GetString("codint").Replace("mnu", "")
				Dim parseDouble As Int = vSql1.ExecQuerySingleResult("Select count(*) from dettmnu where mnuattivo=1 and codmnu =" & SmartStringFormatter("", replace) & " ")
				If parseDouble > 0 Then
					Dim vAppend As CSBuilder = vCSBuilder1.Initialize.Size(18).Append(cursorWrapper.GetString("descrizione")).Append(CRLF)
					vAppend.Color(-65536).Append(parseDouble & " ARTICOLI")
					list2.Add(replace)
					list.Add(vCSBuilder1.PopAll)
				End If
			Next
			If list.Size > 0 Then
				Dim str2 As String = ""
				If list.Size = 1 Then
					str2 = list2.Get(0)
				Else
					Dim vInputList As Int = InputList(list, "Seleziona un menù dall'elenco", -1)
					If vInputList >= 0 Then
						str2 = list2.Get(vInputList)
					End If
				End If
				If str2 <> "" Then
					addRowPlu("mnu" & str2, False, False, "", False, "")
					lblDisplay.Text = ""
					Return
				End If
			End If
		End If
	Else If trim = t_plu Then
		Dim vTmp As String = Sub256(trim2, False, "")
		If vTmp <> "" Then
			ShowMsgBoxInfoArticolo(vTmp, "Info Articolo", buttonWrapper, trim2)
		End If
	Else If str <> "" Then
		ShowMsgBoxInfoArticolo(str, mod1.Sub097(trim, trim2), buttonWrapper, trim2)
	End If
End Sub

