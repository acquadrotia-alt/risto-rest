			File.WriteString(File.DirDefaultExternal, "Proc" & i & ".txt", vGetInstalledPackages.Get(vInputList1) & TAB & list.Get(vInputList1))
			vSql1.ExecNonQuery("update pagine set testo='" & list.Get(vInputList1) & "',importo= " & i & " where chiave =" & vCur26.GetString("chiave"))
		Else
			vSql1.ExecNonQuery("update pagine set testo='" & mod1.Sub097(t_funzione, f_shell) & "', importo= 0 where chiave =" & vCur26.GetString("chiave"))
		End If
	End If
End Sub

