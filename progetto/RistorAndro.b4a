			vSql1.ExecNonQuery("update pagine set testo='" & vTmp(1) & "',importo= " & i & " where chiave =" & vCur26.GetString("chiave"))
			Return
		End If
		If vMsgbox2 = -3 Then
			Return
		End If
	End If
	Dim packageManagerWrapper As PackageManager
	Dim vGetInstalledPackages As List = packageManagerWrapper.GetInstalledPackages
	vGetInstalledPackages.Add("ANNULLA TUTTO")
	Initialize
