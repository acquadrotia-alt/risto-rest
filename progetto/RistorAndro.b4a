														Dim vNumberToString2 As String = vCur26.GetInt("valore")
														buttonWrapper.Tag = vNumberToString & "," & vNumberToString2 & "," & trim & "," & trim2
														buttonWrapper.Text = vCur26.GetString("testo")
														vLst12.Clear
														Sub247(vCur26.GetInt("dimensione"), buttonWrapper, vCur26)
														Sub208(vLst12, buttonWrapper)
														Sub232(vCur26.GetInt("colore"), vCur26.GetInt("coloret"), buttonWrapper, vCur26.GetInt("plurep") = 1, vCur26.GetInt("textsize"))
														If vNumberToString = t_tastierino And vCur26.GetInt("textsize") = 0 Then
															buttonWrapper.TextSize = 26
														Else If vNumberToString = t_tastierino And vCur26.GetInt("textsize") > 0 Then
															buttonWrapper.TextSize = vCur26.GetInt("textsize")
														End If
														Dim vTmp________ As String = Sub239(vNumberToString, vCur26.GetString("dll"), vNumberToString2, vCur26.GetInt("importo"))
														Dim vTmp_________ As Int = modfunstr.Sub006(trim)
														Sub238(buttonWrapper, vTmp_________, modfunstr.Sub006(trim2), vTmp________)
													End If
												Else
													vSql1.ExecNonQuery("update pagine set textsize = " & vCur27.GetString("textsize") & ", importo = " & vCur27.GetString("importo").Replace(",", ".") & ",testo ='" & vCur27.GetString("testo") & "',valore = " & vCur27.GetString("valore") & ",dimensione = " & vCur27.GetString("dimensione") & " ,colore  =  " & vCur27.GetString("colore") & ", coloret=" & vCur27.GetString("coloret") & ",tipo =" & vCur27.GetString("tipo") & ",dll ='" & vCur27.GetString("dll") & "',icona =" & vCur27.GetString("icona") & ",plurep=" & vCur27.GetString("plurep") & " where pagina = " & vInt30 & " and tasto = " & vCur26.GetString("tasto"))
												End If
												Sub089(True, True)
												Sub257(vBtn3, False)
												Return
											End If
										Else
											Msgbox2("Prima di Incollare è necessario copiare un tasto.", vStr8, "OK", "", "", vBmp1)
											vanimatedslidingmenu1.vLv1.Color = 0
										End If
									Else
										vanimatedslidingmenu1.vLv1.Color = 0
									End If
								End If
							End If
						End If
					End If
				End If
			End If
		End If
	End If
	mod1.Sub081
End Sub

Sub Tastoparameter_Click(i As Int)
	Dim str As String
	mod1.vStr2 = "Sub TastoParameter_Click(SelectedItem As Object)"
	Try
		If vInt80 = m_tipo And i <> vInt81 Then
			vSql1.ExecNonQuery("update pagine set icona=0,plurep =0,textsize=0,importo=0,dll='' where chiave =" & vCur26.GetString("chiave"))
			If i = t_tastierino Then
				Sub025(1, vCur26.GetString("chiave"))
			Else If i = t_funzione Then
				Sub026(f_stampaoggi, vCur26.GetString("chiave"), False)
			Else If i = t_nulla Then
				If vInt30 >= 100 Then
					vSql1.ExecNonQuery("update pagine set dimensione=1,testo='',tipo =" & t_plu & ",valore =0 where chiave =" & vCur26.GetString("chiave"))
				Else
					vSql1.ExecNonQuery("update pagine set testo='',tipo =" & i & ",valore =0 where chiave =" & vCur26.GetString("chiave"))
				End If
			Else If i = t_pagina Then
				Dim vInputList1 As Int = idLib.InputList1(vLst4, "Selezionare la pagina")
				If vInputList1 >= 0 Then
					vSql1.ExecNonQuery("update pagine set testo='" & vLst4.Get(vInputList1) & "',tipo =" & i & ",valore =" & vInputList1 + 1 & " where chiave =" & vCur26.GetString("chiave"))
				End If
			Else
				If i = t_plu And vInt30 < 100 Then
					vInt24 = d_plu
					vBln33 = True
					vBln32 = True
					vBln136 = True
					mod1.Sub198("tabelle")
					Return
				End If
				If i = t_plu And vInt30 >= 100 Then
					vSql1.ExecNonQuery("update pagine set dimensione=1, testo='',tipo =" & i & ",valore =0 where chiave =" & vCur26.GetString("chiave"))
				Else If i = t_reparto Then
					Dim vTmp As Int = mod1.Sub143("reparti", "Selezionare il reparto dall'elenco")
					If vTmp >= 0 Then
						vSql1.ExecNonQuery("update pagine set testo='" & vSql1.ExecQuerySingleResult("Select descrizione from reparti where codice = " & vTmp) & "',tipo =" & i & ",valore =" & vTmp & " where chiave =" & vCur26.GetString("chiave"))
					End If
				Else If i = t_pagamento Then
					Dim vTmp_ As Int = mod1.Sub143("pagamenti", "Selezionare il pagamento dall'elenco")
					If vTmp_ >= 0 Then
						vSql1.ExecNonQuery("update pagine set testo='" & vSql1.ExecQuerySingleResult("Select descrizione from pagamenti where codice = " & vTmp_) & "',tipo =" & i & ",valore =" & vTmp_ & " where chiave =" & vCur26.GetString("chiave"))
					End If
				Else
					vSql1.ExecNonQuery("update pagine set tipo =" & i & " where chiave =" & vCur26.GetString("chiave"))
				End If
			End If
		End If
		If vInt80 = m_valore And i <> vInt81 Then
			If vCur26.GetString("tipo") = t_tastierino Then
				Sub025(i, vCur26.GetString("chiave"))
			Else If vCur26.GetString("tipo") = t_funzione Then
				Sub026(i, vCur26.GetString("chiave"), True)
				If mod1.Sub105(t_funzione, vLst1.Get(i - 1)) = f_allergeni Then
					Dim vTmp__ As Int = mod1.Sub143("allergeni", "Selezionare un Allergene o Tag")
					Dim i2 As Int = IIf(vTmp__ >= 0, vTmp__, 0)
					vSql1.ExecNonQuery("update pagine set testo='" & vSql1.ExecQuerySingleResult("Select descrizione from allergeni where codice = " & i2) & "',importo =" & i2 & " where chiave =" & vCur26.GetString("chiave"))
				End If
			End If
		End If
	Catch
		mod1.Sub217(LastException.Message)
	End Try
	If vInt80 = m_icona Then
		vStr35 = ""
		If vCur26.GetString("tipo") = t_plu And vInt30 >= 100 Then
			Dim vSplit() As String = Regex.Split(",", vBtn3.Tag)
			vStr35 = vSplit(1).Trim
		End If
		If i <> vInt81 Then
			If Not(vBln61) And i = 27 Then
				Msgbox2("Non è stata inserita nessuna icona personalizzata.", vStr8, "OK", "", "", vBmp1)
				vanimatedslidingmenu2.Sub005(False, False)
				vLv1.Visible = False
				Sub089(True, True)
				Sub257(vBtn3, False)
				Return
			End If
			Sub199(Sub093(i))
			Return
		End If
		Dim str2 As String = "update pagine set icona =0,dll='' where chiave =" & vCur26.GetString("chiave")
		If vStr35 <> "" Then
			vSql1.ExecNonQuery("update anagra set colore =" & SmartStringFormatter("", vCur26.GetInt("colore")) & ",coloret =" & SmartStringFormatter("", vCur26.GetInt("coloret")) & "," & CRLF & TAB & TAB & TAB & TAB & TAB & TAB & TAB & TAB & TAB & TAB & TAB & TAB & "textsize =" & SmartStringFormatter("", IIf(vCur26.GetInt("textsize") = 0, vInt53, vCur26.GetInt("textsize"))) & "," & CRLF & TAB & TAB & TAB & TAB & TAB & TAB & TAB & TAB & TAB & TAB & TAB & TAB & "dll ='' where codint ='" & SmartStringFormatter("", vStr35) & "'")
			vStr35 = ""
		End If
		vSql1.ExecNonQuery(str2)
		vanimatedslidingmenu2.Sub005(False, False)
		vLv1.Visible = False
		Sub089(True, True)
		Sub257(vBtn3, False)
		Return
	End If
	If vInt80 = m_colore And i <> vInt81 Then
		If i = 16 Or i = 17 Then
			Return
		End If
		If vCur26.GetString("tipo") <> t_plu Or vInt30 < 100 Then
			str = ""
		Else
			str = Regex.Split(",", vBtn3.Tag)(1).Trim
		End If
		If i > 17 Then
			i = i - 17
			Dim vMsgbox2 As Int = Msgbox2("Si deridera applicare il colore a tutto i tasti di tipo '" & mod1.Sub097(m_tipo, vCur26.GetInt("tipo")) & "' ? ", vStr8, "Si", "", "No", vBmp1)
			If vMsgbox2 = -1 Then
				If i = c_custom Then
					Dim colorDialog As ColorDialog
					colorDialog.RGB = Colors.RGB(128, 128, 128)
					Dim vShow As Int = colorDialog.Show("Selezionare il colore desiderato", "Si", "", "No", vBmp1)
					If vShow = -1 Then
						Sub233(colorDialog.RGB, " where tipo =" & vCur26.GetInt("tipo"), str)
						Sub234(vInt30)
					End If
				Else
					Sub233(i, " where tipo =" & vCur26.GetInt("tipo"), str)
					Sub234(vInt30)
				End If
			End If
		Else If i = c_custom Then
			Dim colorDialog2 As ColorDialog
			colorDialog2.RGB = Colors.RGB(128, 128, 128)
			Dim vShow2 As Int = colorDialog2.Show("Selezionare il colore desiderato", "Si", "", "No", vBmp1)
			If vShow2 = -1 Then
				Sub233(colorDialog2.RGB, " where chiave =" & vCur26.GetString("chiave"), str)
				Sub234(vInt30)
			End If
		Else
			Sub233(i, " where chiave =" & vCur26.GetString("chiave"), str)
		End If
	End If
	If vInt80 = m_dimensione And i <> vInt81 Then
		If i = 2 Or i = 4 Then
			Sub062(i)
		End If
		If i = 3 And vCur26.GetInt("riga") - 1 >= 0 And vBtn1(vCur26.GetInt("riga") - 1, vCur26.GetInt("colonna")).Height < vInt22 + 5 Then
			If vCur26.GetInt("tipo") = t_plu Then
				vSql1.ExecNonQuery("update pagine set tipo =" & t_plu & " where riga=" & vCur26.GetInt("riga") - 1 & " and colonna=" & vCur26.GetInt("colonna") & " and pagina =100")
				vSql1.ExecNonQuery("update pagine set dimensione =1,icona =0,testo='',dll='',tipo =" & t_plu & ",valore =0 where riga=" & vCur26.GetInt("riga") - 1 & " and colonna=" & vCur26.GetInt("colonna") & " and pagina =" & vInt60)
			Else
				vSql1.ExecNonQuery("update pagine set dimensione =1,icona =0,testo='',dll='',tipo =" & t_nulla & ",valore =0 where riga=" & vCur26.GetInt("riga") - 1 & " and colonna=" & vCur26.GetInt("colonna") & " and pagina =" & vInt60)
			End If
		End If
		vSql1.ExecNonQuery("update pagine set dimensione =" & i & " where chiave =" & vCur26.GetString("chiave"))
	End If
	vanimatedslidingmenu2.Sub005(False, False)
	vanimatedslidingmenu1.vLv1.Color = 0
	If i <> vInt81 Then
		Sub089(True, True)
		Sub257(vBtn3, False)
	End If
End Sub

Sub Tastotb_Click(i As Int)
	mod1.vStr2 = "Sub Tasto_Click(SelectedItem As Object)"
	Try
		vInt80 = i
	Catch
		mod1.Sub217(LastException.Message)
	End Try
	If i = m_chiudi Then
		Sub089(False, False)
		Return
	End If
	Select i
		Case 1
			Dim inputDialog2 As InputDialog = vDlg1
			vDlg1.InputType = 1
			vDlg1.Input = ""
			vDlg1.PasswordMode = False
			vDlg1.Hint = "Inserire un testo"
			vDlg1.HintColor = Colors.ARGB(196, 255, 140, 0)
			Dim vShow As Int = vDlg1.Show("Inserire il testo per il tasto", vStr8, "Ok", "Annulla", "", vBmp1)
			If vShow <> -1 Then
				vanimatedslidingmenu1.vLv1.Color = 0
			Else
				vDlg1.Input = modfunstr.left(vDlg1.Input, 50)
				Dim vSplit() As String = Regex.Split(",", vBtn3.Tag)
				vSql1.ExecNonQuery("update Despagine set descrizione = '" & mod1.Sub209(vDlg1.Input.Trim) & "' where codice = " & vSplit(1))
				vBtn3.Text = mod1.Sub209(vDlg1.Input.Trim)
				Sub253(vBtn3, vBtn3.Text)
				Sub185()
				Sub089(True, True)
				Sub258(vBtn3)
				mod1.Sub081
				Return
			End If
		Case 2
			Dim vInputList1 As Int = idLib.InputList1(vLst7, "Selezionare la Sala")
			If vInputList1 >= 0 Then
				Dim vSplit2() As String = Regex.Split(",", vBtn3.Tag)
				vSql1.ExecNonQuery("update Toolbar set valore =" & vInputList1 + 10 & " where codice =" & vSplit2(2))
				vBtn3.Tag = vSplit2(0) & "," & vInputList1 + 10 & "," & vSplit2(2)
				vBtn3.Text = vLst7.Get(vInputList1)
			End If
			Sub089(True, True)
			Sub258(vBtn3)
			Return
		Case 3
			If vCur19.GetInt("obbligocoperti") > 0 Then
				Msgbox2("Non è consentito attivare il servizio con l'obbligo del coperto attivo.", vStr8, "OK", "", "", vBmp1)
				vSql1.ExecNonQuery("update despagine set servizio = 0 where chiave = " & vCur19.GetString("chiave"))
			Else
				Dim numberDialog As NumberDialog
				numberDialog.Digits = 2
				numberDialog.Number = 0
				numberDialog.Decimal = 0
				numberDialog.ShowSign = False
				Dim vShow2 As Int = numberDialog.Show("Inserire la % per il Servizio", "Ok", "Annulla", "", vBmp1)
				vSql1.ExecNonQuery("update despagine set servizio = " & IIf(vShow2 <> -1 Or numberDialog.Number >= 100 Or numberDialog.Number <= 0, 0, numberDialog.Number) & " where chiave = " & vCur19.GetString("chiave"))
			End If
			Sub213()
			Sub089(True, True)
			Sub258(vBtn3)
			Return
		Case 4
			Dim list As List
			list.Initialize
			list.AddAll(ArrayToList(Array As String("Lascia Invariato", "Listino 1", "Listino 2", "Listino 3", "Listino 4")))
			Dim vInputList12 As Int = idLib.InputList1(list, "Selezionare il listino del coperto per questa sala")
			If vInputList12 < 0 Then
				vanimatedslidingmenu1.vLv1.Color = 0
			Else
				vSql1.ExecNonQuery("update despagine set listino = " & vInputList12 & " where chiave = " & vCur19.GetString("chiave"))
				Sub213()
				Sub089(True, True)
				Sub258(vBtn3)
				Return
			End If
		Case 5
			If vCur19.GetDouble("servizio") > 0 Then
				Msgbox2("Non è consentito attivare l'obbligo del coperto con il servizio attivo.", vStr8, "OK", "", "", vBmp1)
				vSql1.ExecNonQuery("update despagine set obbligocoperti = 0 where chiave = " & vCur19.GetString("chiave"))
			Else
				vSql1.ExecNonQuery("update despagine set obbligocoperti = " & IIf(vCur19.GetInt("obbligocoperti") = 1, "0", "1") & " where chiave = " & vCur19.GetString("chiave"))
			End If
			Sub213()
			Sub089(True, True)
			Sub258(vBtn3)
			Return
		Case 6
			Dim list2 As List
			list2.Initialize
			list2.AddAll(ArrayToList(Array As String("Lascia Invariato", "Listino 1", "Listino 2", "Listino 3", "Listino 4")))
			Dim vInputList13 As Int = idLib.InputList1(list2, "Selezionare il listino del coperto per questa sala")
			If vInputList13 < 0 Then
				vanimatedslidingmenu1.vLv1.Color = 0
			Else
				vSql1.ExecNonQuery("update despagine set listinocoperti = " & vInputList13 & " where chiave = " & vCur19.GetString("chiave"))
				Sub213()
				Sub089(True, True)
				Sub258(vBtn3)
				Return
			End If
		Case 7
			vSql1.ExecNonQuery("update despagine set noazzera = " & IIf(vCur19.GetInt("noazzera") = 1, "0", "1") & " where chiave = " & vCur19.GetString("chiave"))
			Sub213()
			Sub089(True, True)
			Sub258(vBtn3)
			Return
		Case 8
			vSql1.ExecNonQuery("update despagine set nopalmari = " & IIf(vCur19.GetInt("nopalmari") = 1, "0", "1") & " where chiave = " & vCur19.GetString("chiave"))
			Sub213()
			Msgbox2("è necessario effettuare l'aggiornamento dei palmari.", vStr8, "OK", "", "", vBmp1)
			Sub089(True, True)
			Sub258(vBtn3)
			Return
		Case 9
			vSql1.ExecNonQuery("update despagine set chiedimemo2 = " & IIf(vCur19.GetInt("chiedimemo2") = 1, "2", IIf(vCur19.GetInt("chiedimemo2") = 2, "0", "1")) & " where chiave = " & vCur19.GetString("chiave"))
			Sub213()
			Sub089(True, True)
			Sub258(vBtn3)
			Return
		Case Else
			vanimatedslidingmenu1.vLv1.Color = 0
	End Select
	mod1.Sub081
End Sub

