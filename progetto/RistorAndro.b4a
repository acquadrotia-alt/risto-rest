Sub messaggioerogazioneinfinity(str As String)
	Dim z As Boolean
	Dim z2 As Boolean
	'vCSBuilder1 = CSBuilder
	Try
		Dim vSplit() As String = Regex.Split("_", str)
		Dim stringBuilderWrapper As StringBuilder
		stringBuilderWrapper.Initialize
		vCSBuilder1.Initialize
		If vSplit.Length <> 0 And vSplit.Length Mod 4 = 0 Then
			Dim length As Int = vSplit.Length - 1
			Dim i As Int = 0
			z = False
			Do While i <= length
				Dim str2 As String = vSql1.ExecQuerySingleResult("SELECT Descrizione FROM anagra where codint=" & vSplit(i)) & CRLF
				vCSBuilder1.Append(vSplit(i) & " " & str2)
				If vSplit(i + 1).Trim <> "1" Then
					vCSBuilder1.Color(-15041536)
					vCSBuilder1.Append(vSplit(i + 1) & " Articoli erogati").Pop
				Else
					vCSBuilder1.Color(-15041536)
					vCSBuilder1.Append(vSplit(i + 1) & " Articolo erogato").Pop
				End If
				If vSplit(i + 2).Trim <> "1" Then
					If vSplit(i + 2).Trim <> "0" Then
						vCSBuilder1.Color(-65536)
						vCSBuilder1.Append(", " & vSplit(i + 2) & " non erogati." & CRLF).Pop
						stringBuilderWrapper.Append(vSplit(i)).Append(TAB).Append(str2).Append(TAB).Append(vSplit(i + 2) & " non erogati.").Append(TAB).Append(" ").Append(TAB)
						If Not(z) Then
							z2 = True
						End If
						z2 = z
					Else
						vCSBuilder1.Append("." & CRLF)
						z2 = z
					End If
				Else
					vCSBuilder1.Color(-65536).Bold
					vCSBuilder1.Append(", " & vSplit(i + 2) & " non erogato." & CRLF).Pop.Pop
					stringBuilderWrapper.Append(vSplit(i)).Append(TAB).Append(str2).Append(TAB).Append(vSplit(i + 2) & " non erogato.").Append(TAB).Append(" ").Append(TAB)
					If Not(z) Then
						z2 = True
					End If
					z2 = z
				End If
				If vSplit(i + 3).Trim <> "0" Then
					vCSBuilder1.Append(vSplit(i + 3) & CRLF & CRLF)
				Else
					vCSBuilder1.Append(CRLF)
				End If
				i = i + 4
				z = z2
			Loop
		Else
			vCSBuilder1.Append(str.Replace("_", CRLF))
			z = Not(False)
		End If
		If z Then
			Dim i2 As Int = -1
			Do While True
				If i2 = -2 Then
					Exit
				End If
				i2 = Msgbox2(vCSBuilder1.PopAll, vStr8, "", "", "Ok", vBmp1)
			Loop
		End If
		If stringBuilderWrapper.ToString.length > 0 Then
			vccefdll1.nf_apri(v_intestanf)
			vccefdll1.nf_testo("Erogazione Tabacchi", 4)
			vccefdll1.nf_testo(" ", 4)
			Dim vSplit2() As String = Regex.Split(TAB, stringBuilderWrapper.ToString)
			Dim length2 As Int = vSplit2.Length - 1
			Dim i3 As Int
			For i3 = 0 To length2
				vccefdll1.nf_testo(vSplit2(i3), 1)
			Next
			vccefdll1.nf_chiudi
			Return
		End If
		Return
	Catch
		Log("MessaggioErogazioneInfinity: " & LastException.Message)
		mod1.Sub217("MessaggioErogazioneInfinity: " & LastException.Message)
		Return
	End Try
End Sub

Sub Sub201
	If Not(mod1.vMap5.IsInitialized) Then
		Return
	End If
	If mod1.vMap5.Size > 0 Then
		Dim size As Int = mod1.vMap5.Size - 1
		Dim i As Int
		For i = 0 To size
			Dim vObjectToString As String = mod1.vMap5.GetValueAt(i)
			Dim vObjectToString2 As String = mod1.vMap5.GetKeyAt(i)
			Dim substring As String = vObjectToString2.SubString2(0, vObjectToString2.IndexOf("_"))
			Dim str As String = ""
			If vSql1.ExecQuerySingleResult("Select count(*) from MPTitoloIniziative where codice = (select Codice from MPRicompense where  ElementoRicompensa ='" & vObjectToString & "' limit 1)") > 0 Then
				str = vSql1.ExecQuerySingleResult("Select Descrizione from MPTitoloIniziative where codice = (select Codice from MPRicompense where  ElementoRicompensa ='" & vObjectToString & "' limit 1)")
			End If
			If vSql1.ExecQuerySingleResult("Select count(*) from MPMessaggiCliente where CodiceMsg='" & vObjectToString & "'") > 0 Then
				Dim vExecQuerySingleResult As String = vSql1.ExecQuerySingleResult("Select MessaggioMsg from MPMessaggiCliente where CodiceMsg='" & vObjectToString & "'")
				If substring = "MS" Or substring = "MQ" Then
					vccefdll1.nf_apri(v_intestanf)
					vccefdll1.nf_testo(str, 4)
					vccefdll1.nf_testo(vStr19, 1)
					If vExecQuerySingleResult <> "" Then
						vccefdll1.nf_testo("********************************", 1)
						Dim vTmp As String = mod1.Sub213(vExecQuerySingleResult, 32, "")
						Dim vSplit() As String = Regex.Split(CRLF, vTmp)
						Dim length As Int = vSplit.Length - 1
						Dim i2 As Int
						For i2 = 0 To length
							If vSplit(i2) <> "" Then
								vccefdll1.nf_testo(vSplit(i2).Trim, 1)
							End If
						Next
						vccefdll1.nf_testo("********************************", 1)
					End If
					vccefdll1.nf_chiudi
				End If
			End If
		Next
		mod1.vMap5.Clear
		Return
	End If
End Sub

Sub Sub202(str As String) As Boolean
	mod1.vStr2 = "Sub ModificaCopertoPerSC(Tipo As String) As Boolean"
	Try
		Dim parseDouble As Int = vSql1.ExecQuerySingleResult("Select case when sum(qta) is null then 0 else sum(qta) end as tot from Ventmp where codint ='888888' or codint ='888889'")
		Dim parseDouble2 As Int = vSql1.ExecQuerySingleResult("select count(distinct(sottoconto)) from Ventmp where sottoconto >0")
		Dim parseDouble3 As Int = vSql1.ExecQuerySingleResult("select max(sottocontoT) from Ventmp")
		Dim z As Boolean = IIf(str = "del" And parseDouble2 = 0, IIf(vSql1.ExecQuerySingleResult("select count(*) from Ventmp where (codint ='888888' or codint ='888889') and chiave <>" & vCur16.GetString("chiave")) > 0, vSql1.ExecQuerySingleResult("select sum(qta) from Ventmp where (codint ='888888' or codint ='888889') and chiave <>" & vCur16.GetString("chiave")) < 2, True), False)
		If (str = "less" And parseDouble2 = 0 And parseDouble <= 2) Or (str = "del" And parseDouble2 = 0 And z) Then
			Dim str2 As String = "Attenzione ... Riducendo ancora il numero dei coperti verrà annullata la gestione dei sottoconti." & CRLF & "Si desidera continuare ?"
			If str = "del" And parseDouble2 = 0 Then
				str2 = "Attenzione ... Eliminando i coperti verrà annullata la gestione dei sottoconti." & CRLF & "Si desidera continuare ?"
			End If
			Dim vMsgbox2 As Int = Msgbox2(str2, vStr8, "Si", "", "No", vBmp1)
			If vMsgbox2 <> -1 Then
				Return False
			End If
			vBln141 = False
			vSql1.ExecNonQuery("update Ventmp set sottocontoT=0,sottoconto=0,memo=''")
			refilltablelist(True)
			Return True
		End If
		If str = "less" And (parseDouble <= parseDouble3 Or parseDouble <= 2) Then
			If parseDouble2 = 0 And parseDouble <= parseDouble3 And parseDouble > 2 Then
				vSql1.ExecNonQuery("update Ventmp set sottocontoT=" & parseDouble - 1)
				Return True
			End If
			ToastMessageShow("Non possibile ... esistono sottoconti legati a questi coperti ...", True)
			Return False
		End If
		If str <> "del" Then
			Return True
		End If
		If parseDouble - vCur16.GetInt("qta") >= parseDouble3 And parseDouble - vCur16.GetInt("qta") >= 2 Then
			Return True
		End If
		If parseDouble2 = 0 And parseDouble - vCur16.GetInt("qta") < parseDouble3 And parseDouble - vCur16.GetInt("qta") >= 2 Then
			vSql1.ExecNonQuery("update Ventmp set sottocontoT=" & parseDouble - vCur16.GetInt("qta"))
			Return True
		End If
		ToastMessageShow("Non possibile ... esistono sottoconti legati a questi coperti ...", True)
		Return False
	Catch
		mod1.Sub217(LastException.Message)
		Return False
	End Try
End Sub

