Sub Sub024 As Boolean
	Try
		Dim str As String = IIf(vBln12, "importod", "importo")
		If vSql1.ExecQuerySingleResult("Select count(*) from Ventmp where " & str & "<0 and flgNF=0 and substr(memo,1,6)<>'Doc.N.'") > 0 Then
			Sub261("abb")
			Sub261("pre")
			Dim cursorWrapper As Cursor = vSql1.ExecQuery("SELECT sum(" & str & ") as TotIva,iva" & TAB & "FROM [Ventmp] where flgNF=0 and substr(memo,1,6)<>'Doc.N.'  group by iva ")
			Dim rowCount As Int = cursorWrapper.RowCount - 1
			Dim i As Int
			For i = 0 To rowCount
				cursorWrapper.Position = i
				If cursorWrapper.GetDouble("TotIva") < 0 Then
					Dim vExecQuerySingleResult As String = vSql1.ExecQuerySingleResult("Select descrizione from Ventmp where flgNF=0 and " & SmartStringFormatter("", str) & "<0 and iva=" & SmartStringFormatter("", cursorWrapper.GetString("iva")) & " limit 1 ")
					vCur4.Position = cursorWrapper.GetInt("iva")
					Msgbox2("Non è possibile proseguire a causa della riga '" & SmartStringFormatter("", vExecQuerySingleResult) & "' :" & CRLF & TAB & TAB & TAB & TAB & "l'iva " & SmartStringFormatter("", vCur4.GetString("aliquota2")) & "% risulterebbe negativa ", vStr8, "Ok", "", "", vBmp1)
					mod1.Sub081
					Return False
				End If
			Next
			cursorWrapper.Close
		End If
	Catch
		mod1.Sub217(LastException.Message)
	End Try
	Return True
End Sub

Sub Sub025(i As Int, str As String)
