					cursorWrapper2 = vSql2.ExecQuery("Select case when reparti.descrizione is null then '' else reparti.descrizione end as Des,case when sum(qta) is null then 0 else sum(qta) end as Tot FROM [Venduto] inner join headmov on headmov.nmov = venduto.nmov inner join reparti on venduto.reparto = reparti.codice where headmov.causale='pr' and headmov.tavolo = 0 AND brep = 0 AND lower(substr(venduto.codint,1,3))<>'mnu' AND lower(substr(venduto.codint,1,3))<>'msg' AND lower(substr(venduto.codice,1,2))<>'vv' and lower(substr(venduto.codice,1,2))<>'ww' and substr(headmov.datam2,12,5) ='" & cursorWrapper.GetString("descrizione") & "' and headmov.datam3 >='" & str & " " & str4 & ":00' and headmov.datam3 <='" & str & " 23:59:59' union Select case when reparti.descrizione is null then '' else reparti.descrizione end as Des,case when sum(qta) is null then 0 else sum(qta) end as Tot FROM [Venduto] inner join headmov on headmov.nmov = venduto.nmov inner join reparti on venduto.reparto = reparti.codice where headmov.causale='pr' and headmov.tavolo = 0 AND brep = 0 AND lower(substr(venduto.codint,1,3))<>'mnu' AND lower(substr(venduto.codint,1,3))<>'msg' AND lower(substr(venduto.codice,1,2))<>'vv' and lower(substr(venduto.codice,1,2))<>'ww' and substr(headmov.datam2,12,5) ='" & cursorWrapper.GetString("descrizione") & "' and headmov.datam3 >='" & str3 & " 00:00:00' and headmov.datam3 <'" & str3 & " " & str4 & ":00' group by reparti.descrizione")
