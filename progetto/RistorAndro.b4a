Sub btnResoImporto_Click
	If lblResoDoc.Text.StartsWith("Nel caso non si disponga") Then
		If btnMatricola.Tag <> "" Then
			Msgbox2("Non è possibile indicare il numero del movimento quando è stata specificata una matricola o un elemento di ricerca.", vStr8, "OK", "", "", vBmp1)
			Return
		End If
		Dim inputDialog2 As InputDialog = vDlg1
		vDlg1.InputType = 2
		vDlg1.Hint = "movimento numero ..."
		vDlg1.Input = ""
		vDlg1.PasswordMode = False
