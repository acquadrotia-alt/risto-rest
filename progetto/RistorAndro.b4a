Sub TB1_CheckedChange(z As Boolean)
	If vBln2 Then
		Return
	End If
	vBln2 = True
	Dim toggleButtonWrapper As ToggleButton = Sender
	If toggleButtonWrapper.Checked Then
		Select toggleButtonWrapper.Tag
			Case "1"
				TB2.Checked = False
				TB3.Checked = False
			Case "2"
				TB1.Checked = False
				TB3.Checked = False
			Case "3"
				TB2.Checked = False
				TB1.Checked = False
		End Select
	End If
	vBln2 = False
End Sub

