End Sub

'### RISTRUTTURARE: Resumable Sub convertita come macchina a stati (comportamento identico all'originale).
Sub VerificaChiusureRT(bmessage As Boolean, stmpmatricola As String)
	Dim stesto As String
	Dim result As Int
	Dim sres As String
	Dim in_ As Intent
	Dim rsState As Int = 0
	Dim rsCatchState As Int = 0
	Do While True
		Try
			Select rsState
				Case -1
					Return
				Case 0
					rsState = 1
					Continue
				Case 1
					rsState = 38
					rsCatchState = 37
					rsState = 3
					Continue
				Case 3
					rsState = 4
					rsCatchState = 37
					stesto = vccefdll1.rt_checkzpending
					Continue
				Case 4
					rsState = 35
					If stesto <> "" Then
						rsState = 6
						Continue
					Else If Not(bmessage) Then
						Continue
					Else
						rsState = 34
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 6
				Case 6
					rsState = 7
					Continue
				Case 7
					rsState = 32
					If stesto.Contains("non inviate") Or stesto.Contains("non inviata") Then
						rsState = 11
						Continue
					Else
						rsState = 9
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 9
				Case 9
					rsState = 32
					ToastMessageShow(stesto.Replace("Si desidera tentare l'invio ?", ""), True)
					Continue
				Case 11
					rsState = 12
					Dim vObjectToCharSequence As Object = stesto
					Dim vObjectToCharSequence2 As Object = vStr8
					Msgbox2Async(vObjectToCharSequence, vObjectToCharSequence2, "Si", "", "No", vBmp1, False)
					Wait For (Null) Msgbox_Result (wf39_0 As Int)
					rsState = 39
					Continue
				Case 12
					rsState = 31
					Dim i As Int = result
					If i <> -1 Then
						Continue
					Else
						rsState = 14
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 14
				Case 14
					rsState = 15
					sres = ""
					Continue
				Case 15
					rsState = 30
					If Not(stmpmatricola.StartsWith("ST")) Then
						rsState = 23
						Continue
					Else
						rsState = 17
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 17
				Case 17
					rsState = 18
					Continue
				Case 18
					rsState = 21
					If vInt28 <> 1 Then
						Continue
					Else
						rsState = 20
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 20
				Case 20
					rsState = 21
					Dim vObjectToCharSequence3 As Object = "Per questa funzione è necessario una versione 3 o superiore dell'UtilityRT." & CRLF & "Inviare i dati attraverso 'UtilityRT' --> 'Menu Esercente' --> 'Forza Invio' o attendere la prossima chiusura"
					Dim vObjectToCharSequence4 As Object = vStr8
					Msgbox2(vObjectToCharSequence3, vObjectToCharSequence4, "Ok", "", "", vBmp1)
					Return
				Case 21
					rsState = 30
					'in_ = Intent
					Dim intentWrapper As Intent = in_
					Dim intentWrapper2 As Intent = in_
					intentWrapper.Initialize("android.intent.action.MAIN", "forceclosure://custom.com/0/")
					in_.SetComponent("com.custom.utilityrt/.ZSplashActivity")
					vStr2 = "ZPending"
					startactivityforresult(in_)
					Continue
				Case 23
					rsState = 24
					sres = vccefdll1.rt_sendzpending
					ProgressDialogHide
					Continue
				Case 24
					rsState = 29
					If sres <> "" Then
						rsState = 26
						Continue
					Else If Not(bmessage) Then
						Continue
					Else
						rsState = 28
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 26
				Case 26
					rsState = 29
					Dim vObjectToCharSequence5 As Object = sres
					Dim vObjectToCharSequence6 As Object = vStr8
					Msgbox2(vObjectToCharSequence5, vObjectToCharSequence6, "OK", "", "", vBmp1)
					Continue
				Case 28
					rsState = 29
					Dim vObjectToCharSequence7 As Object = "Le chiusure in sospeso sono state inviate correttamente"
					Dim vObjectToCharSequence8 As Object = vStr8
					Msgbox2(vObjectToCharSequence7, vObjectToCharSequence8, "OK", "", "", vBmp1)
					Continue
				Case 29
					rsState = 30
					Continue
				Case 30
					rsState = 31
					Continue
				Case 31
					rsState = 32
					Continue
				Case 32
					rsState = 35
					Continue
				Case 34
					rsState = 35
					Dim vObjectToCharSequence9 As Object = "Non esiste nessuna chiusura in sospeso da inviare al server AE"
					Dim vObjectToCharSequence10 As Object = vStr8
					Msgbox2(vObjectToCharSequence9, vObjectToCharSequence10, "OK", "", "", vBmp1)
					Continue
				Case 35
					rsState = 38
					Continue
				Case 37
					rsState = 38
					rsCatchState = 0
					mod1.Sub217(LastException.Message)
					Continue
				Case 38
					rsState = -1
					rsCatchState = 0
					Continue
				Case 39
					rsState = 12
					result = wf39_0
					Continue
			End Select
		Catch
			If rsCatchState = 0 Then
				Log(LastException)
				Return
			End If
			rsState = rsCatchState
		End Try
	Loop
End Sub

Sub Sub019
	If Not(vBln45) Then
		Return
	End If
	vMap18.Initialize
	Dim cursorWrapper As Cursor = vSql1.ExecQuery("select qta,Oldqta,idRiga from Ventmp where qta-Oldqta <> 0")
	If cursorWrapper.RowCount <= 0 Then
		Return
	End If
	Dim rowCount As Int = cursorWrapper.RowCount - 1
	Dim i As Int
	For i = 0 To rowCount
		cursorWrapper.Position = i
		vMap18.Put(cursorWrapper.GetString("idRiga"), Round2(cursorWrapper.GetDouble("qta") - cursorWrapper.GetDouble("Oldqta"), 3))
	Next
End Sub

Sub Sub020(j As Long) As Long
	If v_prenotagiorniapertura = "1111111" Then
		Return j
	End If
	Dim vGetDayOfWeek As Int = DateTime.GetDayOfWeek(j)
	If v_prenotagiorniapertura.SubString2(vGetDayOfWeek - 1, vGetDayOfWeek) <> "0" Then
		Return j
	End If
	Dim i As Int = 1
	Do While True
		Dim i2 As Int = i
		If i2 > 6 Then
			Return j
		End If
		Dim vAdd As Long = DateTime.Add(j, 0, 0, i2)
		Dim vGetDayOfWeek2 As Int = DateTime.GetDayOfWeek(vAdd)
		If v_prenotagiorniapertura.SubString2(vGetDayOfWeek2 - 1, vGetDayOfWeek2) = "1" Then
			Return vAdd
		End If
		i = i2 + 1
	Loop
End Sub

Sub Sub021(str As String, str2 As String)
	If str2 <> "" Then
		Dim vMsgbox2 As Int = Msgbox2(str2, vStr8, "Si", "", "No", vBmp1)
		If vMsgbox2 <> -1 Then
			Return
		End If
	End If
	vBln7 = True
	vStr2 = "Lottery"
	Dim intentWrapper As Intent
	intentWrapper.Initialize("android.intent.action.MAIN", "lottery://custom.com/" & SmartStringFormatter("", str) & "/TEST/")
	intentWrapper.SetComponent("com.custom.utilityrt/.LotterySplashActivity")
	CallSub2(Me, "StartActivityForResult", intentWrapper)
End Sub

Sub Sub022(str As String) As List
	Dim exc As Exception
	Dim list As List
	Dim list2 As List
	Dim i As Int = 1
	Try
		'list2 = List
	Catch
		exc = e
		list = Null
	End Try
	Try
		list2.Initialize
		Dim i2 As Int
		For i2 = 1 To 9
			Dim sb2 As String = mod1.vStr4 & "/T" & i2
			Dim list3 As List
			list3.Initialize
			list3.AddAll(File.ListFiles(sb2))
			list3.Sort(True)
			Dim size As Int = list3.Size - 1
			Dim i3 As Int
			For i3 = 0 To size
				Dim lowerCase As String = list3.Get(i3).ToLowerCase
				If lowerCase.Contains("_") And lowerCase.StartsWith("rileva") Then
					Dim vSplit() As String = Regex.Split("_", lowerCase)
					If vSplit(2).ToLowerCase = "sc" Then
						vSplit(2) = ""
					End If
					If vSplit(2).ToLowerCase = str Or vSplit(2).ToLowerCase = "ge" Then
						Dim vSize As CSBuilder = vCSBuilder1.Initialize.Size(18)
						vSize.Typeface(Typeface.MONOSPACE)
						vCSBuilder1.Color(-65536)
						If vSplit(2).ToLowerCase = "ge" Then
							vCSBuilder1.Append(modfunstr.left("Rilevazione" & modfunstr.Sub004(16), 16))
						Else
							vCSBuilder1.Append(modfunstr.left(Sub171(str.ToLowerCase) & modfunstr.Sub004(16), 16))
						End If
						Dim vPop As CSBuilder = vCSBuilder1.Pop
						vPop.Append(modfunstr.Sub003("   " & i, 3) & " del ").Append(vSplit(1))
						i = i + 1
						vCSBuilder1.Append(" (T" & i2 & ")")
						list2.Add(vCSBuilder1.PopAll)
						vLst10.Add(list3.Get(i3))
					End If
				End If
			Next
		Next
		Return list2
	Catch
		list = list2
		exc = e2
		mod1.Sub217(LastException.Message)
		Return list
	End Try
End Sub

Sub Sub023(i As Int, str As String)
	If vSql1.ExecQuerySingleResult("select count(*) from pagine where tipo =" & t_tavolo & " and valore =" & i) > 0 Then
		Dim vMsgbox2 As Int = Msgbox2("Il tavolo risulta già essere inserito." & CRLF & "Si desidera continuare ?", vStr8, "Si", "", "No", vBmp1)
		If vMsgbox2 = -2 Then
			Return
		End If
	End If
	vSql1.ExecNonQuery("update pagine set dimensione=1,colore=" & c_verde & ",testo='" & ("Tavolo " & i) & "' ,tipo =" & t_tavolo & "  ,valore=" & i & " where chiave = " & str)
	Sub233(c_verde, " where chiave = " & str, "")
End Sub

