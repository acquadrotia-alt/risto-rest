Sub Sub198(str As String)
	Dim replace As String
	vUltimateListView2.ClearContent
	Sub103()
	Dim str2 As String = " where "
	If str <> "" Then
		str2 = " and "
	End If
	Dim replace2 As String = vStr64.Replace("[testo]", "(select testo from pagine where pagina >=10  AND pagina <100 AND valore = tavoli.tavolo AND tipo = 9 limit 1) as testo")
	Select lHeadRicercaT.Tag
		Case "0"
			str = str & str2 & " testo is not null and tavolo <1000"
			replace = replace2
		Case "1"
			str = str & str2 & " tavolo >= 20000 "
			replace = vStr64.Replace("[testo]", "'Tessera ' || tavolo as testo")
		Case Else
			replace = replace2
	End Select
	vSql1.ExecNonQuery("insert into sortedRicercaT(" & SmartStringFormatter("", vStr64) & ") select " & SmartStringFormatter("", replace) & " from tavoli " & SmartStringFormatter("", str) & " ")
	vUltimateListView2.BulkAddItems(vSql1.ExecQuerySingleResult("Select count(*) from sortedRicercaT"), "ROW", 0)
End Sub

