Sub Sub035(i As Int, buttonWrapper As Button) As Int
	Dim cursorWrapper As Cursor = vSql2.ExecQuery("Select Cliente,Memo,nmov  from PrenotaRisorsa where chiave=" & SmartStringFormatter("", i) & " ")
	If cursorWrapper.RowCount = 0 Then
		cursorWrapper.Close
		Return -1
	End If
	cursorWrapper.Position = 0
	vCSBuilder1.Initialize.Size(16).Bold.Append(cursorWrapper.GetString("Cliente")).Pop
	If cursorWrapper.GetString("Memo") <> "" Then
		vCSBuilder1.Size(12).Append(CRLF & cursorWrapper.GetString("Memo"))
	End If
	If cursorWrapper.GetInt("nmov") > 0 Then
		vCSBuilder1.Size(12).Append(" (" & cursorWrapper.GetString("nmov") & ")")
	End If
	buttonWrapper.Text = vCSBuilder1.PopAll
	Dim vGetInt As Int = cursorWrapper.GetInt("nmov")
	cursorWrapper.Close
	Return vGetInt
End Sub

Sub Sub036(str As String)
	Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select * from Venduto where lower(substr(codice,1,2))<>'vv' and lower(substr(codice,1,2))<>'ww' and nmov = " & TAB & str)
	If cursorWrapper.RowCount > 0 Then
		Dim rowCount As Int = cursorWrapper.RowCount - 1
		Dim i As Int
		For i = 0 To rowCount
			cursorWrapper.Position = i
			If vSql1.ExecQuerySingleResult("select count(*) FROM Venduto where (lower(substr(codice,1,2))='vv' or lower(substr(codice,1,2))='ww') and chiave <>" & cursorWrapper.GetString("chiave") & " and totcre ='" & cursorWrapper.GetString("totcre") & "' and nmov = " & str) > 0 Then
				vSql1.ExecNonQuery("update Venduto set importo2 = (Select Case when sum(importo) Is Null Then 0 Else sum(importo) End from Venduto where (lower(substr(codice,1,2))='vv' or lower(substr(codice,1,2))='ww') and chiave <>" & cursorWrapper.GetString("chiave") & " AND totcre ='" & cursorWrapper.GetString("totcre") & "' and nmov = " & str & ") where chiave =" & cursorWrapper.GetString("chiave"))
			End If
		Next
	End If
	cursorWrapper.Close
End Sub

Sub Sub037
	vStr33 = " order by chiave "
	Select v_ordinamentosc
		Case 1
			vStr33 = " order by reparto "
		Case 2
			vStr33 = " order by (select indice from reparti where reparti.codice= VenTmp.reparto)"
		Case 3
			vStr33 = " order by upper(descrizione) "
	End Select
End Sub

Sub Sub038(i As Int)
	Dim vNumberToString As String = i
	Dim i2 As Int = i - 99
	If i2 > 0 Then
		ProgressDialogShow("Elaborazione Pagina dinamica " & SmartStringFormatter("", i2) & "")
		DoEvents
		DoEvents
		Dim cursorWrapper As Cursor = vSql1.ExecQuery("SELECT * FROM pagine where pagina =" & SmartStringFormatter("", vNumberToString) & " and (tipo = " & SmartStringFormatter("", t_plu) & " or tipo=" & SmartStringFormatter("", t_pludinamicosospeso) & ") order by riga desc ,colonna")
		If cursorWrapper.RowCount > 0 Then
			Dim list As List
			Dim list2 As List
			list.Initialize
			list2.Initialize
			Dim rowCount As Int = cursorWrapper.RowCount - 1
			Dim i3 As Int
			For i3 = 0 To rowCount
				cursorWrapper.Position = i3
				If i2 = 1 Then
					vSql1.ExecNonQuery("update pagine set dimensione =" & i2 & ",tipo =" & t_plu & " where riga=" & cursorWrapper.GetString("riga") & " and colonna=" & cursorWrapper.GetInt("colonna") & " and pagina =" & vNumberToString)
				Else
					vSql1.ExecNonQuery("update pagine set dimensione =1,tipo =" & t_pludinamicosospeso & " where riga=" & cursorWrapper.GetString("riga") & " and colonna=" & cursorWrapper.GetInt("colonna") & " and pagina =" & vNumberToString)
					If list.IndexOf(cursorWrapper.GetInt("colonna")) < 0 And list2.IndexOf(cursorWrapper.GetInt("riga")) < 0 Then
						If i2 = 2 Or i2 = 4 Then
							If cursorWrapper.GetInt("colonna") + 1 < vInt13 Then
								If Not(cursorWrapper.GetInt("colonna") + 1 <= vInt15 And vInt12 - cursorWrapper.GetInt("riga") <= vInt14) Then
									If Not(cursorWrapper.GetInt("riga") + 1 >= vInt12 And cursorWrapper.GetInt("colonna") + 4 >= vInt13) Then
										If list.IndexOf(cursorWrapper.GetInt("colonna")) = -1 Then
											list.Add(cursorWrapper.GetInt("colonna") + 1)
										End If
										vSql1.ExecNonQuery("update pagine set dimensione =1,tipo =" & t_pludinamicosospeso & " where riga=" & cursorWrapper.GetString("riga") & " and colonna=" & cursorWrapper.GetInt("colonna") + 1 & " and pagina =" & vNumberToString)
										vSql1.ExecNonQuery("update pagine set dimensione =" & i2 & ",tipo =" & t_plu & " where riga=" & cursorWrapper.GetString("riga") & " and colonna=" & cursorWrapper.GetInt("colonna") & " and pagina =" & vNumberToString)
									End If
								End If
							End If
							If i2 = 4 Then
								If cursorWrapper.GetInt("riga") - 1 >= 0 Then
									vSql1.ExecNonQuery("update pagine set dimensione =1, tipo =" & t_pludinamicosospeso & " where riga=" & cursorWrapper.GetInt("riga") - 1 & " and colonna=" & cursorWrapper.GetInt("colonna") & " and pagina =" & vNumberToString)
									vSql1.ExecNonQuery("update pagine set dimensione =1,tipo =" & t_pludinamicosospeso & " where riga=" & cursorWrapper.GetInt("riga") - 1 & " and colonna=" & cursorWrapper.GetInt("colonna") + 1 & " and pagina =" & vNumberToString)
									If list2.IndexOf(cursorWrapper.GetInt("riga") - 1) = -1 Then
										list2.Add(cursorWrapper.GetInt("riga") - 1)
									End If
								Else
									vSql1.ExecNonQuery("update pagine set dimensione =1,tipo =" & t_pludinamicosospeso & " where riga=" & cursorWrapper.GetString("riga") & " and colonna=" & cursorWrapper.GetInt("colonna") & " and pagina =" & vNumberToString)
								End If
							End If
