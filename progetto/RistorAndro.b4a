		End If
		If vCur16.GetString("memo") <> "" Then
			Dim vBold As CSBuilder = vCSBuilder1.Initialize.Append(labelWrapper.Text & CRLF).Bold
			labelWrapper.Text = vBold.Color(-12303292).Append(vCur16.GetString("memo").Replace("Doc.N._", "")).PopAll
			Return
		End If
		Return
	Catch
		mod1.Sub217(LastException.Message)
		Return
	End Try
End Sub

Sub Sub253(buttonWrapper As Button, str As String)
	Dim stringUtils As StringUtils
	buttonWrapper.Text = str
	buttonWrapper.TextSize = 72
	Dim textSize As Float = buttonWrapper.TextSize
	Dim vMeasureMultilineTextHeight As Int = stringUtils.MeasureMultilineTextHeight(buttonWrapper, str)
	Do While True
		If (textSize > 0.5 Or vMeasureMultilineTextHeight > buttonWrapper.Height - 16) And textSize > 0 Then
			textSize = textSize / 2
			vMeasureMultilineTextHeight = stringUtils.MeasureMultilineTextHeight(buttonWrapper, str)
			If vMeasureMultilineTextHeight > buttonWrapper.Height - 16 Then
				buttonWrapper.TextSize = buttonWrapper.TextSize - textSize
			Else
				buttonWrapper.TextSize = buttonWrapper.TextSize + textSize
			End If
		End If
	Loop
	If buttonWrapper.TextSize > 15 Then
		buttonWrapper.TextSize = 15
		Return
	End If
End Sub

Sub Sub254(str As String)
