Sub eseguimacro(str As String)
	If vSql1.ExecQuerySingleResult("Select count(*) from Macro where funzione >0 and codice = " & str) = 0 Then
		Return
	End If
	Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select * from Macro where funzione >0 and codice = " & str)
	Dim rowCount As Int = cursorWrapper.RowCount - 1
	Dim i As Int
	For i = 0 To rowCount
		cursorWrapper.Position = i
		If cursorWrapper.GetString("valore") <> "" Or (cursorWrapper.GetInt("funzione") <> f_ricercaarticoli And cursorWrapper.GetInt("funzione") <> f_ricercacliente And cursorWrapper.GetInt("funzione") <> f_abbuono And cursorWrapper.GetInt("funzione") <> f_menu) Then
			If cursorWrapper.GetInt("funzione") = f_ricercaarticoli Or cursorWrapper.GetInt("funzione") = f_ricercacliente Then
				If cursorWrapper.GetInt("funzione") = f_ricercaarticoli And cursorWrapper.GetInt("qta") > 0 Then
					vDbl19 = cursorWrapper.GetInt("qta")
				End If
				lblDisplay.Text = cursorWrapper.GetString("valore")
			Else If cursorWrapper.GetInt("funzione") = f_abbuono Then
				lblDisplay.Text = cursorWrapper.GetInt("valore") / 100
				Sub138(False)
				lblDisplay.Text = ""
			Else If cursorWrapper.GetInt("funzione") = f_ricevuta Then
				If vBln129 Then
					vBln129 = False
				End If
			Else If cursorWrapper.GetInt("funzione") = f_fattura Then
				If vBln127 Then
					vBln127 = False
				End If
			Else If cursorWrapper.GetInt("funzione") = f_menu Then
				If vCur15.IsInitialized Then
					If vSql1.ExecQuerySingleResult("Select count(*) from dettmnu where mnuattivo=1 and codmnu =" & vCur15.GetString("importo")) = 0 Then
						Msgbox2("Nessun articolo all'interno di questo menù", vStr8, "OK", "", "", vBmp1)
					Else
						addRowPlu("mnu" & vCur15.GetString("importo"), False, False, "", False, "")
					End If
				End If
			End If
			eseguifunzione(cursorWrapper.GetInt("funzione"))
		End If
	Next
	cursorWrapper.Close
End Sub

Sub Sub131(str As String, z As Boolean) As Boolean
	If v_termsala Then
