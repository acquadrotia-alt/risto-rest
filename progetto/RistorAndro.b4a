				dateDialog.DayOfMonth = vDate.SubString2(3, 5)
				Dim dateTicks As Long = dateDialog.DateTicks
				If Not(vBln45) Then
					dateTicks = Sub020(DateTime.Add(dateTicks, 0, 0, v_prenotagiorni))
				End If
				dateDialog.DateTicks = dateTicks
				dateDialog.Show("Impostare la data per la prenotazione", "Data prenotazione", "Ok", "", "", vBmp1)
				Dim vAdd As Long = DateTime.Add(dateDialog.DateTicks, 0, 0, 1)
				If vAdd < mod1.Sub058 Then
					Msgbox2("Data non valida.", vStr8, "OK", "", "", vBmp1)
				Else
					Dim vTmp As Long = Sub020(dateDialog.DateTicks)
					If dateDialog.DateTicks <> vTmp Then
						Dim sb2 As String = DateUtils.getdayofweekname(vTmp) & " " & DateTime.GetDayOfMonth(vTmp) & " " & DateUtils.getmonthname(vTmp)
						Dim sb4 As String = DateUtils.getdayofweekname(dateDialog.DateTicks) & " " & DateTime.GetDayOfMonth(dateDialog.DateTicks) & " " & DateUtils.getmonthname(dateDialog.DateTicks)
						Dim vMsgbox2 As Int = Msgbox2("Attenzione ... " & CRLF & "La data indicata (" & sb4 & ") è relativa ad un giorno in cui l'attività risulta essere chiusa. " & CRLF & "La prima data utile dalla data indicata risulta essere " & sb2 & CRLF & "Effettuare una scelta ", vStr8, sb4, "Nuova data", sb2, vBmp1)
						If vMsgbox2 <> -3 Then
							If vMsgbox2 = -2 Then
								dateDialog.DateTicks = vTmp
							End If
						Else
							Continue
						End If
					End If
					Dim str As String = dateDialog.Year & "-" & NumberFormat(dateDialog.Month, 2, 0) & "-" & NumberFormat(dateDialog.DayOfMonth, 2, 0)
					Dim dateTicks2 As Long = dateDialog.DateTicks
					Dim sb6 As String = DateTime.GetYear(dateTicks2 + 86400000) & "-" & NumberFormat(DateTime.GetMonth(r2), 2, 0) & "-" & NumberFormat(DateTime.GetDayOfMonth(r2), 2, 0)
					vStr47 = ""
					If Not(v_asportoora) Then
						Exit
					End If
					Dim vTmp_ As Long = Sub051(str, NumberFormat(dateDialog.DayOfMonth, 2, 0) & "/" & NumberFormat(dateDialog.Month, 2, 0) & "/" & dateDialog.Year, sb6)
					If vTmp_ <> 0 Then
						dateDialog.DateTicks = vTmp_
						Exit
					End If
				End If
			Loop
			Return NumberFormat(dateDialog.Month, 2, 0) & "/" & NumberFormat(dateDialog.DayOfMonth, 2, 0) & "/" & dateDialog.Year
		End If
		Dim vDate2 As String = DateTime.Date(mod1.Sub058)
		If vStr53 <> "" Then
			vDate2 = vStr53
		End If
		dateDialog.Year = vDate2.SubString2(6, 10)
		dateDialog.Month = vDate2.SubString2(0, 2)
		dateDialog.DayOfMonth = vDate2.SubString2(3, 5)
		vBln64 = True
		dateDialog.Show("Impostare la data per il movimento", "Data movimento", "Ok", "", "", vBmp1)
		vBln64 = False
		Return NumberFormat(dateDialog.Month, 2, 0) & "/" & NumberFormat(dateDialog.DayOfMonth, 2, 0) & "/" & dateDialog.Year
	End If
	Return DateTime.Date(mod1.Sub058)
End Sub

Sub Sub169(str As String) As String
	mod1.vStr2 = "Private Sub GetDes(FullDes As String) As String"
	Try
		Dim replace As String = str.ToUpperCase.Replace(".PNG", "")
		Dim indexOf As Short = replace.IndexOf("_")
		Return IIf(indexOf > 0, replace.SubString(indexOf + 1).Replace("_", " "), replace)
	Catch
		mod1.Sub217(LastException.Message)
		Return str
	End Try
End Sub

Sub Sub170 As String
	Select vStr6
		Case "ca"
			Return "Carico"
		Case "re"
			Return "Rettifica Giac."
		Case "au"
			Return "Autoconsumo"
		Case "rf"
			Return "Reso a Fornitore"
		Case "in"
			Return "Inventario"
		Case "pr"
			Return "Prenotazione"
		Case Else
			Return "Vendita"
	End Select
End Sub

Sub Sub171(str As String) As String
	Select str
		Case "ca"
			Return "Carico"
		Case "re"
			Return "Rettifica Giac."
		Case "au"
			Return "Autoconsumo"
		Case "rf"
