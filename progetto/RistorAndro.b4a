	End If
	If vBln12 Then
		cursorWrapper = vSql1.ExecQuery("Select * from VenTmp inner join reparti on reparti.codice=Ventmp.reparto where TipoSconto=" & sc_sconto & str & " and reparti.scontabile=1 and qtad>0 order by chiave")
	Else
		cursorWrapper = vSql1.ExecQuery("Select * from VenTmp inner join reparti on reparti.codice=Ventmp.reparto where TipoSconto=" & sc_sconto & str & " and  reparti.scontabile=1 order by chiave")
	End If
	If cursorWrapper.RowCount > 0 Then
		Dim d As Double = 0
		If IsNumber(lblDisplay.Text.Replace(",", ".")) Then
			d = Round2(lblDisplay.Text.Replace(",", "."), 4)
		End If
		If d = 0 And lblDisplay.Text = "" Then
			Dim inputDialog2 As InputDialog = vDlg1
			vDlg1.InputType = 2
			vDlg1.Input = ""
			vDlg1.PasswordMode = False
			If i = f_maggiorazione Then
				vDlg1.Hint = "Maggiorazione % sul Totale"
			Else
				vDlg1.Hint = "Sconto % sul Totale"
			End If
			vDlg1.HintColor = Colors.ARGB(196, 255, 140, 0)
			Dim vShow As Int = vDlg1.Show("Inserire " & IIf(i = f_maggiorazione, "la nuova maggiorazione", "il nuovo sconto") & " in % sul Totale", vStr8, "Ok", "Annulla", "", vBmp1)
			If vShow = -1 Then
				If IsNumber(vDlg1.Input) Then
					d = vDlg1.Input
				Else
					If i = f_maggiorazione Then
						Msgbox2("Maggiorazione non valida", vStr8, "OK", "", "", vBmp1)
					Else
						Msgbox2("Sconto non valido", vStr8, "OK", "", "", vBmp1)
					End If
					mod1.Sub081
					Return
				End If
			Else
				mod1.Sub081
				Return
			End If
		End If
		lblDisplay.Text = ""
		If d >= 0 And d <= 100 Then
			If i = f_maggiorazione Then
				d = d * -1
			End If
			Dim rowCount As Int = cursorWrapper.RowCount - 1
			Dim i2 As Int
			For i2 = 0 To rowCount
				cursorWrapper.Position = i2
				If cursorWrapper.GetDouble("prezzov") > 0 Or cursorWrapper.GetString("codice").ToLowerCase.StartsWith("vv") Then
					If vBln12 Then
						Dim vRound2 As Double = Round2(vSql1.ExecQuerySingleResult("Select (prezzov * qtad ) as tt from Ventmp  where chiave =" & cursorWrapper.GetString("chiave")), 2)
						Dim vRound22 As Double = Round2(vRound2 - (1 - d / 100) * vRound2, v_arrotondav)
						vSql1.ExecNonQuery("update Ventmp set scop= " & d & " , scov= " & vRound22 & ", scovd= " & vRound22 & " where qta >0 and flgusointerno =0 and chiave =" & cursorWrapper.GetString("chiave"))
						vSql1.ExecNonQuery("update Ventmp set importo = round(prezzov * qta +0.000000001,2) - scovd,importod = round(prezzov * qtad +0.000000001,2) - scovd where chiave =" & cursorWrapper.GetString("chiave"))
					Else
						Dim vRound23 As Double = Round2(vSql1.ExecQuerySingleResult("Select (prezzov * qta ) as tt from Ventmp  where chiave =" & cursorWrapper.GetString("chiave")), 2)
						vSql1.ExecNonQuery("update Ventmp set scop= " & d & " , scov= " & Round2(vRound23 - (1 - d / 100) * vRound23, v_arrotondav) & " where qta >0  and flgusointerno =0 and chiave =" & cursorWrapper.GetString("chiave"))
						vSql1.ExecNonQuery("update Ventmp set importo = round(prezzov * qta +0.000000001,2) - scov where chiave =" & cursorWrapper.GetString("chiave"))
					End If
				End If
			Next
			If Not(vBln12) Then
				Dim rowCount2 As Int = cursorWrapper.RowCount - 1
				Dim i3 As Int
				For i3 = 0 To rowCount2
					cursorWrapper.Position = i3
					If cursorWrapper.GetDouble("prezzov") > 0 And Not(cursorWrapper.GetString("codice").ToLowerCase.StartsWith("ww")) And Not(cursorWrapper.GetString("codice").ToLowerCase.StartsWith("vv")) Then
						vSql1.ExecNonQuery("update Ventmp set importo2 = (Select Case when sum(importo) Is Null Then 0 Else sum(importo) End from Ventmp where (lower(substr(codice,1,2))='vv' or lower(substr(codice,1,2))='ww') AND totcre ='" & cursorWrapper.GetString("totcre") & "') where chiave =" & cursorWrapper.GetString("chiave"))
					End If
				Next
			End If
			refilltablelist(True)
			vMap10.Initialize
			vDbl5 = Round2(d, vInt34)
			Dim vTmp As String = modfunstr.Sub004(20)
			vccefdll1.mf_display(vTmp, "TOTALE" & modfunstr.Sub003(modfunstr.Sub004(14) & NumberFormat2(vDbl1 + vDbl12, 1, 2, 2, False), 14))
		Else If i = f_maggiorazione Then
			Msgbox2("Maggiorazione non valida", vStr8, "OK", "", "", vBmp1)
		Else
			Msgbox2("Sconto non valido", vStr8, "OK", "", "", vBmp1)
		End If
	Else
		lblDisplay.Text = ""
	End If
	cursorWrapper.Close
End Sub

