					Dim vMsgbox2 As Int = Msgbox2(vCSBuilder1.PopAll, vStr8, "Chiudi", "", str4, vBmp1)
					If vMsgbox2 = -2 Then
						Dim numberDialog As NumberDialog
						numberDialog.Digits = 1
						numberDialog.Number = 1
