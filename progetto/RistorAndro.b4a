		list.Add("Annulla selezione")
		i = InputList(list, "Seleziona un elemento opzionale di ricerca del documento commerciale di vendita", -1)
	Else
		i = 0
	End If
	If i < 0 Then
		Return
	End If
	If i < 2 - i2 Then
		Dim inputDialog2 As InputDialog = vDlg1
		vDlg1.InputType = 1
		vDlg1.Hint = "matricola ..."
		vDlg1.Input = ""
		vDlg1.PasswordMode = False
		vDlg1.HintColor = Colors.ARGB(196, 255, 140, 0)
		Dim vShow As Int = vDlg1.Show("Inserire la matricola della cassa che ha generato il Documento di vendita", vStr8, "Ok", "Annulla", "", vBmp1)
		If vShow = -1 Then
			Dim upperCase As String = vDlg1.Input.ToUpperCase
			If upperCase.Length <> 11 Then
				Msgbox2("La matricola deve essere lunga 11 caratteri", vStr8, "OK", "", "", vBmp1)
				Return
			End If
			If upperCase = vccefdll1.vStr4 Then
				Msgbox2("La matricola deve essere diversa da quella attuale", vStr8, "OK", "", "", vBmp1)
				Return
			End If
			If vccefdll1.vBln13 And i = 0 Then
				Dim inputDialog5 As InputDialog = vDlg1
				vDlg1.InputType = 1
				vDlg1.Hint = "codice lotteria ..."
				vDlg1.Input = ""
				vDlg1.PasswordMode = False
				vDlg1.HintColor = Colors.ARGB(196, 255, 140, 0)
				Dim vShow2 As Int = vDlg1.Show("Inserire il codice lotteria ", vStr8, "Ok", "Annulla", "", vBmp1)
				If vShow2 = -1 Then
					Dim input As String = vDlg1.Input
					If Not(Regex.IsMatch("^[A-Za-z0-9]{8}$", input)) Then
						Msgbox2("Il codice lotteria inserito non è valido.", vStr8, "OK", "", "", vBmp1)
						Return
					End If
					Dim vAppend As CSBuilder = vCSBuilder1.Initialize.Append("Matricola che ha generato il Documento di vendita :")
					Dim vAppend2 As CSBuilder = vAppend.Color(-65536).Size(20).Append(upperCase).Pop.Pop.Append(CRLF).Append("Codice lotteria:")
					btnMatricola.Text = vAppend2.Color(-65536).Size(20).Append(input).PopAll
					btnMatricola.Tag = upperCase & "_" & input
					btnMatricola.Color = -16711936
				End If
			Else
				Dim vAppend3 As CSBuilder = vCSBuilder1.Initialize.Append("Matricola che ha generato il Documento di vendita :")
				btnMatricola.Text = vAppend3.Color(-65536).Size(20).Append(upperCase).PopAll
				btnMatricola.Tag = upperCase
				btnMatricola.Color = -16711936
			End If
		Else
			btnMatricola.Text = obj
			btnMatricola.Tag = ""
			btnMatricola.Color = -3355444
		End If
	Else If i < 5 - i2 Then
		Dim vAppend4 As CSBuilder = vCSBuilder1.Initialize.Append("Elemento di Ricerca :")
		btnMatricola.Text = vAppend4.Color(-65536).Size(20).Append(list.Get(i)).PopAll
		btnMatricola.Tag = list.Get(i)
		btnMatricola.Color = -16711936
		btnResoDocNumber.Tag = ""
		btnResoDocNumber.Text = "Documento Commerciale N.:"
		btnResoDocNumber.Color = -3355444
		btnResoDocNumber.Enabled = False
	Else If i = 5 - i2 Then
		btnMatricola.Text = obj
		btnMatricola.Tag = ""
		btnMatricola.Color = -3355444
	End If
End Sub

Sub btnResoDocDate_Click
	Dim dateDialog As DateDialog
	dateDialog.Year = DateTime.GetYear(mod1.Sub058)
	dateDialog.Month = DateTime.GetMonth(mod1.Sub058)
	dateDialog.DayOfMonth = DateTime.GetDayOfMonth(mod1.Sub058)
	Dim vShow As Int = dateDialog.Show("Impostare la data di emissione del documento commerciale", "Imposta Data", "Ok", "Annulla", "", vBmp1)
	btnResoDocDate.Tag = ""
	btnResoDocDate.Text = "Emesso in data:"
	btnResoDocDate.Color = -3355444
	If vShow = -1 Then
		Dim dateTicks As Long = dateDialog.DateTicks
		If dateTicks > mod1.Sub058 Then
			Msgbox2("La data inserita non è valida", vStr8, "OK", "", "", vBmp1)
			Return
		End If
		Dim str As String = NumberFormat2(dateDialog.DayOfMonth, 2, 0, 0, False) & "/" & NumberFormat2(dateDialog.Month, 2, 0, 0, False) & "/" & NumberFormat2(dateDialog.Year, 2, 0, 0, False)
		btnResoDocDate.Tag = str
		Dim vAppend As CSBuilder = vCSBuilder1.Initialize.Append("Emesso in data:" & CRLF)
		btnResoDocDate.Text = vAppend.Color(-65536).Size(20).Append(str).PopAll
		btnResoDocDate.Color = -16711936
	End If
End Sub

Sub btnResoDocNumber_Click
	Dim inputDialog2 As InputDialog = vDlg1
