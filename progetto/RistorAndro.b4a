Sub Sub118(str As String, map As Map)
	Try
		Dim parseDouble As Long = vSql1.ExecQuerySingleResult("select rifheadmov from tavoli where  tavolo = " & vInt78)
		If parseDouble > 0 Then
			Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select qtacondecimali,totcre,chiave,descrizione,qta,prezzov,scov from venduto where nmov = " & parseDouble & str)
			If cursorWrapper.RowCount > 0 Then
				Dim rowCount As Int = cursorWrapper.RowCount - 1
				Dim i As Int
				For i = 0 To rowCount
					cursorWrapper.Position = i
					Try
						Dim vObjectToNumber As Int = IIf(map.ContainsKey(cursorWrapper.GetString("totcre")), map.Get(cursorWrapper.GetString("totcre")), cursorWrapper.GetInt("qta"))
						If v_regcancellazioni Then
							mod1.Sub146("Select codint,round((prezzov *" & vObjectToNumber & ") -scov,2) as importo," & vObjectToNumber & " as qta,brep from venduto where  chiave =" & cursorWrapper.GetString("chiave"), parseDouble, Operatore, vInt78)
						End If
						If vObjectToNumber < cursorWrapper.GetInt("qta") Then
							vSql1.ExecNonQuery("update venduto set importo=(prezzov*" & cursorWrapper.GetInt("qta") - vObjectToNumber & ")-scov,qta=" & cursorWrapper.GetInt("qta") - vObjectToNumber & " where chiave=" & cursorWrapper.GetLong("chiave"))
						Else
							vSql1.ExecNonQuery("delete from venduto where chiave=" & cursorWrapper.GetLong("chiave"))
						End If
					Catch
						mod1.Sub217(LastException.Message)
					End Try
				Next
			End If
			cursorWrapper.Close
			Dim vExecQuerySingleResult As String = vSql1.ExecQuerySingleResult("select sum(importo) from venduto where nmov = " & parseDouble)
