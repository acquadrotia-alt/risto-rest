Sub Sub261(str As String)
	Dim str2 As String
	Dim equals As Boolean
	Dim i As Int
	Dim str3 As String
	Dim z As Boolean
	Dim d As Double
	Dim map As Map = Null
	Dim text As String = lblDisplay.Text
	Try
		If Not(vBln12) Then
			str2 = "importo"
		Else
			str2 = "importod"
		End If
		equals = (str = "pre")
	Catch
		mod1.Sub217(LastException.Message)
	End Try
	If vSql1.ExecQuerySingleResult("Select count(*) from Ventmp where " & str2 & ">0 and flgNF=0 and substr(memo,1,6)<>'Doc.N.'") = 0 Then
		Return
	End If
	If vSql1.ExecQuerySingleResult("Select count(*) from Ventmp where codint ='" & SmartStringFormatter("", str) & "' and " & SmartStringFormatter("", str2) & "<0 and flgNF=0 and substr(memo,1,6)<>'Doc.N.'") > 0 Then
		If Not(equals) Then
			i = 0
		Else
			i = vSql1.ExecQuerySingleResult("Select sum(punti) from Ventmp where codint ='" & SmartStringFormatter("", str) & "' and " & SmartStringFormatter("", str2) & "<0 and flgNF=0 and substr(memo,1,6)<>'Doc.N.'")
		End If
		Dim parseDouble As Double = vSql1.ExecQuerySingleResult("Select sum(" & SmartStringFormatter("", str2) & ") from Ventmp where codint ='" & SmartStringFormatter("", str) & "' and " & SmartStringFormatter("", str2) & "<0 and flgNF=0 and substr(memo,1,6)<>'Doc.N.'")
		Dim parseDouble2 As Double = vSql1.ExecQuerySingleResult("Select sum(" & str2 & ") from Ventmp where " & str2 & ">0 and flgNF=0 and substr(memo,1,6)<>'Doc.N.'")
		Dim vAbs As Double = Abs(parseDouble)
		Dim cursorWrapper As Cursor = vSql1.ExecQuery("SELECT sum(" & str2 & ") as TotIva,iva" & TAB & "FROM [Ventmp] where  " & str2 & ">0 and flgNF=0 and substr(memo,1,6)<>'Doc.N.'  group by iva ")
		Dim list As List
		list.Initialize
		Dim rowCount As Int = cursorWrapper.RowCount - 1
		Dim i2 As Int
		For i2 = 0 To rowCount
			cursorWrapper.Position = i2
			If cursorWrapper.GetDouble("TotIva") > 0 Then
				'map = Map
				map.Initialize
				map.Put(cursorWrapper.GetInt("iva"), cursorWrapper.GetDouble("TotIva") * 100 / parseDouble2)
				list.Add(map)
			End If
		Next
		cursorWrapper.Close
		If list.Size = 0 Then
			Return
		End If
		Dim vExecQuerySingleResult As String = vSql1.ExecQuerySingleResult("Select max(chiave) from Ventmp")
		Dim z2 As Boolean = True
		Dim size As Int = list.Size - 1
		Dim map2 As Map = map
		Dim i3 As Int = 0
		Do While i3 <= size
			map2 = list.Get(i3)
			Dim vAbs2 As Double = Abs(Round2(map2.GetValueAt(0) * parseDouble / 100, 2))
			If vAbs2 = 0 Then
				z = z2
				d = vAbs
			Else
				Dim vRound2 As Double = Round2(vAbs - vAbs2, 2)
				lblDisplay.Text = vAbs2
				addRowPlu(str, False, False, "", False, "")
				If equals And z2 Then
					str3 = " punti = " & i & ",prezzov=" & vAbs2 & ",qta=-1,importo=" & Round2(1 * vAbs2, 2) & ","
					z = False
				Else If Not(equals) Then
					str3 = ""
					z = z2
				Else
					str3 = " punti = 0,prezzov=" & vAbs2 & ",qta=-1,importo=" & Round2(1 * vAbs2, 2) & ","
					z = z2
				End If
				vSql1.ExecNonQuery("update Ventmp set " & SmartStringFormatter("", str3) & " iva=" & SmartStringFormatter("", map2.GetKeyAt(0)) & " where chiave =(select max(chiave) from Ventmp)")
				lblDisplay.Text = text
				d = vRound2
			End If
			z2 = z
			i3 = i3 + 1
			vAbs = d
		Loop
		If vAbs > 0 Then
			lblDisplay.Text = vAbs
			addRowPlu(str, False, False, "", False, "")
			Dim str4 As String = ""
			If equals Then
				str4 = " punti = 0,prezzov=" & vAbs & ",qta=-1,importo=" & Round2(1 * vAbs, 2) & ","
			End If
			vSql1.ExecNonQuery("update Ventmp set " & SmartStringFormatter("", str4) & " iva=" & SmartStringFormatter("", map2.GetKeyAt(0)) & " where chiave =(select max(chiave) from Ventmp)")
			lblDisplay.Text = text
		End If
		vSql1.ExecNonQuery("delete from Ventmp where codint ='" & str & "' and chiave <= " & vExecQuerySingleResult)
		refilltablelist(True)
	End If
	If lblDisplay.Text <> text Then
		lblDisplay.Text = text
	End If
End Sub

Sub Sub262(str As String, map As Map)
	Dim vTmp As Int
	Dim i As Int
	Dim str2 As String
	Dim i2 As Int
	Try
		vTmp = Sub050("Inserire il numero del tavolo sul quale spostare gli articoli (da 1 a 500)", True)
	Catch
		mod1.Sub217(LastException.Message)
	End Try
	If vTmp = 0 Then
		vBln108 = False
		mod1.Sub081
		Return
	End If
	If vSql1.ExecQuerySingleResult("Select count(*) from tavoli where tavolo = " & vTmp & " and inmodifica =0 and lock=0 ") = 0 Or vSql1.ExecQuerySingleResult("select count(*) from pagine where pagina >=10 and pagina <100 and tipo = " & t_tavolo & " and  valore = " & vTmp) = 0 Or vSql1.ExecQuerySingleResult("Select count(*) from tavoli where tavolo = " & vTmp & " and rifheadmov >0 ") = 0 Then
		If vSql1.ExecQuerySingleResult("Select count(*) from tavoli where tavolo = " & vTmp & " and rifheadmov >0 ") = 0 Then
			Msgbox2("Il tavolo di destinazione non può essere vuoto", vStr8, "OK", "", "", vBmp1)
		Else
			Msgbox2("tavolo non disponibile", vStr8, "OK", "", "", vBmp1)
		End If
		vBln108 = False
		mod1.Sub081
		Return
	End If
	If vTmp = vInt78 Then
		Msgbox2("Il tavolo di origine corrisponde a quello di destinazione", vStr8, "OK", "", "", vBmp1)
		vBln108 = False
		mod1.Sub081
		Return
	End If
	Dim parseDouble As Long = vSql1.ExecQuerySingleResult("select rifheadmov from tavoli where  tavolo = " & vInt78)
	Dim parseDouble2 As Long = vSql1.ExecQuerySingleResult("select rifheadmov from tavoli where tavolo = " & vTmp)
	Dim str3 As String = ""
	If parseDouble > 0 And parseDouble2 > 0 Then
		Dim list As List
		list.Initialize
		Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select codice,qtacondecimali,totcre,chiave,descrizione,qta,prezzov,scov from venduto where nmov = " & parseDouble & str & " order by QtaConDecimali,totcre,codice asc")
		If cursorWrapper.RowCount > 0 Then
			Dim j As Long = vInt78 * 10000
			Dim rowCount As Int = cursorWrapper.RowCount - 1
			Dim i3 As Int = 0
			Dim i4 As Int = 0
			Dim str4 As String = ""
			Do While i3 <= rowCount
				cursorWrapper.Position = i3
				Try
					Dim z As Boolean = Not(cursorWrapper.GetString("codice").StartsWith("vv")) And Not(cursorWrapper.GetString("codice").StartsWith("ww"))
					Dim vGetInt As Int = cursorWrapper.GetInt("totcre")
					Dim str5 As String = str4 & cursorWrapper.GetString("descrizione") & CRLF
					If Not(z) Then
						i2 = i4
					Else
						Dim i5 As Int = vGetInt + j
						Dim z2 As Boolean = False
						If vSql1.ExecQuerySingleResult("select count(*) from venduto where nmov =" & SmartStringFormatter("", parseDouble2) & " ") > 0 Then
							Do While Not(z2)
								If vSql1.ExecQuerySingleResult("select count(*) from venduto where nmov =" & SmartStringFormatter("", parseDouble2) & " and totcre='" & SmartStringFormatter("", i5) & "' ") > 0 Then
									i5 = i5 + 1
								Else
									z2 = True
								End If
							Loop
						End If
						i2 = i5
						i4 = i5
					End If
					Dim vObjectToNumber As Int = IIf(map.ContainsKey(cursorWrapper.GetString("totcre")), map.Get(cursorWrapper.GetString("totcre")), cursorWrapper.GetInt("qta"))
					If vObjectToNumber < cursorWrapper.GetInt("qta") Then
						Dim vTmp_ As Map = dbutil.Sub006(vSql1, "Select * from Venduto  where chiave=" & cursorWrapper.GetLong("chiave"), Null)
						If Not(vTmp_ = Null) Then
							vTmp_.Put("qta", vObjectToNumber)
							vTmp_.Put("importo", cursorWrapper.GetDouble("prezzov") * vObjectToNumber - cursorWrapper.GetDouble("scov"))
							vTmp_.Put("nmov", parseDouble2)
							vTmp_.Put("qtacondecimali", i2)
							vTmp_.Put("totcre", i2)
							vTmp_.Put("idriga", mod1.Sub006)
							vTmp_.Remove("chiave")
							mod1.Sub178(100)
						End If
						list.Add(vTmp_)
						vSql1.ExecNonQuery("update venduto set importo=(prezzov*" & cursorWrapper.GetInt("qta") - vObjectToNumber & ")-scov,qta=" & cursorWrapper.GetInt("qta") - vObjectToNumber & " where chiave=" & cursorWrapper.GetLong("chiave"))
					Else
						vSql1.ExecNonQuery("update venduto set nmov= " & parseDouble2 & " , qtacondecimali= " & i2 & ",totcre='" & i2 & "' where chiave=" & cursorWrapper.GetLong("chiave"))
					End If
					i = i4
					str2 = str5
				Catch
					i = i4
					str2 = str4
					mod1.Sub217(LastException.Message)
				End Try
				i3 = i3 + 1
				str4 = str2
				i4 = i
			Loop
			str3 = str4
		End If
		cursorWrapper.Close
		If list.Size > 0 Then
			dbutil.Sub007(vSql1, "venduto", list)
		End If
		Dim vExecQuerySingleResult As String = vSql1.ExecQuerySingleResult("select sum(importo) from venduto where nmov = " & parseDouble)
		Dim vExecQuerySingleResult2 As String = vSql1.ExecQuerySingleResult("select sum(importo) from venduto where nmov = " & parseDouble2)
		Dim parseDouble3 As Int = vSql1.ExecQuerySingleResult("select case when sum(qta) is null then 0 else sum(qta) end from venduto where (codint ='888888' or codint ='888889') and nmov = " & parseDouble)
