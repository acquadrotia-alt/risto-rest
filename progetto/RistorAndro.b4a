			End If
		Next
		If str = "" Then
			Return
		End If
		Dim str2 As String = " and (" & str.SubString2(0, str.Length - 3) & ")"
		Dim dirDefaultExternal As String = File.DirDefaultExternal
		File.Copy(dirDefaultExternal, "InvioFE.db", File.DirDefaultExternal, "TmpInvioFE.db")
		Dim sql As SQL
		Try
			sql.Initialize(File.DirDefaultExternal, "TmpInvioFE.db", False)
			Dim vTmp As Long = mod1.Sub058
			Dim periodVar As Period
			If vInputList = 0 Then
				periodVar.Months = -1
			Else If vInputList = 1 Then
				periodVar.Months = -3
			Else
				periodVar.Years = -1
			End If
			Dim addperiod As Long = DateUtils.addperiod(vTmp, periodVar)
			Dim sb As String = " where DataOra > '" & NumberFormat2(DateTime.GetYear(addperiod), 4, 0, 0, False) & "-" & NumberFormat(DateTime.GetMonth(addperiod), 2, 0) & "-" & NumberFormat(DateTime.GetDayOfMonth(addperiod), 2, 0) & " 00:00:00' " & str2
			Dim cursorWrapper As Cursor = sql.ExecQuery("Select * from EsitiFE " & sb & " order by DataOra desc")
			If cursorWrapper.RowCount > 0 Then
				Dim list2 As List
				list2.Initialize
				Dim rowCount As Int = cursorWrapper.RowCount - 1
				Dim i3 As Int
				For i3 = 0 To rowCount
					cursorWrapper.Position = i3
					Dim vSize As CSBuilder = vCSBuilder1.Initialize.Size(18)
					vSize.Typeface(Typeface.MONOSPACE)
					Dim vSplit() As String = Regex.Split("_", cursorWrapper.GetString("NomeFile"))
					If vSplit.Length > 3 Then
						Sub167(vSplit, cursorWrapper, False)
						list2.Add(vCSBuilder1.PopAll)
					End If
				Next
				Dim vSize2 As CSBuilder = vCSBuilder1.Initialize.Size(22).Append("Elementi selezionati:").Append(CRLF).Size(18)
				vSize2.Typeface(Typeface.MONOSPACE).Append("     Fattura        del         Totale  ")
				Dim vInputList2 As Int = InputList(list2, vCSBuilder1.PopAll, -1)
				If vInputList2 >= 0 Then
					cursorWrapper.Position = vInputList2
					Dim vSize3 As CSBuilder = vCSBuilder1.Initialize.Size(18)
					vSize3.Typeface(Typeface.MONOSPACE)
					Dim vSplit2() As String = Regex.Split("_", cursorWrapper.GetString("NomeFile"))
					If vSplit2.Length > 3 Then
						Sub167(vSplit2, cursorWrapper, True)
					End If
					vCSBuilder1.Append(CRLF & CRLF)
					vCSBuilder1.Pop.Size(14).Append("Esito Esteso:" & CRLF & cursorWrapper.GetString("TestoEsito") & CRLF & CRLF)
					vCSBuilder1.Append("Nome File:" & CRLF & cursorWrapper.GetString("NomeFile") & CRLF & CRLF)
					If cursorWrapper.GetString("DatiExtra") <> "" Then
						vCSBuilder1.Append("Info:" & CRLF & cursorWrapper.GetString("DatiExtra") & CRLF & CRLF)
					End If
					vCSBuilder1.Append("Ultimo Invio Intermediario:" & CRLF & cursorWrapper.GetString("DataOraEsito") & CRLF & CRLF)
					Dim replace As String = cursorWrapper.GetString("NomeFile").Replace(" ", "_")
