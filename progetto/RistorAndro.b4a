		btnResoImporto.Tag = ""
		btnResoImporto.Text = "Inserire il numero del movimento per annullare il Documento commerciale di vendita"
		btnResoImporto.Color = -3355444
		Dim vShow As Int = vDlg1.Show("Inserire il numero del movimento " & CRLF & "Se disponibile , riportare il valore che segue 'M.' nel documento commerciale di vendita", vStr8, "Ok", "Annulla", "", vBmp1)
		If vShow = -1 Then
			If Not(IsNumber(vDlg1.Input)) Then
				Msgbox2("Numero movimento non valido", vStr8, "OK", "", "", vBmp1)
			Else If vSql1.ExecQuerySingleResult("Select count(*) from headmov where nmov=" & SmartStringFormatter("", vDlg1.Input) & " ") > 0 Then
				btnResoImporto.Tag = "A" & vDlg1.Input
				Dim vAppend As CSBuilder = vCSBuilder1.Initialize.Append("Annulla il Documento commerciale di vendita del movimento numero " & CRLF)
				btnResoImporto.Text = vAppend.Color(-65536).Size(20).Append(vDlg1.Input).PopAll
				btnResoImporto.Color = -16711936
			Else If vSql2.ExecQuerySingleResult("Select count(*) from headmov where nmov=" & SmartStringFormatter("", vDlg1.Input) & " ") > 0 Then
				btnResoImporto.Tag = "V" & vDlg1.Input
				Dim vAppend2 As CSBuilder = vCSBuilder1.Initialize.Append("Annulla il Documento commerciale di vendita del movimento numero " & CRLF)
				btnResoImporto.Text = vAppend2.Color(-65536).Size(20).Append(vDlg1.Input).PopAll
				btnResoImporto.Color = -16711936
			Else
				Msgbox2("Il movimento numero " & SmartStringFormatter("", vDlg1.Input) & " non è stato trovato", vStr8, "OK", "", "", vBmp1)
			End If
		End If
		Return
	End If
	Dim inputDialog5 As InputDialog = vDlg1
	vDlg1.InputType = 12290
	vDlg1.Hint = "Premi Ok per confermare il reso a " & NumberFormat2(btnResoImporto.Tag, 1, 2, 2, False) & " €"
	vDlg1.Input = ""
	vDlg1.PasswordMode = False
	vDlg1.HintColor = Colors.ARGB(196, 255, 140, 0)
	Dim vShow2 As Int = vDlg1.Show("Inserire il prezzo unitario (verificare il prezzo dallo scontrino fiscale del cliente)", vStr8, "Ok", "Annulla", "", vBmp1)
	If vShow2 = -1 Then
		Dim input As String = vDlg1.Input
		If input <> "" And IsNumber(input) Then
			If mod1.Sub056(input) > 0 Then
				btnResoImporto.Tag = mod1.Sub056(input)
				btnResoImporto.Text = "Rendere l'articolo a " & NumberFormat2(btnResoImporto.Tag, 1, 2, 2, False) & " €"
			End If
		End If
	End If
End Sub

Sub Btool_Click
	If vclsslidingsidebar1.Sub010 Then
		Return
	End If
	vInt55 = 0
	mod1.vStr2 = "Sub bTool_Click"
	Dim buttonWrapper As Button = Sender
	If buttonWrapper.Tag = "Aggiorna" And vBln134 Then
		Return
	End If
	If buttonWrapper.Tag = "Aggiorna" Then
		Dim vMsgbox2 As Int = Msgbox2("Confermi l'aggiornamento dei tavoli ? ", vStr8, "Si", "", "No", vBmp1)
		If vMsgbox2 = -1 Then
			Sub220(False)
		End If
		Return
	End If
	Dim vSplit() As String = Regex.Split(",", buttonWrapper.Tag)
	Dim parseDouble As Int = vSplit(0)
	Dim parseDouble2 As Int = vSplit(1)
	Dim parseDouble3 As Int = vSplit(2)
	If vBln134 Then
		If parseDouble3 = vInt13 - 1 Then
			If vBtn2.Text.StartsWith("Modifica") Then
				vBtn2.Text = "Sposta tavoli su LongClick"
				ToastMessageShow("Sposta tavoli su LongClick ATTIVATO", True)
			Else
				vBtn2.Text = "Modifica numero tavolo su LongClick"
				ToastMessageShow("Modifica numero tavolo su LongClick ATTIVATO", True)
			End If
			Return
		End If
		Dim list As List
		list.Initialize
		list.AddAll(ArrayToList(Array As String("Vuoto", "Sala", "Funzione")))
		Dim vInputList1 As Int = idLib.InputList1(list, "Selezionare il Tipo Tasto")
		If vInputList1 = 0 Then
			vSql1.ExecNonQuery("update Toolbar set tipo =0,valore=0 where codice = " & parseDouble3)
			buttonWrapper.Tag = "0,0," & parseDouble3
			Sub007(buttonWrapper)
		Else If vInputList1 = 1 Then
			Dim vInputList12 As Int = idLib.InputList1(vLst7, "Selezionare la Sala")
			If vInputList12 >= 0 Then
				vSql1.ExecNonQuery("update Toolbar set tipo =" & t_pagina & ",valore =" & vInputList12 + 10 & " where  codice = " & parseDouble3)
				buttonWrapper.Tag = t_pagina & "," & vInputList12 + 10 & "," & parseDouble3
				Sub007(buttonWrapper)
			End If
		Else If vInputList1 = 2 Then
			Dim list2 As List
			list2.Initialize
			list2.AddAll(ArrayToList(Array As String("Info Tavoli", "Apri Cassetto", "Operatore", "Ricerca Tavoli")))
			If v_gestionespiagge Then
				list2.Add("Planner spiaggia")
			End If
			Dim vInputList13 As Int = idLib.InputList1(list2, "Selezionare la Funzione")
			If vInputList13 >= 0 Then
				If vInputList13 = 0 Then
					vSql1.ExecNonQuery("update Toolbar set tipo =" & t_funzione & ",valore =" & f_infotavolo & " where  codice = " & parseDouble3)
					buttonWrapper.Tag = t_funzione & "," & f_infotavolo & "," & parseDouble3
				Else If vInputList13 = 1 Then
					vSql1.ExecNonQuery("update Toolbar set tipo =" & t_funzione & ",valore =" & f_apricassetto & " where  codice = " & parseDouble3)
					buttonWrapper.Tag = t_funzione & "," & f_apricassetto & "," & parseDouble3
				Else If vInputList13 = 2 Then
					vSql1.ExecNonQuery("update Toolbar set tipo =" & t_funzione & ",valore =" & f_operatore & " where  codice = " & parseDouble3)
					buttonWrapper.Tag = t_funzione & "," & f_operatore & "," & parseDouble3
				Else If vInputList13 = 3 Then
					vSql1.ExecNonQuery("update Toolbar set tipo =" & t_funzione & ",valore =" & f_ricercatavoli & " where  codice = " & parseDouble3)
					buttonWrapper.Tag = t_funzione & "," & f_ricercatavoli & "," & parseDouble3
				Else If vInputList13 = 4 Then
					vSql1.ExecNonQuery("update Toolbar set tipo =" & t_funzione & ",valore =" & f_plannerspiaggia & " where  codice = " & parseDouble3)
					buttonWrapper.Tag = t_funzione & "," & f_plannerspiaggia & "," & parseDouble3
				Else
					Return
				End If
				Sub007(buttonWrapper)
			End If
		End If
	Else If vInt13 - 1 = parseDouble3 Then
		cambiapagina(IIf(vCur3.GetInt("pagdefault") <= 0 Or vCur3.GetInt("pagdefault") >= 10, 1, vCur3.GetInt("pagdefault")))
	Else If parseDouble = t_funzione Then
		Select parseDouble2
			Case f_infotavolo
				Dim list3 As List
				list3.Initialize
				list3.AddAll(ArrayToList(Array As String("Visualizza report di tutti i tavoli", "Visualizza i Coperti", "Visualizza il Totale", "Visualizza il Totale e i Coperti", "Nascondi Info")))
				Dim vInputList14 As Int = idLib.InputList1(list3, "Selezionare il tipo di richiesta")
				If vInputList14 = 0 Then
					vBln136 = True
					stampecustom.vStr1 = "StampaTavoli"
					stampecustom.vStr2 = "Stato Tavoli"
					stampecustom.vInt1 = 4
					stampecustom.vStr4 = ""
					stampecustom.vStr5 = ""
					stampecustom.vSql1 = vSql1
					stampecustom.vStr3 = "Main"
					mod1.Sub198("StampeCustom")
					Return
				End If
				If vInputList14 = 1 Or vInputList14 = 2 Or vInputList14 = 3 Or vInputList14 = 4 Then
					vInt36 = vInputList14
					cambiapagina(vInt30)
				End If
			Case f_apricassetto
				eseguifunzione(f_apricassetto)
			Case f_operatore
				eseguifunzione(f_operatore)
			Case f_ricercatavoli
				eseguifunzione(f_ricercatavoli)
			Case f_plannerspiaggia
				eseguifunzione(f_plannerspiaggia)
		End Select
	Else If parseDouble = t_pagina Then
		cambiapagina(parseDouble2)
	End If
End Sub

