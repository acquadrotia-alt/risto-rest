		lblDisplay.Text = ""
		Return
	End If
	If Sub056() Then
		Return
	End If
	Dim getpanel As Panel = vcustomlistviewold3.getpanel(vTmp)
	Dim labelWrapper As Label = getpanel.GetView(1)
	Dim labelWrapper2 As Label = getpanel.GetView(0)
	vCur16.Position = getpanel.GetView(2).Text
	If v_turni Then
		If mod1.Sub145(vCur16.GetString("totcre")) Then
			Return
		End If
	End If
	If vCur16.GetString("codice").StartsWith("ww") Or (vCur16.GetString("codice").ToLowerCase.StartsWith("vv") And vCur16.GetInt("qta") <= 1) Then
		Return
	End If
	If vCur16.GetDouble("Oldqta") > 0 And vCur16.GetDouble("qta") - vCur16.GetDouble("Oldqta") <= 0 And Not(Sub072(vCur3.GetString("funzioni"), 35, False)) Then
		lblDisplay.Text = ""
		Return
	End If
	If vCur16.GetInt("qta") <= 1 Then
		If Sub087() Then
			Return
		End If
		Dim vMsgbox2 As Int = Msgbox2("Confermi la cancellazione dell'articolo ? ", vStr8, "Si", "", "No", vBmp1)
		If vMsgbox2 <> -1 Then
			Return
		End If
		If vBln141 And (vCur16.GetString("codint") = "888888" Or vCur16.GetString("codint") = "888889") And Not(Sub202("del")) Then
			Return
		End If
	Else
		If vBln141 And (vCur16.GetString("codint") = "888888" Or vCur16.GetString("codint") = "888889") And Not(Sub202("less")) Then
			Return
		End If
		If vCur16.GetDouble("qta") Mod 1 <> 0 And vCur16.GetString("descrizione").EndsWith(">") Then
			Return
		End If
	End If
	If v_regcancellazioni And vLng11 > 0 And vCur16.GetDouble("Oldqta") > 0 And vCur16.GetDouble("Oldqta") > vCur16.GetDouble("qta") - 1 Then
		mod1.Sub146("Select codint,round(importo /qta,2) as importo,1 as qta,brep from Ventmp where  chiave =" & vCur16.GetString("chiave"), vLng11, Operatore, vInt25)
	End If
	Dim vGetString As String = vCur16.GetString("chiave")
	If vCur16.GetDouble("scop") > 0 Then
		Dim vRound2 As Double = Round2(vSql1.ExecQuerySingleResult("Select (prezzov * (qta-1)) as tt from Ventmp  where chiave =" & vCur16.GetString("chiave")), 2)
		vSql1.ExecNonQuery("update Ventmp set scov= " & Round2(vRound2 - (1 - vCur16.GetDouble("scop") / 100) * vRound2, v_arrotondav) & " where qta >0 and  flgusointerno =0 and  chiave =" & vCur16.GetString("chiave"))
	End If
	vSql1.ExecNonQuery("update Ventmp set qta = qta-1,importo = round(prezzov *(qta-1)+0.000000001,2) - scov where  chiave =" & vGetString)
	If vSql1.ExecQuerySingleResult("select qta from Ventmp where  chiave =" & vGetString) > 0 Then
		Sub004(labelWrapper, vGetString, labelWrapper2)
		Dim z As Boolean = False
		If Not(vCur16.GetString("codice").ToLowerCase.StartsWith("vv")) Then
			z = vfunzioni1.Sub011("rileggi", vGetString, vCur16.GetString("totcre"))
		Else If vCur16.GetDouble("prezzov") > 0 Then
			vSql1.ExecNonQuery("update Ventmp set importo2 = (Select Case when sum(importo) Is Null Then 0 Else sum(importo) End from Ventmp where (lower(substr(codice,1,2))='vv' or lower(substr(codice,1,2))='ww') AND totcre ='" & vCur16.GetString("totcre") & "') where chiave =" & vSql1.ExecQuerySingleResult("select chiave from Ventmp where totcre= '" & vCur16.GetString("totcre") & "' and lower(substr(Ventmp.codice,1,2))<>'ww' and lower(substr(Ventmp.codice,1,2))<>'vv'"))
			z = True
		End If
		If Not(z) And vCur16.GetDouble("importo2") <> 0 Then
			vSql1.ExecNonQuery("update Ventmp set importo2 = 0 where  chiave =" & vGetString)
		End If
		vBln74 = True
		refilltablelist(z)
		vBln74 = False
		Sub005(vGetString)
		Sub278(labelWrapper)
	Else
		If vCur16.GetString("codice").ToLowerCase.StartsWith("ww") Then
			vSql1.ExecNonQuery("delete from Ventmp where  chiave =" & vCur16.GetString("chiave"))
		Else
			vSql1.ExecNonQuery("delete from Ventmp where  totcre ='" & vCur16.GetString("totcre") & "'")
		End If
		refilltablelist(True)
		Dim vTmp_ As String = modfunstr.Sub004(20)
		vccefdll1.mf_display(vTmp_, "TOTALE" & modfunstr.Sub003(modfunstr.Sub004(14) & NumberFormat2(vDbl1 + vDbl12, 1, 2, 2, False), 14))
	End If
End Sub

