								Dim vGetString As String = vCur9.GetString("descrizione")
								Dim substring2 As String = vGetString.SubString2(0, vGetString.Trim.IndexOf("[["))
								vLst31.Set(i3, " " & substring.Replace("]]", "]"))
								vLst32.Set(i3, substring2)
