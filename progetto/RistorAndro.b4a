Sub Sub212(i As Int)
	Dim i2 As Int = 0
	mod1.vStr2 = "Refill166"
	Try
		vcustomlistviewold4.Sub004
		Dim rowCount As Int = vCur9.RowCount - 1
		Dim i3 As Int
		For i3 = 0 To rowCount
			vCur9.Position = i3
