'### RISTRUTTURARE: Resumable Sub convertita come macchina a stati (comportamento identico all'originale).
Sub msgboxactcm(tipo As Int, txt As String)
	Dim testo() As String
	Dim result As Int
	Dim mres As String
	Dim rsState As Int = 0
	Do While True
		Select rsState
			Case -1
				Return
			Case 0
				rsState = 1
				Continue
			Case 1
				rsState = 38
				If tipo = 0 Then
					rsState = 3
					Continue
				Else If tipo = 1 Then
					rsState = 23
					Continue
				Else If tipo <> 2 Then
					Continue
				Else
					rsState = 31
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 3
			Case 3
				rsState = 4
				Dim testo(0) As String
				testo = Regex.Split("@_@_@SEPARATOREURL@_@_@", txt)
				Dim vObjectToCharSequence As Object = testo(0)
				Dim vObjectToCharSequence2 As Object = vStr8
				Msgbox2Async(vObjectToCharSequence, vObjectToCharSequence2, "Reset Cash Management", "OK", "Visualizza Errore", vBmp1, True)
				Wait For (Null) Msgbox_Result (wf39_0 As Int)
				rsState = 39
				Continue
			Case 4
				rsState = 21
				If result <> -2 And result <> -1 And txt.Contains("Cash Management Errore" & CRLF) Then
					rsState = 6
					Continue
				Else
					rsState = 8
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 6
			Case 6
				rsState = 21
				vBln48 = False
				Continue
			Case 8
				rsState = 9
				Continue
			Case 9
				rsState = 20
				If result = -1 Then
					rsState = 11
					Continue
				Else
					rsState = 13
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 11
			Case 11
				rsState = 20
				msgboxactcm(2, "Procedere con il Reset del Cash Management?")
				Continue
			Case 13
				rsState = 14
				Continue
			Case 14
				rsState = 19
				If testo.Length >= 2 Then
					rsState = 16
					Continue
				Else
					rsState = 18
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 16
			Case 16
				rsState = 19
				gloryimg_show(testo(1))
				Continue
			Case 18
				rsState = 19
				vBln48 = False
				Continue
			Case 19
				rsState = 20
				Continue
			Case 20
				rsState = 21
				Continue
			Case 21
				rsState = 38
				Continue
			Case 23
				rsState = 24
				Dim vObjectToCharSequence3 As Object = txt
				Dim vObjectToCharSequence4 As Object = vStr8
				Msgbox2Async(vObjectToCharSequence3, vObjectToCharSequence4, "Reset Cash Management", "OK", "", vBmp1, True)
				Wait For (Null) Msgbox_Result (wf40_0 As Int)
				rsState = 40
				Continue
			Case 24
				rsState = 29
				If result <> -1 And txt.Contains("Cash Management Errore" & CRLF) Then
					rsState = 26
					Continue
				Else
					rsState = 28
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 26
			Case 26
				rsState = 29
				vBln48 = False
				Continue
			Case 28
				rsState = 29
				msgboxactcm(2, "Procedere con il Reset del Cash Management?")
				Continue
			Case 29
				rsState = 38
				Continue
			Case 31
				rsState = 32
				mres = ""
				Dim vObjectToCharSequence5 As Object = txt
				Dim vObjectToCharSequence6 As Object = vStr8
				Msgbox2Async(vObjectToCharSequence5, vObjectToCharSequence6, "Reset Cash Management", "Annulla", "", vBmp1, True)
				Wait For (Null) Msgbox_Result (wf41_0 As Int)
				rsState = 41
				Continue
			Case 32
				rsState = 37
				If result <> -1 Then
					rsState = 34
					Continue
				Else
					rsState = 36
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 34
			Case 34
				rsState = 37
				vBln48 = False
				Continue
			Case 36
				rsState = 37
				mres = CallSub(httpclient, "ResetGlory")
				vBln48 = False
				ToastMessageShow(mres, True)
				Continue
			Case 37
				rsState = 38
				Continue
			Case 38
				rsState = -1
				Continue
			Case 39
				rsState = 4
				result = wf39_0
				Continue
			Case 40
				rsState = 24
				result = wf40_0
				Continue
			Case 41
				rsState = 32
				result = wf41_0
				Continue
		End Select
	Loop
End Sub

