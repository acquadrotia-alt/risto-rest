			If trim = t_plu Then
				vSql1.ExecNonQuery("update anagra set indice=" & SmartStringFormatter("", vInt67) & " where codint= '" & SmartStringFormatter("", trim2) & "' ")
				Dim vExecQuerySingleResult As String = vSql1.ExecQuerySingleResult("Select descrizione from anagra where codint= '" & SmartStringFormatter("", trim2) & "'")
				vInt67 = vInt67 + 1
				vLbl5.Text = "indice attivo : " & vInt67
				ToastMessageShow("" & SmartStringFormatter("", vExecQuerySingleResult) & " spostato correttamente ", False)
