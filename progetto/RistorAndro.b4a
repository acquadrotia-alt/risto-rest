				sparametri = mod1.Sub139(edtLotteryDAZ.Text, 4, "0") & mod1.Sub139(edtLotteryAZ.Text, 4, "0") & mod1.Sub139(edtLotteryDADCV.Text, 4, "0") & mod1.Sub139(edtLotteryADCV.Text, 4, "0")
