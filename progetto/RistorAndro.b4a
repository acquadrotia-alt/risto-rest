End Sub

Sub Sub172(z As Boolean) As Boolean
	If Not(v_consolidaincassi) Or Not(v_attivaterminale) Or Not(vBln20) Or v_numcassa <> "1" Then
		Return False
	End If
	If Not(ftpmanager.vBln2) Then
		Dim vMsgbox2 As Int = Msgbox2("Attenzione .. non è possibile scaricare il venduto degli altri terminali." & CRLF & "Si desidera proseguire ugualmente ?", vStr8, "Si", "", "No", vBmp1)
		If vMsgbox2 = -1 Then
			Return False
		End If
	End If
	Dim str As String = "getincassiV"
	If z Then
		str = "getincassiC"
	End If
	CallSub2(ftpmanager, "SendMessage", str)
	Return True
End Sub

Sub Sub173(str As String) As String
	Initialize
	Dim sb2 As String = File.DirDefaultExternal & "/ReportPersonalizzati"
	Dim vListFiles As List = File.ListFiles(sb2)
	vListFiles.Sort(True)
	If str.Length = 1 Then
		str = "0" & str
	End If
	If vListFiles.Size > 0 Then
		Dim size As Int = vListFiles.Size - 1
		Dim i As Int
		For i = 0 To size
			Dim vObjectToString As String = vListFiles.Get(i)
			If vObjectToString.ToLowerCase.StartsWith("lp" & str) And vObjectToString.ToLowerCase.EndsWith(".txt") Then
				Return vObjectToString
			End If
		Next
	End If
	Return ""
End Sub

Sub Sub174(list As List) As List
	Dim list2 As List
	list2.Initialize
	list2.Add("Nessuna Lettura")
	list.Add(-100)
	Try
		Initialize
		Dim sb2 As String = File.DirDefaultExternal & "/ReportPersonalizzati"
		Dim vListFiles As List = File.ListFiles(sb2)
		vListFiles.Sort(True)
		If vListFiles.Size > 0 Then
			Dim size As Int = vListFiles.Size - 1
			Dim i As Int
			For i = 0 To size
				Dim vObjectToString As String = vListFiles.Get(i)
				If vObjectToString.ToLowerCase.StartsWith("lp") And vObjectToString.ToLowerCase.EndsWith(".txt") Then
					list2.Add(vObjectToString.Replace("LP", "").Replace("lp", "").Replace(".txt", ""))
					list.Add(vObjectToString.SubString2(2, 4))
				End If
			Next
		End If
	Catch
		mod1.Sub217(LastException.Message)
	End Try
	Return list2
End Sub

