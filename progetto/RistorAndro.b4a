			vSql1.ExecNonQuery("update pagine set plurep = case plurep" & CRLF & TAB & TAB & TAB & "when 0 then 1 " & CRLF & TAB & TAB & TAB & "when 1 then 2" & CRLF & TAB & TAB & TAB & "when 2 then 3" & CRLF & TAB & TAB & TAB & " else 0 end where chiave =" & SmartStringFormatter("", vCur26.GetString("chiave")) & "")
