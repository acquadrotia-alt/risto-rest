Sub Sub275(str As String, i As Int, stringBuilderWrapper As StringBuilder)
	Dim i2 As Int
	If vBln128 And str <> "" And str <> "Inserire Testo" Then
		If str <> -3 Then
			If vBln30 Then
				i2 = 32
			Else If v_stampafattura < 19 Then
				i2 = 40
			Else If v_stampafattura = 200 Then
				i2 = 45
			Else If v_stampafattura = 300 Then
				i2 = 35
			Else
				Return
			End If
			vSql2.ExecNonQuery("delete from TestiDoc where nmov='M_" & i & "'")
			vSql2.ExecNonQuery("insert into TestiDoc (nmov,testo) values('M_" & i & "','" & str & "')")
			Dim vTmp As String = mod1.Sub213(str, i2, "")
			Dim vSplit() As String = Regex.Split(CRLF, vTmp)
			Dim length As Int = vSplit.Length - 1
			Dim i3 As Int
			For i3 = 0 To length
				If vSplit(i3) <> "" Then
					If vBln30 Then
						vccefdll1.ft_testo(vSplit(i3).Trim, 1)
					Else
						stringBuilderWrapper.Append(vSplit(i3).Trim).Append(CRLF)
					End If
				End If
			Next
			If Not(v_attivafe) Then
				If vBln30 Then
					vccefdll1.ft_testo("********************************", 1)
				Else
					stringBuilderWrapper.Append("********************************").Append(CRLF)
				End If
			End If
		End If
	End If
End Sub

