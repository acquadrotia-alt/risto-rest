Sub Sub028
	Try
		Dim sb2 As String = File.DirRootExternal & "/Licenze"
		Initialize
		Dim vListFiles As List = File.ListFiles(sb2)
		If vListFiles.Size <= 0 Then
			Return
		End If
		Dim size As Int = vListFiles.Size - 1
		Dim z As Boolean = False
		Dim i As Int
		For i = 0 To size
			Dim vObjectToString As String = vListFiles.Get(i)
			If vObjectToString.StartsWith("BasicSupport") And vObjectToString.EndsWith("bs") Then
				If vObjectToString.Contains(v_matricola) Or vObjectToString.Contains(vccefdll1.vStr4) Then
					v_codattivazionebs = File.ReadList(sb2, vObjectToString).Get(0)
					z = True
				End If
			Else If vObjectToString.ToLowerCase.StartsWith(vStr8.ToLowerCase) And vObjectToString.EndsWith("txt") And (vObjectToString.Contains(v_matricola) Or vObjectToString.Contains(vccefdll1.vStr4)) Then
				v_codattivazione = File.ReadList(sb2, vObjectToString).Get(0)
				z = True
			End If
			File.Delete(sb2, vObjectToString)
		Next
		If Not(z) Then
			Return
		End If
		mod1.Sub216
		Return
	Catch
		mod1.Sub217(LastException.Message)
		Return
	End Try
End Sub

