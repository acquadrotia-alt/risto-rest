Sub Sub009(str As String) As String
	If vSql1.ExecQuerySingleResult("Select count(*) from operatori where CodAutomatico='" & str.SubString(v_prefissocliente.Length) & "'") = 0 Then
		Msgbox2("Codice non Trovato", vStr8, "OK", "", "", vBmp1)
		Return ""
	End If
	Dim vExecQuerySingleResult As String = vSql1.ExecQuerySingleResult("Select codice from operatori where CodAutomatico='" & str.SubString(v_prefissocliente.Length) & "'")
	If vExecQuerySingleResult.Length = 1 And v_opextended Then
		vExecQuerySingleResult = "0" & vExecQuerySingleResult
	End If
	Return vExecQuerySingleResult & vSql1.ExecQuerySingleResult("Select pwd from operatori where CodAutomatico='" & str.SubString(v_prefissocliente.Length) & "'")
End Sub

