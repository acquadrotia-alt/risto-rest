	Dim str2 As String
	mod1.vStr2 = "Sub ShowConfigTB(b As Button)"
	Try
		trim = Regex.Split(",", buttonWrapper.Tag)(1).Trim
		If vCur26.IsInitialized Then
			vCur26.Close
		End If
		vCur26 = vSql1.ExecQuery("SELECT * FROM Toolbar  where tipo=5 and valore= " & trim)
