			End If
			cursorWrapper.Close
			sql.Close
		Catch
			mod1.Sub217(LastException.Message)
			Msgbox2("Errore nella visualizzazione dei dati ", vStr8, "OK", "", "", vBmp1)
			Return
		End Try
	End If
End Sub

