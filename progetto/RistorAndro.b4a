Sub Buttonadd_Click
	Dim vTmp As Int
	Dim z As Boolean
	Dim vRound2 As Double
	mod1.vStr2 = "Sub ButtonAdd_Click"
	Try
		vInt55 = 0
	Catch
		mod1.Sub217(LastException.Message)
		vBln74 = False
	End Try
	If Not(vBln12) And Not(vBln64) And vTmp = vcustomlistviewold3.Sub007(Sender) >= 0 Then
		If vDbl16 > 0 Then
			ToastMessageShow("Non possibile ... pagamento in corso ...", True)
			lblDisplay.Text = ""
			Return
		End If
		If Sub056() Then
			Return
		End If
		Dim getpanel As Panel = vcustomlistviewold3.getpanel(vTmp)
		Dim labelWrapper As Label = getpanel.GetView(0)
		Dim labelWrapper2 As Label = getpanel.GetView(1)
		vCur16.Position = getpanel.GetView(2).Text
		If Not(mod1.Sub029(vCur16.GetString("codint"))) Then
			If Not(mod1.Sub028(vCur16.GetString("codint"))) And Not(vCur16.GetString("codice").StartsWith("ww")) Then
				Dim vGetString As String = vCur16.GetString("chiave")
				If vCur16.GetInt("qta") = -1 Then
					Dim vMsgbox2 As Int = Msgbox2("Confermi la cancellazione del reso ? ", vStr8, "Si", "", "No", vBmp1)
					If vMsgbox2 = -1 Then
						vStr27 = "DelRow"
						Sub279()
						Return
					End If
					Return
				End If
				If v_turni And vInt25 > 0 Then
					If mod1.Sub145(vCur16.GetString("totcre")) Then
						Return
					End If
				End If
				If (Not(v_checkvarianti) Or Not(vCur16.GetString("codice").ToLowerCase.StartsWith("vv")) Or vSql1.ExecQuerySingleResult("select max(qta) from Ventmp where lower(substr(codice,1,2))<>'vv' and  totcre = '" & vCur16.GetString("totcre") & "'") >= vCur16.GetInt("qta") + 1) And vCur16.GetInt("flgusointerno") <> 1 Then
					If vInt47 <> 0 And vInt47 < 1000 Then
						If vSql1.ExecQuerySingleResult("select qta from Ventmp where chiave =" & vGetString) <> 1 Then
							Msgbox2("I modificatori possono essere applicati su articoli con quantità = 1", vStr8, "OK", "", "", vBmp1)
							Sub055()
							Return
						End If
					Else If vInt47 <> 0 And vCur16.GetString("descrizione").Contains(">") And vCur16.GetString("descrizione").Contains("<") Then
						Dim vGetString2 As String = vCur16.GetString("descrizione")
						If vGetString2.Contains(" <" & vStr34.ToUpperCase & ">") Then
							vStr34 = ""
						End If
					End If
					If vCur16.GetDouble("qta") Mod 1 <> 0 And vCur16.GetString("descrizione").EndsWith(">") Then
						Msgbox2("Articolo non modificabile", vStr8, "OK", "", "", vBmp1)
						Return
					End If
					If vBln60 And vSql1.ExecQuerySingleResult("select count(*) from ArtBloccati where codint='" & vCur16.GetString("codint") & "'") > 0 Then
						Msgbox2("Articolo Esaurito", vStr8, "OK", "", "", vBmp1)
						Return
					End If
					If vCur16.GetDouble("scop") > 0 Then
						If vInt47 <> 0 And vInt47 < 1000 Then
							vRound2 = Round2(vSql1.ExecQuerySingleResult("Select (prezzov * (qta+round(qta*" & vInt47 & ",3)/100) ) as tt from Ventmp  where chiave =" & vCur16.GetString("chiave")), 2)
						Else
							vRound2 = Round2(vSql1.ExecQuerySingleResult("Select (prezzov * (qta+1) ) as tt from Ventmp  where chiave =" & vCur16.GetString("chiave")), 2)
						End If
