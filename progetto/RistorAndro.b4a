		If vCur20.RowCount > 0 Then
			vInt30 = i2 + 100
			If vCur14.IsInitialized Then
				vCur14.Close
			End If
			vCur14 = vSql1.ExecQuery("SELECT * FROM pagine where pagina =" & vInt30 & " order by riga desc ,colonna")
			If vCur14.RowCount > 0 Then
				vLst12.Clear
				Dim rowCount As Int = vCur14.RowCount - 1
				Dim i3 As Int
				For i3 = 0 To rowCount
