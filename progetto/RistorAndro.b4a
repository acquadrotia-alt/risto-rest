Sub Sub183(str As String)
	Dim i As Int
	If File.Exists(str, "tabacchi.xls") Then
		Dim workbookWrapper As Workbook
		workbookWrapper.Initialize(str, "tabacchi.xls")
		Dim vGetSheet As Sheet = workbookWrapper.GetSheet(0)
		If vGetSheet.RowsCount > 0 Then
			Dim vPerYToCurrent As Double = PerYToCurrent(10)
			vCustomProgressDialog1._initialize(Activity, PerXToCurrent(60), (PerXToCurrent(100) - PerXToCurrent(60)) / 2, vPerYToCurrent, "", "", -12303292, 0, "Progress", False)
		End If
		Dim rowsCount As Int = vGetSheet.RowsCount - 1
		Dim i2 As Int
		For i2 = 0 To rowsCount
			If i2 > 2 Then
				Dim strArr(50) As String
				Dim i3 As Int
				For i3 = 0 To 39
					strArr(i3) = vGetSheet.GetCellValue(i3, i2)
				Next
				If strArr(1).Trim <> "" And IsNumber(strArr(1).Trim) Then
					Dim sb As String = "98" & modfunstr.Sub003("00000" & strArr(1).Trim, 5)
					If vSql1.ExecQuerySingleResult("Select count(*) from anagra where codint = '" & sb & "'") > 0 Then
						Dim parseDouble As Double = vSql1.ExecQuerySingleResult("Select list1 from anagra where codint = '" & sb & "'")
						If Not(IsNumber(strArr(8).Trim.Replace(".", "").Replace(",", ""))) Then
							i = 0
						Else
							i = strArr(8).Trim.Replace(".", "").Replace(",", "")
						End If
						If strArr(10).Trim <> "" Or strArr(9).Trim <> "" Then
							vSql1.ExecNonQuery("Update anagra set qtacartone=" & i & " where codint ='" & sb & "'")
						End If
						If strArr(10).Trim <> "" Then
							If vSql1.ExecQuerySingleResult("Select count(*) from ean where codint <> '" & sb & "' and codice ='" & strArr(10) & "'") > 0 Then
								Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select codint from ean where codint <> '" & sb & "' and codice ='" & strArr(10) & "'")
								If cursorWrapper.RowCount > 0 Then
									Dim rowCount As Int = cursorWrapper.RowCount - 1
									Dim i4 As Int
									For i4 = 0 To rowCount
										cursorWrapper.Position = i4
										vSql1.ExecNonQuery("delete from ean where codint ='" & cursorWrapper.GetString("codint") & "' and codice ='" & strArr(10) & "'")
									Next
								End If
								cursorWrapper.Close
							End If
							If i > 0 Then
								If vSql1.ExecQuerySingleResult("Select count(*) from ean where codint = '" & sb & "' and codice ='" & strArr(10) & "'") = 0 Then
									vSql1.ExecNonQuery("INSERT INTO ean (codint,codice,qta,importo)  VALUES('" & sb & "','" & strArr(10) & "'," & i & "," & Round2(parseDouble * i, 2) & ")")
								Else
									vSql1.ExecNonQuery("update ean set qta=" & i & ",importo = " & Round2(parseDouble * i, 2) & " where  codint = '" & sb & "' and codice ='" & strArr(10) & "'")
								End If
							End If
						End If
						If strArr(9).Trim <> "" Then
							If vSql1.ExecQuerySingleResult("Select count(*) from ean where codint <> '" & sb & "' and codice ='" & strArr(9) & "'") > 0 Then
								Dim cursorWrapper2 As Cursor = vSql1.ExecQuery("Select codint from ean where codint <> '" & sb & "' and codice ='" & strArr(9) & "'")
								If cursorWrapper2.RowCount > 0 Then
									Dim rowCount2 As Int = cursorWrapper2.RowCount - 1
									Dim i5 As Int
									For i5 = 0 To rowCount2
										cursorWrapper2.Position = i5
										vSql1.ExecNonQuery("delete from ean where codint ='" & cursorWrapper2.GetString("codint") & "' and codice ='" & strArr(9) & "'")
									Next
								End If
								cursorWrapper2.Close
							End If
							If vSql1.ExecQuerySingleResult("Select count(*) from ean where codint = '" & sb & "' and codice ='" & strArr(9) & "'") = 0 Then
								vSql1.ExecNonQuery("INSERT INTO ean (codint,codice)  VALUES('" & sb & "','" & strArr(9) & "')")
							Else
								vSql1.ExecNonQuery("update ean set qta=1,importo = 0 where  codint = '" & sb & "' and codice ='" & strArr(9) & "'")
							End If
						End If
						If i2 Mod 40 = 0 Then
							vCustomProgressDialog1._showprogress("Importazione Barcode articoli in corso (Step 3)", -1, i2 * 100 / vGetSheet.RowsCount)
							DoEvents
						End If
					End If
				End If
			End If
		Next
		If File.Exists(str, "tabacchi.xls") Then
			File.Delete(str, "tabacchi.xls")
		End If
		vCustomProgressDialog1._hide
		Return
	End If
End Sub

