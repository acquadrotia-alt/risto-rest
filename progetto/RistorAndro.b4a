		If vCur24.GetInt("lock") = 1 Then
			Msgbox2("Il tavolo risulta essere bloccato", vStr8, "OK", "", "", vBmp1)
			vBln19 = False
			ProgressDialogHide
			Return
		End If
		If v_opobbligatorio And Not(vBln25) Then
			Dim str4 As String = ""
			If vCur24.GetLong("rifheadmov") > 0 Then
				str4 = vSql1.ExecQuerySingleResult("Select operatore from headmov where nmov = " & vCur24.GetString("rifheadmov"))
			End If
			If Not(chiediop(str4)) Then
				Return
			End If
		End If
		If Not(vBln77) Then
			vInt44 = vInt30
		End If
		vInt25 = str
		vStr58 = str2
		vCur19.Position = vInt44 - 10
		If vCur19.GetInt("listino") > 0 Then
			vInt37 = vInt6
			vInt6 = vCur19.GetInt("listino")
		End If
		If vInt25 >= 20000 Then
			vDbl8 = vCur19.GetDouble("MaxImporto")
		End If
		vBln76 = False
		v_servizio = vCur19.GetInt("servizio")
		vInt35 = 0
		If v_turni Then
			vInt7 = 1
			vInt59 = 0
			mod1.vMap1.Clear
		End If
		If vCur24.GetLong("rifheadmov") > 0 Then
			vBln83 = True
			lblDisplay.Text = vCur24.GetString("rifheadmov")
			Dim str5 As String = vInt25 & "_" & vCur24.GetString("rifheadmov")
			mod1.Sub089(False, str5)
			vBln87 = (v_controlloturni And v_turni)
			eseguifunzione(f_recallmov)
			If v_turni Then
