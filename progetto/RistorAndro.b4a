Sub Sub256(str As String, z As Boolean, str2 As String) As String
	Dim str3 As String
	If vBln20 And v_attivaterminale And v_giacsede And str2 = "" Then
		vStr43 = "giac_" & v_nnegozio & "_" & str & "_"
		If vBln14 Then
			ToastMessageShow("Terminale Offline ...", True)
			ProgressDialogHide
		Else
			Dim object As Class = ftpmanager
			CallSub2(object, "SendMessageBO", vStr43)
		End If
		Return ""
	End If
	Dim str4 As String = ""
	Dim cursorWrapper As Cursor = vSql1.ExecQuery("select * from anagra where codint ='" & str & "'")
	If cursorWrapper.RowCount > 0 Then
		cursorWrapper.Position = 0
		Dim str5 As String = "Codice  :  " & cursorWrapper.GetString("codint") & CRLF & "Descrizione  :  " & cursorWrapper.GetString("descrizione") & CRLF & "Reparto  :  " & vSql1.ExecQuerySingleResult("Select descrizione from reparti where codice =" & cursorWrapper.GetString("reparto")) & CRLF & "Iva  :  " & vSql1.ExecQuerySingleResult("Select descrizione from iva where codice =" & cursorWrapper.GetString("iva")) & CRLF & "Listino 1  :  " & NumberFormat2(cursorWrapper.GetDouble("list1"), 1, 2, 2, False) & CRLF & "Listino 2  :  " & NumberFormat2(cursorWrapper.GetDouble("list2"), 1, 2, 2, False) & CRLF & "Listino 3  :  " & NumberFormat2(cursorWrapper.GetDouble("list3"), 1, 2, 2, False) & CRLF & "Listino 4  :  " & NumberFormat2(cursorWrapper.GetDouble("list4"), 1, 2, 2, False) & CRLF & "Acquisto :  " & NumberFormat2(cursorWrapper.GetDouble("list5"), 1, 2, 2, False) & CRLF
		If str2 <> "" Then
			str3 = str5 & str2 & CRLF
		Else
			str3 = str5 & "Giacenza   :  " & cursorWrapper.GetString("giac") & CRLF
		End If
		If Not(vBln25) Then
			Dim vRound2 As Double = Round2(cursorWrapper.GetDouble("giac") - vSql1.ExecQuerySingleResult("Select case when sum(qta) is null then 0 else sum(qta) end from Venduto inner join headmov on venduto.nmov=headmov.nmov where headmov.sospeso=1 AND codint = '" & SmartStringFormatter("", str) & "'"), 3)
			If vRound2 Mod 1 = 0 Then
				str4 = str3 & "Disponibilità :  " & NumberFormat(vRound2, 1, 0) & CRLF
			Else
				str4 = str3 & "Disponibilità :  " & NumberFormat2(vRound2, 1, 3, 3, False) & CRLF
			End If
		Else
			str4 = str3
