		End If
		Dim list As List = randomAccessFile.ReadObject(randomAccessFile.CurrentPosition)
		randomAccessFile.Close
		If Not(list.IsInitialized) Then
			mod1.Sub215("Errore nella struttura del file job (" & str & ")")
			Return
		End If
