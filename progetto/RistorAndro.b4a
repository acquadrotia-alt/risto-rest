				list.AddAll(File.ListFiles(sb3))
				list.Sort(False)
				File.MakeDir(File.DirRootExternal, "DriveSyncFiles")
				Dim sb5 As String = File.DirRootExternal & "/DriveSyncFiles"
				Dim size As Int = list.Size - 1
				Do While True
					If i > size Then
						Exit
					End If
					Dim vObjectToString As String = list.Get(i)
					If Not(vObjectToString.EndsWith(".db")) Then
						i = i + 1
					Else
						File.Copy(sb3, vObjectToString, sb5, vObjectToString)
						Dim sql As SQL
						sql.Initialize(sb5, vObjectToString, False)
						If sql.ExecQuerySingleResult("select count(*) from SyncItems where substr(localFilename,-6)='DB.zip'") > 0 Then
							Dim parseDouble As Long = sql.ExecQuerySingleResult("select max(localLastModified) from SyncItems where substr(localFilename,-6)='DB.zip'")
							If parseDouble > 0 And v_datalastbackup <> parseDouble Then
								v_datalastbackup = parseDouble
								mod1.Sub216
							End If
						End If
						sql.Close
					End If
				Loop
				Sub119(sb5)
				Return
			End If
			Return
		End If
		Return
	Catch
		mod1.Sub217(LastException.Message)
		Return
	End Try
End Sub

