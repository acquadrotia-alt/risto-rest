Sub Sub001
	If vSql1.ExecQuerySingleResult("Select count(*) from pagine where pagina =101") = 0 Then
		vSql1.ExecNonQuery("insert into pagine([pagina],[tasto],[riga],[colonna],[dimensione],[colore],[testo],[tipo],[valore],[icona],[plurep],[colorec],[colores],[coloret],[importo],[textsize],[dll],[locked]) Select %pag%,[tasto],[riga],[colonna],[dimensione],[colore],[testo],[tipo],[valore],[icona],[plurep],[colorec],[colores],[coloret],[importo],[textsize],[dll],[locked] FROM Pagine where pagina = 100".Replace("%pag%", "101"))
		Sub038(101)
	End If
	If vSql1.ExecQuerySingleResult("Select count(*) from pagine where pagina =102") = 0 Then
		vSql1.ExecNonQuery("insert into pagine([pagina],[tasto],[riga],[colonna],[dimensione],[colore],[testo],[tipo],[valore],[icona],[plurep],[colorec],[colores],[coloret],[importo],[textsize],[dll],[locked]) Select %pag%,[tasto],[riga],[colonna],[dimensione],[colore],[testo],[tipo],[valore],[icona],[plurep],[colorec],[colores],[coloret],[importo],[textsize],[dll],[locked] FROM Pagine where pagina = 100".Replace("%pag%", "102"))
		Sub038(102)
	End If
	If vSql1.ExecQuerySingleResult("Select count(*) from pagine where pagina =103") <> 0 Then
		Return
	End If
	vSql1.ExecNonQuery("insert into pagine([pagina],[tasto],[riga],[colonna],[dimensione],[colore],[testo],[tipo],[valore],[icona],[plurep],[colorec],[colores],[coloret],[importo],[textsize],[dll],[locked]) Select %pag%,[tasto],[riga],[colonna],[dimensione],[colore],[testo],[tipo],[valore],[icona],[plurep],[colorec],[colores],[coloret],[importo],[textsize],[dll],[locked] FROM Pagine where pagina = 100".Replace("%pag%", "103"))
	Sub038(103)
End Sub

Sub Sub002
	Dim vTmp As Long = mod1.Sub058
	If vSql1.ExecQuerySingleResult("Select count(*) from clienti where attivo=1 and scadcliente <='" & DateTime.GetYear(vTmp) & "-" & NumberFormat(DateTime.GetMonth(vTmp), 2, 0) & "-" & NumberFormat(DateTime.GetDayOfMonth(vTmp), 2, 0) & "'") <= 0 Then
		Return
	End If
	vSql1.ExecNonQuery("update clienti set attivo =0 where attivo=1 and scadcliente <='" & DateTime.GetYear(vTmp) & "-" & NumberFormat(DateTime.GetMonth(vTmp), 2, 0) & "-" & NumberFormat(DateTime.GetDayOfMonth(vTmp), 2, 0) & "'")
End Sub

Sub Sub003(str As String) As Int
	Dim packageManagerWrapper As PackageManager
	Dim vGetInstalledPackages As List = packageManagerWrapper.GetInstalledPackages
	Dim size As Int = vGetInstalledPackages.Size - 1
	Dim i As Int
	For i = 0 To size
		If vGetInstalledPackages.Get(i) = str Then
			Dim vGetVersionCode As Int = packageManagerWrapper.GetVersionCode(str)
			If vGetVersionCode < 300 Then
				Return 1
			End If
			If vGetVersionCode < 400 Then
				Return 2
			End If
			Return IIf(vGetVersionCode < 500, 3, 4)
		End If
	Next
	Return 0
End Sub

Sub Sub004(labelWrapper As Label, str As String, labelWrapper2 As Label)
	Dim d As Double
	Dim str2 As String
	mod1.vStr2 = "Sub ValorizzaQta(lqta As Label,mtchiave As String,testo As Label)"
	Try
		Dim cursorWrapper As Cursor = vSql1.ExecQuery("select qta,prezzov,importo,scov,descrizione,scop,flgmag,flgusointerno,Oldqta,importo2,memo,TipoSconto from Ventmp where  chiave =" & str)
		cursorWrapper.Position = 0
		If Round2(cursorWrapper.GetDouble("qta"), 3) <> 1 Then
			labelWrapper.Text = vCSBuilder1.Initialize.Size(vInt54 - 2).Append(cursorWrapper.GetString("qta") & " X " & NumberFormat2(cursorWrapper.GetDouble("prezzov"), 1, 2, 2, False) & CRLF).Size(vInt54 + 2).Bold.Append(NumberFormat2(cursorWrapper.GetDouble("importo"), 1, 2, 2, False)).PopAll
		Else
			labelWrapper.Text = vCSBuilder1.Initialize.Size(vInt54 + 2).Bold.Append(NumberFormat2(cursorWrapper.GetDouble("importo"), 1, 2, 2, False)).PopAll
		End If
		If cursorWrapper.GetDouble("importo2") <> 0 Then
			labelWrapper.Text = vCSBuilder1.Initialize.Size(vInt54 + 2).Bold.Append(NumberFormat2(cursorWrapper.GetDouble("importo") + cursorWrapper.GetDouble("importo2"), 1, 2, 2, False) & CRLF).Pop.Size(vInt54 - 2).Append(labelWrapper.Text).PopAll
		End If
		If cursorWrapper.GetDouble("scop") > 0 Then
			Dim str3 As String = IIf(cursorWrapper.GetInt("TipoSconto") = sc_omaggio, "Omaggio", IIf(cursorWrapper.GetInt("TipoSconto") = sc_giapagato, "Corr.già Pagato", "Sconto"))
			labelWrapper2.Text = cursorWrapper.GetString("descrizione") & CRLF & "(" & str3 & " " & NumberFormat2(cursorWrapper.GetString("scov"), 1, 2, 2, False) & ")"
			If str3 = "Omaggio" Then
				labelWrapper2.Background = mod1.Sub158(-65536, -1)
			Else
				Dim vRGB As Int = Colors.RGB(255, 255, 173)
				labelWrapper2.Background = mod1.Sub158(vRGB, -1)
			End If
		Else If cursorWrapper.GetDouble("scop") < 0 Then
			labelWrapper2.Text = cursorWrapper.GetString("descrizione") & CRLF & "(Maggiorazione " & NumberFormat2(Abs(cursorWrapper.GetDouble("scov")), 1, 2, 2, False) & ")"
			Dim vRGB2 As Int = Colors.RGB(255, 205, 133)
			labelWrapper2.Background = mod1.Sub158(vRGB2, -1)
		Else
			labelWrapper2.Text = cursorWrapper.GetString("descrizione")
			Dim vRGB3 As Int = Colors.RGB(222, 222, 222)
			labelWrapper2.Background = mod1.Sub158(vRGB3, -1)
			If vCur16.GetString("codice").StartsWith("vv") Then
				Dim vRGB4 As Int = Colors.RGB(180, 122, 222)
				labelWrapper2.Background = mod1.Sub158(vRGB4, -1)
			End If
			If vCur16.GetString("codice").StartsWith("ww") Then
				Dim vRGB5 As Int = Colors.RGB(40, 122, 22)
				labelWrapper2.Background = mod1.Sub158(vRGB5, -1)
			End If
		End If
		If cursorWrapper.GetDouble("Oldqta") > 0 Then
			Dim vRound2 As Double = Round2(cursorWrapper.GetDouble("qta") - cursorWrapper.GetDouble("Oldqta"), 3)
			If vRound2 <> 0 Then
				labelWrapper2.Text = IIf(vRound2 > 0, "(+", "(") & vRound2 & ") " & labelWrapper2.Text
			End If
		End If
		If cursorWrapper.GetInt("flgmag") = 1 And cursorWrapper.GetInt("flgusointerno") = 0 And Not(vCur16.GetString("codice").StartsWith("ww")) Then
			If Not(v_attivaterminale And vBln20 And v_giacsede) Then
				Dim cursorWrapper2 As Cursor = vSql1.ExecQuery("select giac,sottoscorta from anagra where codint = '" & vCur16.GetString("codint") & "'")
				cursorWrapper2.Position = 0
				Dim doubleValue As Double = cursorWrapper2.GetDouble("giac")
				If v_adddisponibilita Then
					d = doubleValue - vSql1.ExecQuerySingleResult("Select case when sum(qta) is null then 0 else sum(qta) end from Venduto inner join headmov on venduto.nmov=headmov.nmov where headmov.sospeso=1  AND codint = '" & SmartStringFormatter("", vCur16.GetString("codint")) & "'")
					str2 = "Disp."
				Else
					d = doubleValue
					str2 = "Giac."
				End If
				If 1000 * d Mod 1000 = 0 Then
					labelWrapper2.Text = labelWrapper2.Text & " (" & str2 & NumberFormat2(d, 1, 0, 0, False) & ")"
				Else
					labelWrapper2.Text = labelWrapper2.Text & " (" & str2 & NumberFormat2(d, 1, 3, 3, False) & ")"
				End If
				If cursorWrapper2.GetInt("sottoscorta") > 0 And d < cursorWrapper2.GetInt("sottoscorta") Then
					Dim vRGB6 As Int = Colors.RGB(124, 255, 192)
					labelWrapper2.Background = mod1.Sub158(vRGB6, -1)
					labelWrapper2.TextColor = -16777216
				End If
				If d <= 0 Then
					Dim vRGB7 As Int = Colors.RGB(160, 212, 255)
					labelWrapper2.Background = mod1.Sub158(vRGB7, -1)
					labelWrapper2.TextColor = -16777216
				End If
				cursorWrapper2.Close
			End If
		End If
		If cursorWrapper.GetDouble("importo") = 0 And Not(vCur16.GetString("codice").StartsWith("vv")) And Not(vCur16.GetString("codice").StartsWith("ww")) Then
			If Not(mod1.Sub029(vCur16.GetString("codint"))) Then
				If Not(mod1.Sub028(vCur16.GetString("codint"))) Then
					labelWrapper2.Background = mod1.Sub158(-65536, -1)
				End If
			End If
		End If
		If cursorWrapper.GetString("memo") <> "" Then
			Dim vBold As CSBuilder = vCSBuilder1.Initialize.Append(labelWrapper2.Text & CRLF).Bold
			labelWrapper2.Text = vBold.Color(-16776961).Append(cursorWrapper.GetString("memo")).PopAll
		End If
		If vCur16.GetInt("distinta") = 1 And Not(vCur16.GetString("codice").StartsWith("vv")) And Not(vCur16.GetString("codice").StartsWith("ww")) Then
			If vSql1.ExecQuerySingleResult("Select count(*) from anagra inner join distintabase on distintabase.codintpadre = anagra.codint where giac <=0 and distintabase.codint = '" & vCur16.GetString("codint") & "'") > 0 Then
				labelWrapper2.Background = mod1.Sub158(-65536, -1)
			Else If vSql1.ExecQuerySingleResult("Select count(*) from anagra inner join distintabase on distintabase.codintpadre = anagra.codint where giac < sottoscorta and distintabase.codint = '" & vCur16.GetString("codint") & "'") > 0 Then
				Dim vRGB8 As Int = Colors.RGB(255, 143, 88)
				labelWrapper2.Background = mod1.Sub158(vRGB8, -1)
			End If
		End If
		cursorWrapper.Close
		Return
	Catch
		mod1.Sub217(LastException.Message)
		Return
	End Try
End Sub

Sub Sub005(j As Long)
	Dim str As String
	mod1.vStr2 = "Sub UpdDisplay(tmpchiave As Long)"
	Try
		Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select * from VenTmp where chiave = " & j)
		If cursorWrapper.RowCount > 0 Then
			cursorWrapper.Position = 0
			Dim vRound2 As Double = Round2(cursorWrapper.GetDouble("importo") + cursorWrapper.GetDouble("importo2"), 2)
			Dim length As Int = NumberFormat2(vRound2, 1, 2, 2, False).Length
			Dim left As String = modfunstr.left(cursorWrapper.GetString("descrizione"), 20 - length - 3)
			Dim vTmp As String = modfunstr.Sub004(20 - length - modfunstr.left(cursorWrapper.GetString("descrizione"), 20 - length - 3).Length)
			Dim vNumberFormat2 As String = NumberFormat2(vRound2, 1, 2, 2, False)
			Dim str2 As String = left & vTmp & vNumberFormat2
			vccefdll1.mf_display(str2, "TOTALE" & modfunstr.Sub003(modfunstr.Sub004(14) & NumberFormat2(vDbl1 + vDbl12 + vInt51, 1, 2, 2, False), 14))
			If v_ipvis <> "" Then
				If vBln12 And cursorWrapper.GetString("Qtad") <= 0 Then
					CallSub2(httpclient, "UpdVis", "")
					Return
				End If
				Dim parseDouble As Double = vSql1.ExecQuerySingleResult("select case when sum(importo) is null then 0 else sum(importo) end as tot from Ventmp where totcre='" & cursorWrapper.GetString("totcre") & "'")
				If vBln12 Then
					Dim parseDouble2 As Double = vSql1.ExecQuerySingleResult("select case when sum(importod) is null then 0 else sum(importod) end as tot from Ventmp where totcre='" & cursorWrapper.GetString("totcre") & "'")
					str = "R," & cursorWrapper.GetString("chiave") & "," & mod1.Sub038(cursorWrapper.GetString("descrizione"), 50, False).Replace(",", ".").Replace(" ", "_").Replace(">", "").Replace("<", "") & "," & NumberFormat2(parseDouble2, 1, 2, 2, False).Replace(",", ".") & "," & NumberFormat2(cursorWrapper.GetDouble("scov"), 1, 2, 2, False).Replace(",", ".") & "," & cursorWrapper.GetString("codice").Replace(" ", "_") & "," & cursorWrapper.GetString("Qtad").Replace(",", ".") & "," & NumberFormat2(cursorWrapper.GetDouble("prezzov"), 1, 2, 2, False).Replace(",", ".") & "," & cursorWrapper.GetString("totcre").Replace(",", ".")
				Else
					str = "R," & cursorWrapper.GetString("chiave") & "," & mod1.Sub038(cursorWrapper.GetString("descrizione"), 50, False).Replace(",", ".").Replace(" ", "_").Replace(">", "").Replace("<", "") & "," & NumberFormat2(parseDouble, 1, 2, 2, False).Replace(",", ".") & "," & NumberFormat2(cursorWrapper.GetDouble("scov"), 1, 2, 2, False).Replace(",", ".") & "," & cursorWrapper.GetString("codice").Replace(" ", "_") & "," & cursorWrapper.GetString("qta").Replace(",", ".") & "," & NumberFormat2(cursorWrapper.GetDouble("prezzov"), 1, 2, 2, False).Replace(",", ".") & "," & cursorWrapper.GetString("totcre").Replace(",", ".")
				End If
				CallSub2(httpclient, "UpdVis", str)
			End If
		End If
		cursorWrapper.Close
	Catch
		mod1.Sub217(LastException.Message)
	End Try
End Sub

'### RISTRUTTURARE: Resumable Sub convertita come macchina a stati (comportamento identico all'originale).
Sub ValidaDatiFattura As ResumableSub
	Dim limit48 As Int
	Dim step48 As Int
	Dim mapdatife As Map
	Dim tmpimpp As Double
	Dim pagam As Double
	Dim tmpts As Double
	Dim tmpc As Cursor
	Dim squery As String
	Dim ltipodoc As List
	Dim bnotadicredito As Boolean
	Dim ctmptd As Cursor
	Dim scodicerecalltipodoc As String
	Dim iposizionerecalltipodoc As Int
	Dim tmpcrecall As Cursor
	Dim tmpk As String
	Dim icontaaggiunti As Int
	Dim xx As Int
	Dim stmpvalidacli As String
	Dim detailsdialog As CustomLayoutDialog
	Dim stmp As String
	Dim sf As Object
	Dim pnl As Panel
	Dim esigibilitacli As Int
	Dim tmptf As String
	Dim res As Int
	Dim rsState As Int = 0
	Do While True
		Select rsState
			Case -1
				Return Null
			Case 0
				rsState = 1
				'mapdatife = Map
				Continue
			Case 1
				rsState = 158
				If Not(vBln127) Then
					Continue
				Else
					If Not(v_attivafe) Then
						Continue
					Else
						rsState = 3
						Continue
					End If
				End If
				'(fallthrough java verso il case successivo)
				rsState = 3
			Case 3
				rsState = 4
				Continue
			Case 4
				rsState = 9
				If mod1.Sub208 Then
					Continue
				Else
					rsState = 6
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 6
			Case 6
				rsState = 9
				Return mapdatife
			Case 9
				rsState = 10
				tmpimpp = 0
				If lblDisplay.Text = "" Then
					text = "0"
				Else
					text = lblDisplay.Text
				End If
				pagam = text
				Continue
			Case 10
				rsState = 15
				If Not(lblDisplay.Text.Contains(".")) Then
					rsState = 14
					Continue
				Else
					rsState = 12
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 12
			Case 12
				rsState = 15
				Dim d As Double = pagam
				tmpimpp = Round2(d * vDbl19, 2)
				Continue
			Case 14
				rsState = 15
				Dim d2 As Double = pagam
				tmpimpp = Round2(d2 * vDbl19 / 100, 2)
				Continue
			Case 15
				rsState = 16
				tmpts = Round2(vSql1.ExecQuerySingleResult("Select sum(importo) from VenTmp"), 2)
				Continue
			Case 16
				rsState = 157
				If vStr28 <> "" Then
					rsState = 20
					Continue
				Else
					rsState = 18
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 18
			Case 18
				rsState = 157
				Dim vObjectToCharSequence As Object = "E' necessario inserire un cliente per emettere Fattura."
				Dim vObjectToCharSequence2 As Object = vStr8
				Msgbox2(vObjectToCharSequence, vObjectToCharSequence2, "OK", "", "", vBmp1)
				lblDisplay.Text = ""
				Continue
			Case 20
				rsState = 21
				mod1.Sub003(vStr28)
				Continue
			Case 21
				rsState = 156
				If vSql1.ExecQuerySingleResult("select count(*) from ventmp as v inner join iva as i on v.iva=i.codice where i.natura=0 and i.aliquota2=0") <= 0 Then
					rsState = 25
					Continue
				Else
					rsState = 23
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 23
			Case 23
				rsState = 156
				Dim vObjectToCharSequence3 As Object = "Nella configurazione delle aliquote IVA non sono stati inseriti i dati necessari sulla Natura(in caso di Aliquota=0)."
				Dim vObjectToCharSequence4 As Object = vStr8
				Msgbox2(vObjectToCharSequence3, vObjectToCharSequence4, "OK", "", "", vBmp1)
				lblDisplay.Text = ""
				Continue
			Case 25
				rsState = 26
				'tmpc = Cursor
				Dim cursorWrapper As Cursor
				tmpc = vSql1.ExecQuery("Select * from FEdatiCli where Codice ='" & vStr28 & "'")
				tmpc.Position = 0
				squery = "select * from FECodiciDocumento where AttivoDiretta > 0  order by AttivoDiretta desc, documento"
				Continue
			Case 26
				rsState = 29
				Dim vGetString As String = vCur7.GetString("CodForn")
				If vGetString <> vCur17.GetString("piva") Then
					Continue
				Else
					If vCur17.GetString("piva") <> "" Then
						rsState = 28
						Continue
					Else
						Continue
					End If
				End If
				'(fallthrough java verso il case successivo)
				rsState = 28
			Case 28
				rsState = 29
				squery = "select * from FECodiciDocumento where AttivoStessaPIDiretta> 0  order by AttivoStessaPIDiretta desc, documento"
				Continue
			Case 29
				rsState = 30
				'ltipodoc = List
				ltipodoc.Initialize
				bnotadicredito = (tmpts < 0)
				'ctmptd = Cursor
				Dim cursorWrapper2 As Cursor
				ctmptd = vSql1.ExecQuery(squery)
				scodicerecalltipodoc = ""
				iposizionerecalltipodoc = 0
				'tmpcrecall = Cursor
				Continue
			Case 30
				rsState = 42
				If vBln113 Then
					If vMap12.IsInitialized Then
						rsState = 32
						Continue
					End If
				End If
				If vLng11 <= 0 Then
					Continue
				Else
					rsState = 34
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 32
			Case 32
				rsState = 42
				scodicerecalltipodoc = vMap12.Get("TipoDocumento")
				Continue
			Case 34
				rsState = 35
				tmpk = ""
				Continue
			Case 35
				rsState = 38
				If vStr53.Length < 10 Then
					Continue
				Else
					rsState = 37
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 37
			Case 37
				rsState = 38
				tmpk = v_nnegozio & "_" & v_numcassa & "_" & v_barra & "_" & vStr53.SubString(6) & "-" & vStr53.SubString2(0, 2) & "-" & vStr53.SubString2(3, 5) & "_" & vInt74
				Continue
			Case 38
				rsState = 41
				If tmpk.Length <= 0 Then
					Continue
				Else
					If vSql2.ExecQuerySingleResult("Select count(*) from FEDatiMov where Chiave ='" & tmpk & "'") <= 0 Then
						Continue
					Else
						rsState = 40
						Continue
					End If
				End If
				'(fallthrough java verso il case successivo)
				rsState = 40
			Case 40
				rsState = 41
				Dim cursorWrapper3 As Cursor
				tmpcrecall = vSql2.ExecQuery("Select * from FEDatiMov where Chiave ='" & tmpk & "'")
				tmpcrecall.Position = 0
				scodicerecalltipodoc = tmpcrecall.GetString("TipoDoc")
				Continue
			Case 41
				rsState = 42
				Continue
			Case 42
				rsState = 43
				icontaaggiunti = 0
				Continue
			Case 43
				rsState = 62
				step48 = 1
				limit48 = ctmptd.RowCount - 1
				xx = 0
				rsState = 159
				Continue
			Case 45
				rsState = 46
				ctmptd.Position = xx
				Continue
			Case 46
				rsState = 51
				If bnotadicredito And ctmptd.GetString("documento") <> "TD04" Then
					rsState = 48
					Continue
				End If
				Continue
			Case 48
				rsState = 51
				rsState = 160
				Continue
			Case 51
				rsState = 52
				Continue
			Case 52
				rsState = 57
				If Not(bnotadicredito) And ctmptd.GetString("documento") = "TD04" Then
					rsState = 54
					Continue
				End If
				Continue
			Case 54
				rsState = 57
				rsState = 160
				Continue
			Case 57
				rsState = 58
				ltipodoc.Add(ctmptd.GetString("descrizione"))
				Continue
			Case 58
				rsState = 61
				If scodicerecalltipodoc <> ctmptd.GetString("documento") Then
					Continue
				Else
					rsState = 60
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 60
			Case 60
				rsState = 61
				iposizionerecalltipodoc = icontaaggiunti
				scodicerecalltipodoc = ""
				Continue
			Case 61
				rsState = 160
				icontaaggiunti = icontaaggiunti + 1
				Continue
			Case 62
				rsState = 63
				Dim vGetInt As Int = tmpc.GetInt("TipoSoggettoCli")
				Dim vGetString2 As String = tmpc.GetString("NomeCli")
				Dim vGetString3 As String = tmpc.GetString("CognomeCli")
				Dim vGetString4 As String = vCur17.GetString("piva")
				Dim vGetString5 As String = vCur17.GetString("codf")
				Dim vGetString6 As String = tmpc.GetString("NazioneCli")
				Dim vGetString7 As String = tmpc.GetString("CodiceDestinatario")
				Dim vGetString8 As String = vCur17.GetString("descrizione")
				Dim vGetString9 As String = vCur17.GetString("provincia")
				Dim vGetString10 As String = vCur17.GetString("via")
				stmpvalidacli = mod1.Sub211(vGetInt, vGetString2, vGetString3, vGetString4, vGetString5, vGetString6, vGetString7, vGetString8, vGetString9, vGetString10, vCur17.GetString("citta"))
				Continue
			Case 63
				rsState = 138
				If stmpvalidacli <> "" Then
					rsState = 65
					Continue
				Else If scodicerecalltipodoc <> "" Then
					rsState = 67
					Continue
				Else If ltipodoc.Size <> 0 Then
					rsState = 71
					Continue
				Else
					rsState = 69
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 65
			Case 65
				rsState = 138
				Dim vObjectToCharSequence5 As Object = "ERRORE VALIDAZIONE DATI DEL CLIENTE:" & CRLF & stmpvalidacli
				Dim vObjectToCharSequence6 As Object = vStr8
				Msgbox2(vObjectToCharSequence5, vObjectToCharSequence6, "OK", "", "", vBmp1)
				lblDisplay.Text = ""
				Continue
			Case 67
				rsState = 138
				Dim vObjectToCharSequence7 As Object = "Il tipo documento " & SmartStringFormatter("", scodicerecalltipodoc) & " non è disponibile"
				Dim vObjectToCharSequence8 As Object = vStr8
				Msgbox2(vObjectToCharSequence7, vObjectToCharSequence8, "OK", "", "", vBmp1)
				lblDisplay.Text = ""
				Continue
			Case 69
				rsState = 138
				Dim vObjectToCharSequence9 As Object = "Non è disponibile nessun tipo documento per la generazione della fattura"
				Dim vObjectToCharSequence10 As Object = vStr8
				Msgbox2(vObjectToCharSequence9, vObjectToCharSequence10, "OK", "", "", vBmp1)
				lblDisplay.Text = ""
				Continue
			Case 71
				rsState = 72
				Continue
			Case 72
				rsState = 137
				If tmpimpp <> 0 Then
					Dim d3 As Double = tmpimpp
					If Round2(d3 + vDbl16, 2) < tmpts Then
						rsState = 136
						Continue
					End If
				End If
				rsState = 74
				Continue
			Case 74
				rsState = 75
				'detailsdialog = CustomLayoutDialog
				stmp = "Dati per l'emissione della fattura"
				Dim customLayoutDialog As CustomLayoutDialog = detailsdialog
				Dim str As String = stmp
				sf = customLayoutDialog.ShowAsync(str, "Ok", "Annulla", "", vBmp1, True)
				detailsdialog.SetSize(PerXToCurrent(60), PerYToCurrent(90))
				Wait For (sf) Dialog_Ready (wf161_0 As Panel)
				rsState = 161
				Continue
			Case 75
				rsState = 80
				If vSql1.ExecQuerySingleResult("select count(*) from Ventmp as v inner join iva as i on v.iva=i.codice where natura=6") <> 0 Then
					Continue
				Else
					rsState = 77
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 77
			Case 77
				rsState = 80
				pEIva2.Add("Split Payment")
				Continue
			Case 80
				rsState = 81
				Continue
			Case 81
				rsState = 86
				If tmpc.GetInt("TipoSoggettoCli") <> 0 Then
					rsState = 85
					Continue
				Else
					rsState = 83
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 83
			Case 83
				rsState = 86
				Dim vSize As CSBuilder = vCSBuilder1.Initialize.Size(14).Append("Numero di copie stampa di riepilogo: " & CRLF).Bold.Size(20)
				bNumeroCopie.Text = vSize.Append(v_copiefe2).PopAll
				bNumeroCopie.Tag = v_copiefe2
				Continue
			Case 85
				rsState = 86
				Dim vSize2 As CSBuilder = vCSBuilder1.Initialize.Size(14).Append("Numero di copie stampa di riepilogo: " & CRLF).Bold.Size(20)
				bNumeroCopie.Text = vSize2.Append(v_copiefe).PopAll
				bNumeroCopie.Tag = v_copiefe
				Continue
			Case 86
				rsState = 87
				esigibilitacli = vSql1.ExecQuerySingleResult("select EsigibilitaIVA from FEdatiCli where Codice ='" & vStr28 & "'")
				Continue
			Case 87
				rsState = 92
				Dim i As Int = esigibilitacli
				If i > pEIva2.Size - 1 Then
					rsState = 91
					Continue
				Else
					rsState = 89
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 89
			Case 89
				rsState = 92
				pEIva2.SelectedIndex = esigibilitacli
				Continue
			Case 91
				rsState = 92
				pEIva2.SelectedIndex = 0
				Continue
			Case 92
				rsState = 93
				edtCIG.Text = ""
				edtCUP.Text = ""
				edtIDOrdAcq.Text = ""
				tmptf = ""
				Continue
			Case 93
				rsState = 120
				If vBln113 Then
					If vMap12.IsInitialized Then
						rsState = 95
						Continue
					End If
				End If
				If vLng11 <= 0 Then
					If vStr28 <> "" Then
						rsState = 115
						Continue
					Else
						Continue
					End If
				Else
					rsState = 97
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 95
			Case 95
				rsState = 120
				edtImportoBollo.Text = vMap12.Get("ImportoBollo")
