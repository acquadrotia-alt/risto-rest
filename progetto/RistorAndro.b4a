Sub Timertime_Tick
	Sub241()
	If vTmr3.Interval = 100 Then
		vTmr3.Interval = (61 - DateTime.GetSecond(mod1.Sub058)) * 1000
	Else If vTmr3.Interval = 150 Then
		vTmr3.Interval = (61 - DateTime.GetSecond(mod1.Sub058)) * 1000
		If v_termsala And vBln11 And v_termsalab > 0 Then
			vStr27 = "CambiaOP"
			Sub279()
		End If
	Else
		vTmr3.Interval = 60000
	End If
	checkfiledaremoto()
	If vBln25 Then
		changestateclient()
	End If
	applyvar(True)
	If ((v_ipvis <> "" And v_salvavd = 1) Or ((v_salvavd = 2 And v_usbpath <> "") Or (v_iprpi <> "" And v_salvavd = 3))) And v_salvavd > 0 And Not(v_emergenza) Then
		vInt56 = vInt56 + 1
		If vInt56 > 3 Then
			vInt56 = 0
			Sub094()
		End If
	End If
	If vInt30 >= 10 And vInt30 < 100 Then
		If vBln41 Then
			mod1.Sub162
		End If
		If vclsslidingsidebar1.Sub010 Then
			mod1.Sub161(PnlRecall, 9)
		End If
	End If
	If mod1.vBln11 Then
		If vcustomlistviewold3.Sub008 = 0 And vLng11 = 0 And vStr6 = "" Then
			Sub085()
		Else If vcustomlistviewold3.Sub008 > 0 Then
			ToastMessageShow("Non è possibile effettuare la Chiusura Giornaliera con articoli selezionati", True)
		Else If vLng11 > 0 Then
			ToastMessageShow("Non è possibile effettuare la Chiusura Giornaliera durante un richiamo movimento", True)
		Else If vStr6 <> "" Then
			ToastMessageShow("Per effettuare la Chiusura Giornaliera è necessario essere all'interno di un movimento di vendita", True)
		End If
	End If
	If v_spooler Then
		vInt16 = vInt16 + 1
		If vInt16 > 4 Then
			Msgbox2("Il programma per la stampa delle comande non risponde." & CRLF & "Fino al prossimo riavvio del programma le comande verranno stampate da RistorAndro.", vStr8, "OK", "", "", vBmp1)
			v_spooler = False
			mod1.Sub215("Il programma per la stampa delle comande non risponde.")
		End If
	End If
	vInt55 = vInt55 + 1
	If v_termsala And v_termsalab > 0 And vInt55 > 2 And vInt25 = 0 And Not(vBln116) Then
		vStr27 = "CambiaOP"
		Sub279()
	End If
	If Not(pnlW.Visible) Then
		If vInt55 = 4 Then
			If vBln94 Then
				StartFTP()
			End If
		Else If vInt55 > 4 And Not(vBln94) And v_salvaora >= 0 Then
			If v_salvaora <= DateTime.GetHour(mod1.Sub058) Then
				Dim vGetDayOfYear As Int = DateTime.GetDayOfYear(mod1.Sub058)
				If vGetDayOfYear <> DateTime.GetDayOfYear(v_datalastbackup) Then
					pnlscreensaver_click()
					vBln94 = True
					v_datalastbackup = mod1.Sub058
					StartFTP()
				End If
			End If
		End If
	End If
	If vcustomlistviewold3.Sub008 = 0 And vStr6 = "" Then
		If DateTime.GetMinute(mod1.Sub058) Mod 2 = 0 Then
			Sub076()
		End If
	End If
	If Not(vccefdll1.vBln15) And vBln11 Then
		If DateTime.GetMinute(mod1.Sub058) = 0 Then
			If DateTime.GetHour(mod1.Sub058) Mod 3 = 0 And Not(vBln8) Then
				vccefdll1.rt_leggistato(False)
			End If
		End If
	End If
	If Not(vBln94) And v_minutiss > 0 And vInt55 = v_minutiss Then
		PnlScreenSaver.SetVisibleAnimated(300, True)
		mod1.Sub161(PnlScreenSaver, 10)
		vTmr8.Enabled = True
		If v_matricola.StartsWith("ST") Then
			Dim phone As Phone = vPhone1
			Phone.SetScreenBrightness(0.4)
		Else
			Dim phone2 As Phone = vPhone1
			Phone.SetScreenBrightness(0.01)
		End If
	End If
	If v_asportoora And v_asportoanticipo > 0 And vBln11 And Not(vBln25) Then
		Dim vTmp As Long = mod1.Sub058
		Dim sb As String = "'" & NumberFormat(DateTime.GetMonth(vTmp), 2, 0) & "/" & NumberFormat(DateTime.GetDayOfMonth(vTmp), 2, 0) & "/" & DateTime.GetYear(vTmp) & " " & NumberFormat(DateTime.GetHour(vTmp), 2, 0) & ":" & NumberFormat(DateTime.GetMinute(vTmp), 2, 0) & ":00'"
		Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select nmov,memo,datam2 from headmov where tavolo =0 and NoStampaAsporto=0 and sospeso =1 and datam2 > " & sb)
		If cursorWrapper.RowCount > 0 Then
			Dim rowCount As Int = cursorWrapper.RowCount - 1
			Dim i2 As Int
			For i2 = 0 To rowCount
				cursorWrapper.Position = i2
				Dim substring As String = cursorWrapper.GetString("datam2").SubString(11)
				Dim vGetYear As Int = DateTime.GetYear(mod1.Sub058)
				Dim vGetMonth As Int = DateTime.GetMonth(mod1.Sub058)
				Dim vGetDayOfMonth As Int = DateTime.GetDayOfMonth(mod1.Sub058)
				Dim vTmp_ As Int = modfunstr.Sub006(substring.SubString2(0, 2))
				Dim setdateandtime As Long = DateUtils.setdateandtime(vGetYear, vGetMonth, vGetDayOfMonth, vTmp_, modfunstr.Sub006(substring.SubString2(3, 5)), 0)
				Dim vTmp__ As Double = setdateandtime - mod1.Sub058
				If vTmp__ / 60000 < v_asportoanticipo Then
					Sub163(cursorWrapper.GetString("memo"), cursorWrapper.GetString("nmov"), True, False, False, False, False, True)
					Starter.v7.Interval = 200
				End If
			Next
		End If
		cursorWrapper.Close
	End If
	If vBln25 Then
		stampascontrinodaserver()
	Else
		stampascontrinoauto()
	End If
	If v_matricola.StartsWith("ST") And vccefdll1.vBln15 And vccefdll1.vInt8 > 105 Then
		Sub259(vImg12, True)
	End If
	mod1.Sub081
End Sub

