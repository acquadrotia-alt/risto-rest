Sub gettotem_transaction(map As Map) As Map
	Dim map2 As Map
	Dim exc As Exception
	Try
		Dim map3 As Map
		Try
			map3.Initialize
			vStr30 = ""
			If map.Size > 0 Then
				vSql1.ExecNonQuery("delete from Ventmp")
				Dim vObjectToNumber As Int = map.GetDefault("TotRows", 0)
				If vObjectToNumber = 0 Then
					vStr30 = "Errore lettura numero di righe dal totem"
					mod1.Sub217("Errore Totem:Numero di righe")
					Return map3
				End If
				Dim i As Int = vObjectToNumber - 1
				Dim i2 As Int = 0
				Do While True
					If i2 > i Then
						Exit
					End If
					Dim vObjectToString As String = map.GetDefault("Code_" & i2, "")
					If vObjectToString = "" Then
						vStr30 = "Errore struttura dati ricevuti dal totem"
						mod1.Sub217("Errore Totem:Ricevuto un codint vuoto")
						Exit
					End If
					Dim vObjectToNumber2 As Int = map.GetDefault("Qty_" & i2, 0)
					If vObjectToNumber2 <> 0 Then
						vDbl19 = vObjectToNumber2
						addRowPlu(vObjectToString, False, False, "", False, "")
					End If
					i2 = i2 + 1
				Loop
				If v_attivamp Then
					Sub115()
				End If
				Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select codint,qta,prezzov,importo from Ventmp order by chiave")
				If cursorWrapper.RowCount = vObjectToNumber Then
					Dim rowCount As Int = cursorWrapper.RowCount - 1
					Dim i3 As Int
					For i3 = 0 To rowCount
						cursorWrapper.Position = i3
						map3.Put("Code_" & i3, cursorWrapper.GetString("codint"))
						map3.Put("Qty_" & i3, cursorWrapper.GetString("qta"))
						map3.Put("Amount_" & i3, cursorWrapper.GetString("importo"))
					Next
				End If
				cursorWrapper.Close
			Else
				vStr30 = "Errore trasferimento dati"
