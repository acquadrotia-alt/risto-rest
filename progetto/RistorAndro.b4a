		Dim sb2 As String = "set inmodifica = 1 ,timelast='" & mod1.Sub057(DateTime.Date(mod1.Sub058) & " " & DateTime.Time(mod1.Sub058)) & "'"
		If vCur24.GetInt("inmodifica") = 1 Then
			Msgbox2("Il tavolo risulta essere in modifica da un altro utente", vStr8, "OK", "", "", vBmp1)
			vBln19 = False
			ProgressDialogHide
			Return
