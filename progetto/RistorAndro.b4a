Sub EdtRicerca_TextChanged(str As String, str2 As String)
	Dim trim As String
	Try
		trim = str2.Trim
	Catch
		mod1.Sub217(LastException.Message)
	End Try
	If trim = "" Then
		vInt82 = -1
		vUltimateListView1.RefreshContent
		Return
	End If
	Dim cursorWrapper As Cursor
	Dim cursorWrapper2 As Cursor = vSql3.ExecQuery("SELECT rowid as RD FROM sortedRecall WHERE " & vStr62 & " LIKE '%" & trim & "%' " & vStr61)
	If cursorWrapper2.RowCount > 0 Then
		cursorWrapper2.Position = 0
		Dim longValue As Long = cursorWrapper2.GetLong("RD") - 1
		If longValue >= 0 Then
			vInt82 = vUltimateListView1.GetPositionForID(longValue, False)
		Else
			vInt82 = -1
		End If
	Else
		vInt82 = -1
	End If
	cursorWrapper2.Close
	vUltimateListView1.RefreshContent
	If vInt82 > -1 Then
		vUltimateListView1.PlaceItemFromTop(vInt82, DipToCurrent(10))
	End If
End Sub

