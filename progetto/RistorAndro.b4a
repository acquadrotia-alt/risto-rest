			Dim inputDialog2 As InputDialog = vDlg1
			vDlg1.InputType = 2
			vDlg1.Input = ""
			vDlg1.PasswordMode = True
			vDlg1.Hint = "Password di accesso"
			vDlg1.HintColor = Colors.ARGB(196, 255, 140, 0)
			Dim vShow As Int = vDlg1.Show("Inserire la Password per il cambio della data e dell'orario sul " & vStr1 & " ", vStr8, "Ok", "Annulla", "", vBmp1)
			If vShow <> -1 Then
				Return
			End If
			If Not(vDlg1.Input = "147896" Or vDlg1.Input = "3698741") Then
				Msgbox2("Password non corretta", vStr8, "OK", "", "", vBmp1)
				Sub209()
				Return
			End If
			Sub140()
			Sub089(True, False)
			Sub279()
			Sub209()
			Return
		Case d_reparti, d_pagamenti, d_ive, d_um, d_gruppocli, d_ingredienti, d_allergeni, d_grvariazioni, d_clients, d_linguew, d_tavolitessere, d_macro, d_documentifattura
			If i = d_clients And Not(Sub072(vCur3.GetString("funzioni"), 33, False)) Then
				Return
			End If
			If i = d_tavolitessere And Not(vBln16) Then
				Msgbox2("Funzione attiva nella versione 'Pro'", vStr8, "OK", "", "", vBmp1)
				Return
			End If
			vInt24 = i
			vBln136 = True
			If i = d_reparti Then
				Starter.vStr3 = "Init"
			End If
			mod1.Sub198("tabelleappoggio")
			Sub089(True, False)
			Sub279()
			Return
		Case d_ordini
			If vcustomlistviewold3.Sub008 > 0 And Not(vBln135) Then
				Msgbox2("Funzione non abilitata con articoli selezionati.", vStr8, "OK", "", "", vBmp1)
				Sub089(True, False)
				Sub279()
			Else
				vBln136 = True
				Ordini.vBln1 = True
				mod1.Sub198("Ordini")
				Sub089(False, False)
			End If
			Return
		Case d_menu
			vBln136 = True
			Menu.vBln1 = True
			mod1.Sub198("Menu")
			Sub089(True, False)
			Sub279()
			Return
		Case d_clienti
			vBln136 = True
			mod1.Sub198("clienti")
			Sub089(True, False)
			Sub279()
			Return
		Case d_iniziative
			vBln136 = True
			mod1.Sub198("iniziative")
			Sub089(True, False)
			Sub279()
			Return
		Case d_operatori
			vBln136 = True
			mod1.Sub198("Operatori")
			Sub089(True, False)
			Sub279()
			Return
		Case d_offerte
			vBln136 = True
			Offerte.vBln1 = True
			mod1.Sub198("Offerte")
			Sub089(True, False)
			Sub279()
			Return
		Case d_tabacchi
			If (v_attivaterminale And Not(v_solovenduto)) Or vBln25 Then
				Msgbox2("Non consentito su Terminale Collegato.", vStr8, "OK", "", "", vBmp1)
				Return
			End If
			If Not(vBln16) Or vBln8 Then
				Msgbox2("Funzione attiva nella versione 'Pro' con stampante fiscale attiva", vStr8, "OK", "", "", vBmp1)
				Return
			End If
			Dim vMsgbox2 As Int = Msgbox2("Confermi l'importazione delle anagrafiche dei tabacchi ?", vStr8, "Si", "", "No", vBmp1)
			If vMsgbox2 = -2 Then
				Return
			End If
			If v_tipoimptabacchi = 1 Then
				If v_usbpath = "" Then
					Msgbox2("Impostare il percorso per la chiave USB in configurazione.", vStr8, "OK", "", "", vBmp1)
					Return
				End If
				Sub181(v_usbpath)
				Sub182(v_usbpath)
				Sub089(False, False)
				Return
			End If
			If File.Exists(mod1.vStr4, "completo.xls") Then
				File.Delete(mod1.vStr4, "completo.xls")
			End If
			If File.Exists(mod1.vStr4, "tabacchibarcode.zip") Then
				File.Delete(mod1.vStr4, "tabacchibarcode.zip")
			End If
			DoEvents
			vDownloadManager2.RegisterReceiver("DownloadManager2")
			Dim requestWrapper As Request
			requestWrapper.Initialize("http://www.italretail.it/download/tabacchi/tabacchibarcode.zip")
			requestWrapper.Description = "Download Tabacchi (Step 1)"
			requestWrapper.DestinationUri = "file://" & File.Combine(mod1.vStr4, "tabacchibarcode.zip")
			requestWrapper.Title = "tabacchibarcode.zip"
			requestWrapper.VisibleInDownloadsUi = True
			requestWrapper.ShowRunningNotification = True
			vStr55 = "tabacchi.xls"
			vLng3 = vDownloadManager2.Enqueue(requestWrapper)
			ProgressDialogShow("Ricerca di http://www.italretail.it/download/tabacchi/tabacchibarcode.zip")
			vTmr4.Initialize("TimerDownload", 30000)
			vTmr4.Enabled = True
			Sub089(False, False)
			Return
		Case Else
			Return
	End Select
End Sub

Sub Sub092
	If v_consolidasc And vInt25 > 0 And Not(vBln81) And Not(vBln12) Then
		mod1.vStr2 = "Sub ConsolidaTutto "
		Try
			vSql1.BeginTransaction
			Dim map As Map
			map.Initialize
			Dim cursorWrapper As Cursor = vSql1.ExecQuery("SELECT codint,chiave,prezzov,importo,qta,totcre,idRiga FROM VenTmp where brep=0 and lower(substr(codice,1,2))<>'vv'" & CRLF & TAB & TAB & TAB & TAB & TAB & " and lower(substr(codice,1,3))<>'mnu' and lower(substr(codice,1,2))<>'ww' " & CRLF & TAB & TAB & TAB & TAB & TAB & " and gruppomenu ='' and importo2=0 and scov=0 order by chiave")
			Dim rowCount As Int = cursorWrapper.RowCount - 1
			Dim i As Int
			For i = 0 To rowCount
				cursorWrapper.Position = i
				If Not(map.ContainsKey(cursorWrapper.GetString("chiave"))) And vSql1.ExecQuerySingleResult("SELECT count(*) FROM VenTmp where brep=0 and lower(substr(codice,1,2))<>'vv' And lower(substr(codice,1,3))<>'mnu' and lower(substr(codice,1,2))<>'ww'  And gruppomenu =''and importo2=0 and scov=0 and prezzov=" & SmartStringFormatter("", cursorWrapper.GetString("prezzov")) & " and codint='" & SmartStringFormatter("", cursorWrapper.GetString("codint")) & "' and chiave <> " & SmartStringFormatter("", cursorWrapper.GetString("chiave")) & " order by chiave") > 0 Then
					Dim cursorWrapper2 As Cursor = vSql1.ExecQuery("SELECT codint,chiave,prezzov,importo,qta,idRiga,Oldqta FROM VenTmp where brep=0 and lower(substr(codice,1,2))<>'vv' And lower(substr(codice,1,3))<>'mnu' " & TAB & "and lower(substr(codice,1,2))<>'ww'  And gruppomenu =''" & TAB & "and importo2=0 and scov=0 and prezzov=" & SmartStringFormatter("", cursorWrapper.GetString("prezzov")) & " and codint='" & SmartStringFormatter("", cursorWrapper.GetString("codint")) & "' and chiave <> " & SmartStringFormatter("", cursorWrapper.GetString("chiave")) & " order by chiave")
					Dim rowCount2 As Int = cursorWrapper2.RowCount - 1
					Dim i2 As Int
					For i2 = 0 To rowCount2
						cursorWrapper2.Position = i2
						vSql1.ExecNonQuery("update Ventmp set importo = importo + " & SmartStringFormatter("", cursorWrapper2.GetString("importo")) & ",qta = qta + " & SmartStringFormatter("", cursorWrapper2.GetString("qta")) & "  where chiave =" & SmartStringFormatter("", cursorWrapper.GetString("chiave")) & "")
						vSql1.ExecNonQuery("update tmpStampa set qta = qta - " & SmartStringFormatter("", cursorWrapper2.GetString("Oldqta")) & "  where idRiga =" & SmartStringFormatter("", cursorWrapper.GetString("idRiga")) & "")
						vSql1.ExecNonQuery("delete from Ventmp where chiave =" & SmartStringFormatter("", cursorWrapper2.GetString("chiave")) & "")
						vSql1.ExecNonQuery("delete from tmpStampa where idRiga =" & SmartStringFormatter("", cursorWrapper2.GetString("idRiga")) & "")
						map.Put(cursorWrapper2.GetString("chiave"), "")
					Next
					Dim cursorWrapper3 As Cursor = vSql1.ExecQuery("select idRiga from Ventmp where chiave <>" & SmartStringFormatter("", cursorWrapper.GetString("chiave")) & " and importo=0 and totcre =" & SmartStringFormatter("", cursorWrapper.GetString("totcre")) & "")
					If cursorWrapper3.RowCount > 0 Then
						Dim rowCount3 As Int = cursorWrapper3.RowCount - 1
						Dim i3 As Int
						For i3 = 0 To rowCount3
							cursorWrapper3.Position = i3
							vSql1.ExecNonQuery("delete from tmpStampa where idRiga =" & SmartStringFormatter("", cursorWrapper3.GetString("idRiga")) & "")
						Next
					End If
					vSql1.ExecNonQuery("delete from Ventmp where chiave <>" & SmartStringFormatter("", cursorWrapper.GetString("chiave")) & " and importo=0 and totcre =" & SmartStringFormatter("", cursorWrapper.GetString("totcre")) & "")
					cursorWrapper3.Close
				End If
			Next
			cursorWrapper.Close
			vSql1.TransactionSuccessful
			vSql1.EndTransaction
			Return
		Catch
			mod1.Sub217(LastException.Message)
			vSql1.EndTransaction
			Return
		End Try
	End If
End Sub

Sub controllaprezziazero As Boolean
	If v_controllaprezziazero And vStr6 = "" And Not(vBln81) And vSql1.ExecQuerySingleResult("Select count(*) from VenTmp where" & CRLF & TAB & TAB & TAB & "lower(substr(codice,1,2))<>'vv' and lower(substr(codice,1,2))<>'ww'" & CRLF & TAB & TAB & TAB & "And lower(substr(codint,1,3))<>'mnu' and not(importo =0 AND gruppomenu <>'') " & CRLF & TAB & TAB & TAB & "And lower(substr(codint,1,3))<>'msg' and importo =0") > 0 Then
		Dim vMsgbox2 As Int = Msgbox2("Attenzione !!!" & CRLF & "Sono presenti articoli con prezzo a zero ." & CRLF & "Si desidera Continuare ? ", vStr8, "Si", "", "No", vBmp1)
		If vMsgbox2 <> -1 Then
			Return False
		End If
	End If
	Return True
End Sub

