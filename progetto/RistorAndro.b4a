Sub acrowmenu_itemclicked(menuItemWrapper As MenuItem)
	mod1.vStr2 = " Sub ACRow_Click (Position As Int, ActionItemID As Int)"
	Try
		Select menuItemWrapper.Id
			Case 0
				vDbl19 = 1
				lblDisplay.Text = ""
				vStr44 = vCur16.GetInt("gruppomenu")
				addRowsMenu(IIf(IsNumber(vCur16.GetString("codint").Replace("mnu", "")), vCur16.GetString("codint").Replace("mnu", ""), 0), vCur16.GetInt("qta"), vCur16.GetString("chiave"), vCur16.GetInt("QtaConDecimali"))
			Case 1
				Dim parseDouble As Int = IIf(IsNumber(vCur16.GetString("codint").Replace("mnu", "")), vCur16.GetString("codint").Replace("mnu", ""), 0)
				Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select indice,codint from dettmnu where  mnuattivo=1 and  auto = 0 and codmnu =" & parseDouble & "  order by indice ,desreparto")
				Dim map As Map
				map.Initialize
				If cursorWrapper.RowCount > 0 Then
					Dim rowCount As Int = cursorWrapper.RowCount - 1
					Dim i As Int
					For i = 0 To rowCount
						cursorWrapper.Position = i
						map.Put(cursorWrapper.GetInt("indice"), vSql1.ExecQuerySingleResult("Select case when sum(qta) is null then 0 else sum(qta) end from Ventmp where chiave <> " & SmartStringFormatter("", vCur16.GetString("chiave")) & " and codint ='" & SmartStringFormatter("", cursorWrapper.GetString("codint")) & "' and gruppomenu = '" & SmartStringFormatter("", vCur16.GetString("gruppomenu")) & "' ") + map.GetDefault(cursorWrapper.GetInt("indice"), 0))
					Next
				End If
				cursorWrapper.Close
				Dim size As Int = map.Size - 1
				Dim i2 As Int = -1000
				Dim i3 As Int
				For i3 = 0 To size
					If i2 < map.GetValueAt(i3) And map.GetValueAt(i3) > 0 Then
						i2 = map.GetValueAt(i3)
					End If
				Next
				CallSubDelayed2(Me, "fCambiaQta", IIf(i2 <> -1000, i2, 0))
			Case 2
				Dim cursorWrapper2 As Cursor = vSql1.ExecQuery("select totcre from Ventmp where gruppomenu ='" & vCur16.GetString("gruppomenu") & "'")
				If cursorWrapper2.RowCount > 0 Then
					Dim rowCount2 As Int = cursorWrapper2.RowCount - 1
					Do While r1 <= rowCount2
						cursorWrapper2.Position = r1
						vSql1.ExecNonQuery("delete from Ventmp where  totcre ='" & cursorWrapper2.GetString("totcre") & "'")
						r1 = r1 + 1
					Loop
				End If
				cursorWrapper2.Close
				refilltablelist(True)
		End Select
		Return
	Catch
		mod1.Sub217(LastException.Message)
		Return
	End Try
End Sub

