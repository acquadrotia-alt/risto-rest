		Dim vMsgbox2 As Int = Msgbox2("Attenzione ... sono stati inseriti dei resi che non possono essere inseriti in un Documento commerciale di Reso (non hanno il riferimento del DCV)" & CRLF & "Se si prosegue tali righe verranno eliminate.", vStr8, "Prosegui", "", "Annulla", vBmp1)
