Sub showinfocli(str As String)
	Try
		If str <> "" Then
			Dim list As List
			list.Initialize
			Dim vSplit() As String = Regex.Split(CRLF, str)
			If vSplit.Length > 2 Then
				Dim str2 As String = vSplit(0)
				Dim length As Int = vSplit.Length - 1
				Dim i As Int
				For i = 1 To length
					list.Add(vSplit(i))
				Next
				idLib.InputList1(list, str2)
			End If
		End If
		Sub207()
		Return
	Catch
		mod1.Sub217(LastException.Message)
		Sub207()
