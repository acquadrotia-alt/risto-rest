'### RISTRUTTURARE: Resumable Sub convertita come macchina a stati (comportamento identico all'originale).
Sub escidaprogrammaattendi
	Dim x As Int
	Dim limit1 As Int
	Dim step1 As Int
	Dim rsState As Int = 0
	Do While True
		Select rsState
			Case -1
				Return
			Case 0
				rsState = 1
				Continue
			Case 1
				rsState = 4
				step1 = -1
				limit1 = 0
				x = 15
				rsState = 5
				Continue
			Case 3
				rsState = 6
				ProgressDialogShow("Mancano " & SmartStringFormatter("", x) & " secondi alla chiusura automatica del programma")
				Sleep(1000)
				rsState = 7
				Continue
			Case 4
				rsState = -1
				vBln110 = True
				activity_keypress(4)
				Continue
			Case 5
				rsState = 4
				If (step1 > 0 And x <= limit1) Or (step1 < 0 And x >= limit1) Then
					rsState = 3
					Continue
				End If
				Continue
			Case 6
				rsState = 5
				x = x + 0 + step1
				Continue
			Case 7
				rsState = 6
				Continue
		End Select
	Loop
End Sub

