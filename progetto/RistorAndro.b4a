Sub Sub134(str As String, list As List, str2 As String) As Boolean
	Dim cursorWrapper As Cursor
	Dim cursorWrapper2 As Cursor
	Dim vReadMap As Map = File.ReadMap(str2, str)
	Dim vObjectToString As String = vReadMap.GetDefault("DescrizioneStampa", "")
	Dim vObjectToString2 As String = vReadMap.GetDefault("Query", "")
	Dim vObjectToString3 As String = vReadMap.GetDefault("TipoStampa", "")
	Dim vObjectToBoolean As Boolean = vReadMap.GetDefault("Mail", False)
	Dim vObjectToBoolean2 As Boolean = vReadMap.GetDefault("Stampa", False)
	Dim vObjectToBoolean3 As Boolean = vReadMap.GetDefault("Copia", False)
	If str.ToLowerCase.StartsWith("lp") And vObjectToString3.StartsWith("PROC_") Then
		If File.Exists(File.DirRootExternal, "Result.txt") Then
			File.Delete(File.DirRootExternal, "Result.txt")
		End If
		Dim packageManagerWrapper As PackageManager
		Dim vGetApplicationIntent As Intent = packageManagerWrapper.GetApplicationIntent("italretail.gestorestampe")
		vGetApplicationIntent.PutExtra("PROC", vObjectToString3.Replace("PROC_", ""))
		Dim i As Int
		For i = 1 To 5
			vGetApplicationIntent.PutExtra("Parametro" & i, vReadMap.GetDefault("Parametro" & i, ""))
		Next
		vBln102 = True
		StartActivity(vGetApplicationIntent)
	End If
	Dim map As Map
	map.Initialize
	map.Put("TestataCampo1", vReadMap.GetDefault("TestataCampo1", ""))
	map.Put("TestataCampo2", vReadMap.GetDefault("TestataCampo2", ""))
	map.Put("TestataCampo3", vReadMap.GetDefault("TestataCampo3", ""))
	map.Put("TestataCampo4", vReadMap.GetDefault("TestataCampo4", ""))
	map.Put("TestataCampo5", vReadMap.GetDefault("TestataCampo5", ""))
	map.Put("StampaHeader", vReadMap.GetDefault("StampaHeader", True))
	map.Put("StampaFiltro", vReadMap.GetDefault("StampaFiltro", True))
	map.Put("StampaTotali", vReadMap.GetDefault("StampaTotali", True))
	If vObjectToString2 = "" Or vObjectToString3 = "" Then
		Return False
	End If
	vSql1.ExecNonQuery("attach database '" & File.DirDefaultExternal & "/venduto.db' as VendutoDB")
	Try
		Dim cursorWrapper3 As Cursor
		Dim replace As String = vObjectToString2.Replace("%opattivo%", Operatore).Replace("%numcassa%", v_numcassa)
		Dim cursorWrapper4 As Cursor = vSql1.ExecQuery(replace.Replace("%cliente%", vStr28).Replace("%tavolo%", vInt25))
		Dim str3 As String = IIf(vObjectToBoolean, "M", "") & IIf(vObjectToBoolean3, "C", "")
		Dim str4 As String = IIf(vObjectToString3 = "I", "I2", vObjectToString3)
		If str4 = "I2" Then
			If vCur4.IsInitialized Then
				vCur4.Close
			End If
			vCur4 = vSql1.ExecQuery("SELECT * FROM iva order by codice")
			cursorWrapper = vCur4
			cursorWrapper2 = cursorWrapper4
		Else If str4 = "P" Then
			If vCur8.IsInitialized Then
				vCur8.Close
			End If
			vCur8 = vSql1.ExecQuery("SELECT * FROM pagamenti order by codice")
			cursorWrapper = vCur8
			cursorWrapper2 = cursorWrapper4
		Else If str4 = "RG" Or str4 = "R" Then
			cursorWrapper = vSql1.ExecQuery("SELECT codice,descrizione FROM reparti order by codice")
			cursorWrapper2 = cursorWrapper4
		Else If str4 = "F" Then
			If vBln24 Then
				mod1.Sub085(vSql1, " headmov.sospeso =0 ")
			Else
				mod1.Sub084(vSql1, "", False)
			End If
			Try
				Dim cursorWrapper5 As Cursor
				Dim replace2 As String = vObjectToString2.Replace("%opattivo%", Operatore).Replace("%numcassa%", v_numcassa)
				Dim cursorWrapper6 As Cursor = vSql1.ExecQuery(replace2.Replace("%cliente%", vStr28).Replace("%tavolo%", vInt25))
				cursorWrapper = cursorWrapper4
				cursorWrapper2 = cursorWrapper6
			Catch
				Msgbox2("Errore nella query all'interno del file " & str, vStr8, "OK", "", "", vBmp1)
				vSql1.ExecNonQuery("DETACH DATABASE 'VendutoDB'")
				Return False
			End Try
		Else
			cursorWrapper = cursorWrapper4
			cursorWrapper2 = cursorWrapper4
		End If
		If cursorWrapper2.RowCount > 0 Then
			If vObjectToBoolean2 Then
				mod1.stampa(str4, list, cursorWrapper2, cursorWrapper, vObjectToString, map)
			End If
			If str3 <> "" Then
				mod1.mail(True, str4, list, cursorWrapper2, cursorWrapper, False, vObjectToString, vSMTP1, vPDFWriter1, str3)
			End If
		Else If str2.EndsWith("ReportPersonalizzati") Then
			Msgbox2("Nessun dato per la stampa richiesta.", vStr8, "OK", "", "", vBmp1)
		End If
		cursorWrapper2.Close
		vSql1.ExecNonQuery("DETACH DATABASE 'VendutoDB'")
		Return True
	Catch
		Msgbox2("Errore nella query all'interno del file " & str, vStr8, "OK", "", "", vBmp1)
		vSql1.ExecNonQuery("DETACH DATABASE 'VendutoDB'")
		Return False
	End Try
End Sub

