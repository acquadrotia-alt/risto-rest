							If vCur14.GetInt("colonna") <> vInt13 - 1 Or vCur14.GetInt("riga") <> 0 Or vBtn1(vCur14.GetInt("riga"), vCur14.GetInt("colonna") - 1).Width <= vInt23 + 5 Then
