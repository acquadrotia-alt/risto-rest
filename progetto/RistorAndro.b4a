		Else If vCur16.GetDouble("scop") < 0 Then
			labelWrapper.Text = str & CRLF & "(Maggiorazione " & NumberFormat2(Abs(vCur16.GetDouble("scov")), 1, 2, 2, False) & ")"
			Dim vRGB2 As Int = Colors.RGB(255, 205, 133)
			labelWrapper.Background = mod1.Sub158(vRGB2, -1)
		Else If vCur16.GetDouble("qta") < 0 Then
			labelWrapper.Text = str
			Dim vRGB3 As Int = Colors.RGB(255, 163, 170)
			labelWrapper.Background = mod1.Sub158(vRGB3, -1)
		Else
			labelWrapper.Text = str
			Dim vRGB4 As Int = Colors.RGB(222, 222, 222)
			labelWrapper.Background = mod1.Sub158(vRGB4, -1)
			If vCur16.GetString("codice").StartsWith("vv") Then
				Dim vRGB5 As Int = Colors.RGB(180, 122, 222)
				labelWrapper.Background = mod1.Sub158(vRGB5, -1)
			End If
		End If
		labelWrapper.TextColor = -16777216
		If vCur16.GetInt("flgmag") = 1 And vCur16.GetInt("flgusointerno") = 0 Then
			If Not(v_attivaterminale And vBln20) Then
