	End If
	Dim rowsCount As Int = vGetSheet.RowsCount - 1
	Dim i As Int
	For i = 0 To rowsCount
		If i > 2 Then
			Dim strArr(vGetSheet.ColumnsCount) As String
			Dim length As Int = strArr.Length - 1
			Dim i2 As Int
			For i2 = 0 To length
				strArr(i2) = vGetSheet.GetCellValue(i2, i)
			Next
			If strArr(1).Trim <> "" And IsNumber(strArr(1).Trim) Then
				Dim d As Double = 0
				If IsNumber(strArr(4).Trim.Replace(".", "").Replace(",", "")) Then
					d = strArr(4).Trim.Replace(".", "").Replace(",", "")
				End If
				Dim vRound2 As Double = Round2(d / 100, 2)
				Dim vRound22 As Double = IIf(v_marginetabacchi > 0, Round2((100 - v_marginetabacchi) / 100 * vRound2, 2), vRound2)
				Dim vTmp As String = mod1.Sub209(strArr(2).Trim)
				If strArr(5).ToLowerCase.Contains("astuccio") Then
					vTmp = vTmp & " (astuccio)"
				Else If strArr(5).ToLowerCase.Contains("cartoccio") Then
					vTmp = vTmp & " (cartoccio)"
				End If
				Dim sb As String = "98" & modfunstr.Sub003("00000" & strArr(1).Trim, 5)
				Dim d2 As Double = 0
				If IsNumber(strArr(3).Trim.Replace(".", "").Replace(",", "")) Then
					Dim vRound23 As Double = Round2(strArr(3).Trim.Replace(".", "").Replace(",", "") / 100, 2)
					If vRound23 <> 0 And vRound2 <> 0 Then
						d2 = Round2(1000 * vRound2 / vRound23, 0)
					End If
				End If
				If vSql1.ExecQuerySingleResult("Select count(*) from anagra where codint = '" & sb & "'") = 0 Then
					map.Initialize
					list.Initialize
					map.Put("codint", sb)
					map.Put("descrizione", vTmp)
					map.Put("reparto", 0)
					map.Put("iva", 3)
					map.Put("plupeso", 0)
					map.Put("list1", vRound2)
					map.Put("list2", vRound2)
					map.Put("list5", vRound22)
					map.Put("peso", d2)
					list.Add(map)
					dbutil.Sub011(vSql1, "anagra", list)
				Else
					vSql1.ExecNonQuery("Update anagra set peso=" & d2 & ", descrizione='" & vTmp & "', list1 = " & vRound2 & ",list2 = " & vRound2 & ",list5 = " & vRound22 & " where codint ='" & sb & "'")
					vSql1.ExecNonQuery("update ean set importo = round(" & vRound2 & "* qta+0.000000001,2)  where  codint = '" & sb & "' and qta >1")
				End If
				If i Mod 40 = 0 Then
					vCustomProgressDialog1._showprogress("Importazione Articoli in corso (Step 2)", -1, i * 100 / vGetSheet.RowsCount)
					DoEvents
				End If
			End If
		End If
	Next
	vCustomProgressDialog1._hide
	Dim vMsgbox2 As Int = Msgbox2("Confermi l'aggiornamento dei codici a barre ?", vStr8, "Si", "", "No", vBmp1)
