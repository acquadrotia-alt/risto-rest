Sub uniscitavolo(i As Int)
	Dim i2 As Int
	If i = 0 Then
		Dim str As String = "Inserire il numero del tavolo da unire (da 1 a " & vInt64 & ")"
		If vInt78 >= 20000 Then
			str = "Inserire il numero della tessera da unire (da 20000 a " & v_numerott + 20000 & ")"
		End If
		i2 = Sub050(str, False)
	Else
		i2 = i
	End If
	If i2 = 0 Then
		vBln108 = False
		mod1.Sub081
		Return
	End If
	If vSql1.ExecQuerySingleResult("Select count(*) from tavoli where tavolo = " & i2 & " and manuallock=1 ") > 0 Then
		Msgbox2("Non è consentito unire ad un tavolo che non viene azzerato in chiusura", vStr8, "OK", "", "", vBmp1)
		vBln108 = False
		mod1.Sub081
		Return
	End If
	If i2 = vInt78 Then
		Msgbox2("Il tavolo di origine corrisponde a quello di destinazione", vStr8, "OK", "", "", vBmp1)
		vBln108 = False
		mod1.Sub081
		Return
	End If
	If vInt78 < 20000 Then
		If PnlRicercaT.Visible Then
			Dim parseDouble As Int = IIf(vSql1.ExecQuerySingleResult("select count(*) from pagine where valore = " & vInt78 & " AND tipo = 9") > 0, vSql1.ExecQuerySingleResult("select max(pagina) from pagine where valore = " & vInt78 & " AND tipo = 9"), 0)
			If parseDouble = 0 Or vSql1.ExecQuerySingleResult("select count(*) from pagine where pagina =" & parseDouble & " AND valore = " & i2 & " AND tipo = 9") = 0 Then
				Msgbox2("Il tavolo " & i2 & " non esiste in questa sala.", vStr8, "OK", "", "", vBmp1)
				vBln108 = False
				mod1.Sub081
				Return
			End If
		Else If vSql1.ExecQuerySingleResult("select count(*) from pagine where pagina =" & vInt30 & " AND valore = " & i2 & " AND tipo = 9") = 0 Then
			Msgbox2("Il tavolo " & i2 & " non esiste in questa sala.", vStr8, "OK", "", "", vBmp1)
			vBln108 = False
			mod1.Sub081
			Return
		End If
	End If
	If vBln25 And i = 0 Then
		CallSub3(httpclient, "UnisciTavoloDaClient", vInt78, i2)
		vBln108 = False
		mod1.Sub081
		ProgressDialogShow2("Attendere la risposta del Server ...", False)
		Return
	End If
	If vSql1.ExecQuerySingleResult("Select count(*) from tavoli where tavolo = " & vInt78 & " and inmodifica =0 and lock=0 ") = 0 Then
		Msgbox2(IIf(vInt78 >= 20000, "tessera non disponibile", "tavolo non disponibile"), vStr8, "OK", "", "", vBmp1)
		vBln108 = False
		mod1.Sub081
		Return
	End If
	If vSql1.ExecQuerySingleResult("Select count(*) from tavoli where tavolo = " & i2 & " and unlocktable=0 ") = 0 Then
		Dim str2 As String = "Questo tavolo non può essere unito al tavolo " & i2
		If vInt78 >= 20000 Then
			str2 = "Questa tessera non può essere unita alla tessera " & i2
		End If
		Msgbox2(str2, vStr8, "OK", "", "", vBmp1)
		vBln108 = False
		mod1.Sub081
		Return
	End If
	Dim parseDouble2 As Int = vSql1.ExecQuerySingleResult("Select unlocktable from  tavoli where tavolo = " & vInt78)
	If parseDouble2 > 0 And parseDouble2 <> i2 Then
		Dim str3 As String = "Risulta già essere unito al tavolo " & parseDouble2
		If vInt78 >= 20000 Then
			str3 = "Risulta già essere unita alla tessera " & parseDouble2
		End If
		Msgbox2(str3, vStr8, "OK", "", "", vBmp1)
		vBln108 = False
		mod1.Sub081
		Return
	End If
	Dim parseDouble3 As Long = vSql1.ExecQuerySingleResult("select rifheadmov from tavoli where tavolo = " & i2)
	Dim parseDouble4 As Long = vSql1.ExecQuerySingleResult("select rifheadmov from tavoli where tavolo = " & vInt78)
	If parseDouble3 > 0 And parseDouble4 > 0 Then
		Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select qtacondecimali,totcre,chiave from venduto where nmov = " & parseDouble3)
		If cursorWrapper.RowCount > 0 Then
			Dim j As Long = vInt78 * 10000
			Dim rowCount As Int = cursorWrapper.RowCount - 1
			Dim i3 As Int
			For i3 = 0 To rowCount
				cursorWrapper.Position = i3
				Try
					Dim vGetInt As Int = cursorWrapper.GetInt("totcre") + j
					vSql1.ExecNonQuery("update venduto set qtacondecimali= " & vGetInt & ",totcre='" & vGetInt & "' where chiave=" & cursorWrapper.GetLong("chiave"))
				Catch
					mod1.Sub217(LastException.Message)
				End Try
			Next
		End If
		cursorWrapper.Close
		If Not(vBln25 And i > 0) Then
			vSql1.ExecNonQuery("update venduto set nmov =  " & parseDouble3 & " where nmov = " & parseDouble4)
			vSql1.ExecNonQuery("update tavoli set importo = " & vSql1.ExecQuerySingleResult("select sum(importo) from venduto where nmov = " & parseDouble3) & " where tavolo = " & i2)
			vSql1.ExecNonQuery("delete from headmov where nmov = " & parseDouble4)
		End If
	Else If parseDouble3 = 0 And parseDouble4 > 0 Then
		Dim vExecQuerySingleResult As String = vSql1.ExecQuerySingleResult("Select case when sum(qta) is null then 0 else sum(qta) end as tot from venduto where (codint ='888888' or codint ='888889') and nmov = " & parseDouble4)
		vSql1.ExecNonQuery("update tavoli set rifheadmov=" & parseDouble4 & ",coperti=" & vExecQuerySingleResult & ",addturni= " & mod1.Sub005(parseDouble4) & " where tavolo = " & i2)
	End If
	vSql1.ExecNonQuery("update tavoli set tPWD=random(),unlocktable=" & i2 & " ,uscita=0,lock=1,rifheadmov=0,coperti=0,addturni=0,importo=0 where tavolo = " & vInt78)
	If v_stampasposta And i = 0 And vInt78 < 20000 Then
		Dim str4 As String = "Tavolo " & vInt78 & " unito al tavolo " & i2
		If v_stampasala Then
			Dim vTmp As String = mod1.Sub107(vInt78)
			str4 = vTmp & " unito a " & mod1.Sub107(i2)
		End If
		mod1.Sub183(False, True, str4)
	End If
	cambiapagina(vInt30)
	If vBln24 Then
		Dim iArr() As Int = Array(vInt78, i2)
		CallSub3(httpclient, "SendVariazioneTavoloAiClient", iArr, v_numcassa)
	End If
	vBln108 = False
	mod1.Sub081
End Sub

'### RISTRUTTURARE: Resumable Sub convertita come macchina a stati (comportamento identico all'originale).
Sub updtabstampe
	Dim limit4 As Int
	Dim step4 As Int
	Dim tmpcursstampepr As Cursor
	Dim x As Int
	Dim mindex As Int
	Dim tmpprt As ckprinter
	Dim result As Int
	Dim tmpstate As Int
	Dim txt As String
	Dim newprt As Int
	Dim rsState As Int = 0
	Dim rsCatchState As Int = 0
	Do While True
		Try
			Select rsState
				Case -1
					Return
				Case 0
					rsState = 1
					mod1.vStr2 = "Sub UpdTabStampe "
					Continue
				Case 1
					rsState = 112
					rsCatchState = 111
					rsState = 3
					Continue
				Case 3
					rsState = 4
					rsCatchState = 111
					'tmpcursstampepr = Cursor
					Dim cursorWrapper As Cursor
					tmpcursstampepr = vSql1.ExecQuery("Select * from confstampe order by codice")
					Continue
				Case 4
					rsState = 109
					step4 = 1
					limit4 = tmpcursstampepr.RowCount - 1
					x = 0
					rsState = 113
					Continue
				Case 6
					rsState = 7
					tmpcursstampepr.Position = x
					Continue
				Case 7
					rsState = 108
					If tmpcursstampepr.GetInt("stato") <> 1 Then
						Continue
					Else
						rsState = 9
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 9
				Case 9
					rsState = 10
					Continue
				Case 10
					rsState = 15
					If tmpcursstampepr.GetInt("mf") <> 1 Then
						Continue
					Else
						rsState = 12
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 12
				Case 12
					rsState = 15
					rsState = 114
					Continue
				Case 15
					rsState = 16
					mindex = x + 1
					Continue
				Case 16
					rsState = 21
					If tmpcursstampepr.GetInt("indice") <= 0 Then
						Continue
					Else
						rsState = 18
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 18
				Case 18
					rsState = 21
					mindex = tmpcursstampepr.GetInt("indice")
					Continue
				Case 21
					rsState = 22
					tmpprt = mod1.Sub102(mindex)
					Continue
				Case 22
					rsState = 25
					If Not(vMap2.ContainsKey(mindex)) Then
						Continue
					Else
						rsState = 24
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 24
				Case 24
					rsState = 25
					tmpprt = mod1.Sub102(vMap2.Get(mindex))
					Continue
				Case 25
					rsState = 28
					If tmpprt.IsInitialized Then
						Continue
					Else
						rsState = 27
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 27
				Case 27
					rsState = 28
					tmpprt.Initialize(tmpcursstampepr.GetInt("escpos") = 1)
					tmpprt.vInt1 = 1
					tmpprt.vInt2 = IIf(tmpcursstampepr.GetInt("ApriCassetto") = 1, 1, 0)
					tmpprt.vBln4 = (tmpcursstampepr.GetInt("BeepStampante") = 1)
					tmpprt.vBln2 = False
					Continue
				Case 28
					rsState = 29
					result = -1
					tmpstate = 1
					Continue
				Case 29
					rsState = 88
					Dim i As Int = result
					If i <> -1 Then
						Continue
					Else
						rsState = 31
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 31
				Case 31
					rsState = 32
					result = -2
					tmpstate = 1
					Continue
				Case 32
					rsState = 87
					If Not(tmpprt.vBln5) Then
						If tmpprt.Sub004(tmpcursstampepr.GetString("ip")) = 0 Then
							Continue
						Else
							rsState = 66
							Continue
						End If
					Else
						rsState = 34
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 34
				Case 34
					rsState = 35
					tmpprt.Sub005
					Continue
				Case 35
					rsState = 40
					If Not(v_disconnettiprt) Then
						Continue
					Else
						rsState = 37
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 37
				Case 37
					rsState = 40
					tmpprt.Sub001
					Continue
				Case 40
					rsState = 41
					Continue
				Case 41
					rsState = 64
					If Not(tmpprt.vkprinterstatus1.InError) Then
						Continue
					Else
						rsState = 43
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 43
				Case 43
					rsState = 44
					vSql1.ExecNonQuery("update confstampe set stato = 2 where codice = " & tmpcursstampepr.GetString("codice"))
					tmpstate = 2
					txt = ""
					txt = "Verificare lo stato della stampante... " & tmpcursstampepr.GetString("descrizione") & CRLF & "Si desidera riprovare o considerare la stampante 'Guasta' ?"
					Dim vObjectToCharSequence As Object = txt
					Dim vObjectToCharSequence2 As Object = vStr8
					Msgbox2Async(vObjectToCharSequence, vObjectToCharSequence2, "Riprova", "", "Guasta", vBmp1, False)
					Wait For (Null) Msgbox_Result (wf115_0 As Int)
					rsState = 115
					Continue
				Case 44
					rsState = 49
					If result <> -3 Then
						Continue
					Else
						rsState = 46
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 46
				Case 46
					rsState = 49
					result = -1
					Continue
				Case 49
					rsState = 50
					Continue
				Case 50
					rsState = 63
					Dim i2 As Int = result
					If i2 = -1 Then
						Continue
					Else
						rsState = 52
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 52
				Case 52
					rsState = 53
					newprt = errprtact(mindex)
					Continue
				Case 53
					rsState = 56
					If newprt <= 0 Then
						Continue
					Else
						rsState = 55
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 55
				Case 55
					rsState = 56
					vMap2.Put(mindex, newprt)
					tmpstate = 1
					Continue
				Case 56
					rsState = 57
					rsState = 88
					Continue
				Case 57
					rsState = 62
					If Not(v_errmail) Then
						Continue
					Else
						If v_md3 <> "" Then
							rsState = 59
							Continue
						Else
							Continue
						End If
					End If
					'(fallthrough java verso il case successivo)
					rsState = 59
				Case 59
					rsState = 62
					mod1.Sub132("Errore Stampante", vSMTP1, txt, False)
					Continue
				Case 62
					rsState = 63
					Continue
				Case 63
					rsState = 64
					Continue
				Case 64
					rsState = 87
					Continue
				Case 66
					rsState = 67
					vSql1.ExecNonQuery("update confstampe set stato = 2 where codice = " & tmpcursstampepr.GetString("codice"))
					tmpstate = 2
					txt = ""
					txt = "Errore durante la connessione con la stampante " & tmpcursstampepr.GetString("descrizione") & CRLF & "Si desidera riprovare o considerare la stampante 'Guasta' ?"
					Dim vObjectToCharSequence3 As Object = txt
					Dim vObjectToCharSequence4 As Object = vStr8
					Msgbox2Async(vObjectToCharSequence3, vObjectToCharSequence4, "Riprova", "", "Guasta", vBmp1, False)
					Wait For (Null) Msgbox_Result (wf116_0 As Int)
					rsState = 116
					Continue
				Case 67
					rsState = 72
					If result <> -3 Then
						Continue
					Else
						rsState = 69
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 69
				Case 69
					rsState = 72
					result = -1
					Continue
				Case 72
					rsState = 73
					Continue
				Case 73
					rsState = 86
					Dim i3 As Int = result
					If i3 = -1 Then
						Continue
					Else
						rsState = 75
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 75
				Case 75
					rsState = 76
					newprt = errprtact(mindex)
					Continue
				Case 76
					rsState = 79
					If newprt <= 0 Then
						Continue
					Else
						rsState = 78
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 78
				Case 78
					rsState = 79
					vMap2.Put(mindex, newprt)
					tmpstate = 1
					Continue
				Case 79
					rsState = 80
					rsState = 88
					Continue
				Case 80
					rsState = 85
					If Not(v_errmail) Then
						Continue
					Else
						If v_md3 <> "" Then
							rsState = 82
							Continue
						Else
							Continue
						End If
					End If
					'(fallthrough java verso il case successivo)
					rsState = 82
				Case 82
					rsState = 85
					mod1.Sub132("Errore Stampante", vSMTP1, txt, False)
					Continue
				Case 85
					rsState = 86
					Continue
				Case 86
					rsState = 87
					Continue
				Case 87
					rsState = 29
					Continue
				Case 88
					rsState = 93
					If v_lognf And tmpstate = 2 Then
						rsState = 90
						Continue
					End If
					Continue
				Case 90
					rsState = 93
					tmpprt.Sub003("Stampante impostata su GUASTA dall'utente", True)
					Continue
				Case 93
					rsState = 94
					vSql1.ExecNonQuery("update confstampe set stato = " & tmpstate & " where codice = " & tmpcursstampepr.GetString("codice"))
					Continue
				Case 94
					rsState = 107
					If v_disconnettiprt And tmpprt.vBln5 And tmpstate = 1 Then
						rsState = 96
						Continue
					End If
					Continue
				Case 96
					rsState = 97
					Continue
				Case 97
					rsState = 106
					If Not(v_spooler) Then
						Continue
					Else
						rsState = 99
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 99
				Case 99
					rsState = 100
					Continue
				Case 100
					rsState = 105
					If Not(File.Exists(mod1.vStr4 & "/Spooler", "-PausaIp" & tmpcursstampepr.GetString("ip"))) Then
						Continue
					Else
						rsState = 102
