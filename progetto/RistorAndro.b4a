Sub showinfogdpr(str As String)
	Dim vSize As CSBuilder = vCSBuilder1.Initialize.Size(18)
	vSize.Typeface(Typeface.MONOSPACE)
	Dim vSplit() As String = Regex.Split(CRLF, str)
	Dim length As Int = vSplit.Length - 1
	Dim i As Int
	For i = 0 To length
		Dim substring As String = vSplit(i).SubString2(0, 30)
		Dim substring2 As String = vSplit(i).SubString(30)
		Dim vAppend As CSBuilder = vCSBuilder1.Append(substring)
		vAppend.Color(-65536).Append(substring2).Append(CRLF).Pop
	Next
	Msgbox2(vCSBuilder1.PopAll, "Verifica accettazioni GDPR per il cliente", "OK", "", "", vBmp1)
	Sub207()
End Sub

