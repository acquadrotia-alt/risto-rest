	Dim i2 As Int
	For i2 = 0 To size
		Dim vObjectToString As String = vGetInstalledPackages.Get(i2)
		If i2 = vGetInstalledPackages.Size - 1 Then
			list.Add("ANNULLA TUTTO")
		Else
			list.Add(packageManagerWrapper.GetApplicationLabel(vObjectToString))
		End If
	Next
	If list.Size > 0 Then
