Sub Sub141
	Try
		Dim list As List
		list.Initialize
		Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select codice,descrizione from iva where descrizione <>'Da inserire' order by codice")
		If cursorWrapper.RowCount > 0 Then
			Dim rowCount As Int = cursorWrapper.RowCount - 1
			Dim i As Int
			For i = 0 To rowCount
				cursorWrapper.Position = i
				list.Add(cursorWrapper.GetString("descrizione"))
			Next
			Dim vExecQuerySingleResult As String = vSql1.ExecQuerySingleResult("Select descrizione from iva where codice = " & vCur16.GetInt("iva"))
			Dim vInputList1 As Int = idLib.InputList1(list, "Selezionare l'iva per l'articolo (attuale " & vExecQuerySingleResult & ")")
			If vInputList1 >= 0 Then
				cursorWrapper.Position = vInputList1
				vSql1.ExecNonQuery("update Ventmp set iva = " & cursorWrapper.GetString("codice") & " where  chiave =" & vCur16.GetString("chiave"))
				refilltablelist(False)
				ToastMessageShow("Iva impostata al valore:" & cursorWrapper.GetString("descrizione"), True)
			End If
		End If
		cursorWrapper.Close
		Return
	Catch
		mod1.Sub217(LastException.Message)
		Return
	End Try
End Sub

Sub Sub142(z As Boolean)
	Try
		Dim inputDialog2 As InputDialog = vDlg1
		vDlg1.InputType = 12290
		vDlg1.Input = ""
		vDlg1.Hint = "Prezzo"
		vDlg1.HintColor = Colors.ARGB(196, 255, 140, 0)
		vDlg1.PasswordMode = False
		Dim str As String = "Inserire il nuovo prezzo di vendita (attuale " & NumberFormat2(vCur16.GetString("prezzov"), 1, 2, 2, False) & " ) "
		If vStr6 = "ca" Or vStr6 = "re" Or vStr6 = "in" Then
			str = "Inserire il nuovo prezzo di acquisto (attuale " & NumberFormat2(vCur16.GetString("prezzov"), 1, 2, 2, False) & " ) "
		Else If z Then
			str = "Inserire il valore della vincita"
			vDlg1.Hint = "Importo"
		End If
		Dim vShow As Int = vDlg1.Show(str, vStr8, "Ok", "Annulla", "", vBmp1)
		If vShow = -1 Then
			If IsNumber(vDlg1.Input) Then
				Dim vTmp As Double = mod1.Sub056(vDlg1.Input)
				If vTmp >= 0 And vCur16.GetDouble("qta") * vTmp < v_maximpo Then
					If vccefdll1.vBln15 And vCur16.GetDouble("qta") < 0 And vCur16.GetString("memo").StartsWith("Doc.N.") And vTmp > vCur16.GetDouble("prezzov") Then
						Msgbox2("Prezzo non valido. ", vStr8, "OK", "", "", vBmp1)
						Return
					End If
					If vCur16.GetInt("brep") = 1 Then
						vCur6.Position = vCur16.GetInt("codice")
						If vCur6.GetDouble("maximpo") > 0 And (vTmp > vCur6.GetDouble("maximpo") Or vTmp > v_maximpo) Then
							Msgbox2("Importo troppo elevato", vStr8, "OK", "", "", vBmp1)
							lblDisplay.Text = ""
							mod1.Sub081
							Return
						End If
					End If
					Sub043(vTmp, True)
				Else
					Msgbox2("Prezzo non valido", vStr8, "OK", "", "", vBmp1)
				End If
			Else
				Msgbox2("Prezzo non valido", vStr8, "OK", "", "", vBmp1)
			End If
		End If
		mod1.Sub081
	Catch
		mod1.Sub217(LastException.Message)
	End Try
End Sub

Sub fcambiaqta(i As Int)
	If vCur16.GetDouble("qta") Mod 1 <> 0 And vCur16.GetString("descrizione").EndsWith(">") Then
		Return
	End If
	Dim inputDialog2 As InputDialog = vDlg1
	vDlg1.InputType = 12290
	vDlg1.Input = ""
	vDlg1.PasswordMode = False
	vDlg1.Hint = "Quantità"
	vDlg1.HintColor = Colors.ARGB(196, 255, 140, 0)
	Dim vShow As Int = vDlg1.Show("Inserire la nuova quantità (attuale " & vCur16.GetString("qta") & ")", vStr8, "Ok", "Annulla", "", vBmp1)
	If vShow = -1 Then
		If IsNumber(vDlg1.Input) Then
			Dim vRound2 As Double = Round2(vDlg1.Input, 3)
			If i > 0 And vRound2 < i Then
				Msgbox2("Non è possibile indicare una quantità inferiore a " & i, vStr8, "OK", "", "", vBmp1)
				Return
			End If
			If vRound2 > 0 And vRound2 < 10000 Then
				If vStr6 = "" And vSql1.ExecQuerySingleResult("select round(prezzov * " & vRound2 & ",2) - scov from Ventmp where  chiave =" & vCur16.GetString("chiave")) > v_maximpo Then
					Msgbox2("L'importo di riga è troppo elevato", vStr8, "OK", "", "", vBmp1)
					Return
				End If
				If v_regcancellazioni And vLng11 > 0 And vCur16.GetString("qta") > vRound2 And vCur16.GetDouble("Oldqta") > 0 Then
					mod1.Sub146("Select codint,round(importo /qta,2) as importo," & vCur16.GetString("qta") - vRound2 & " as qta,brep from Ventmp where  chiave =" & vCur16.GetString("chiave"), vLng11, Operatore, vInt25)
				End If
				vSql1.ExecNonQuery("update Ventmp set qta = " & vRound2 & " ,importo = round(prezzov * " & vRound2 & "+0.000000001,2) - scov where  chiave =" & vCur16.GetString("chiave"))
				If v_turni And vInt25 > 0 And vCur16.GetInt("turno") < 0 Then
					vSql1.ExecNonQuery("update Ventmp set turno=turno*-1 where  chiave =" & vCur16.GetString("chiave"))
				End If
				If i = 0 Then
					Sub004(vLbl3, vCur16.GetString("chiave"), vLbl4)
				End If
				refilltablelist(False)
			Else
				Msgbox2("Quantità non valida", vStr8, "OK", "", "", vBmp1)
			End If
		Else
			Msgbox2("Quantità non valida", vStr8, "OK", "", "", vBmp1)
		End If
	End If
	mod1.Sub081
End Sub

Sub Sub143
	Dim list As List
	list.Initialize
	Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select nmov,totale from headmov where operatore = 100 order by nmov")
	If cursorWrapper.RowCount > 0 Then
		Dim rowCount As Int = cursorWrapper.RowCount - 1
		Dim i As Int
		For i = 0 To rowCount
			cursorWrapper.Position = i
			list.Add("Mov." & cursorWrapper.GetString("nmov") & "   (Totale " & NumberFormat2(cursorWrapper.GetDouble("totale"), 1, 2, 2, False) & ")")
		Next
		Dim vInputMultiList As List = InputMultiList(list, "Selezionare i movimenti dove modificare l'operatore")
		If vInputMultiList.Size > 0 Then
			Dim cursorWrapper2 As Cursor = vSql1.ExecQuery("Select * from operatori order by codice")
			Dim list2 As List
			list2.Initialize
			Dim rowCount2 As Int = cursorWrapper2.RowCount - 1
			Dim i2 As Int
			For i2 = 0 To rowCount2
				cursorWrapper2.Position = i2
				list2.Add(cursorWrapper2.GetString("descrizione"))
			Next
			Dim i3 As Int = -1
			Do While i3 < 0
				Dim vInputList1 As Int = idLib.InputList1(list2, "Selezionare l'operatore al quale legare i movimenti")
				If vInputList1 >= 0 Then
					cursorWrapper2.Position = vInputList1
					Dim size As Int = vInputMultiList.Size - 1
					Dim i4 As Int
					For i4 = 0 To size
						cursorWrapper.Position = vInputMultiList.Get(i4)
						vSql1.ExecNonQuery("update headmov set operatore = " & cursorWrapper2.GetString("codice") & ",opdes= '" & cursorWrapper2.GetString("descrizione") & "'" & TAB & "where nmov = " & cursorWrapper.GetString("nmov"))
					Next
					i3 = vInputList1
				Else
					i3 = vInputList1
				End If
			Loop
			cursorWrapper2.Close
		End If
	Else
		Msgbox2("Non esiste nessun movimento in attesa di operatore.", vStr8, "OK", "", "", vBmp1)
	End If
	cursorWrapper.Close
End Sub

Sub Sub144
	vMap26.Initialize
	If vStr6 <> "" Then
		ToastMessageShow("Consentito solo con movimento di Vendita ...", False)
		lblDisplay.Text = ""
		mod1.Sub081
		Return
	End If
	If v_termsala Then
		Sub137("Non consentito su Terminale di sala ...", True)
		Return
	End If
	If vBln12 And vBln105 Then
		mod1.Sub081
		Return
	End If
	If vBln12 Then
		vBln12 = False
		vInt72 = 0
		mod1.Sub164(lblStato, -7938671)
		vSql1.ExecNonQuery("update Ventmp set Qtad = 0,importod=0,scovd=0")
		refilltablelist(True)
	Else
		If Not(v_noforcecoperti) Then
			Sub029(False, False)
		End If
		Dim parseDouble As Double = vSql1.ExecQuerySingleResult("select case when sum(qta) is null then 0 else sum(qta) end as tot from Ventmp where lower(substr(codice,1,2))<>'ww' and lower(substr(codice,1,2))<>'vv' and lower(substr(codint,1,3))<>'msg' and lower(substr(codint,1,3))<>'abb'")
		If parseDouble > 1 Then
			vBln12 = True
			vLng12 = vLng11
			mod1.Sub164(lblStato, Colors.RGB(196, 66, 187))
			vSql1.ExecNonQuery("update Ventmp set Qtad = 0,importod=0,scovd=0")
			vSql1.ExecNonQuery("update Ventmp set Qtad = 1 where (lower(substr(codint,1,3))='msg' or (importo =0 and gruppomenu <>'')) or lower(substr(codint,1,3))='mnu'")
			vSql1.ExecNonQuery("update Ventmp set Qtad = 1 ,importod=importo where codint='abb' ")
			Dim cursorWrapper As Cursor = vSql1.ExecQuery("select chiave,qta,importo,importo2 from Ventmp")
			Dim rowCount As Int = cursorWrapper.RowCount - 1
			Dim i As Int
			For i = 0 To rowCount
				cursorWrapper.Position = i
				vMap26.Put(cursorWrapper.GetInt("chiave"), (cursorWrapper.GetDouble("importo") + cursorWrapper.GetDouble("importo2")) / cursorWrapper.GetDouble("qta"))
			Next
			refilltablelist(True)
		Else If parseDouble = 1 Then
			Msgbox2("La Quantità deve essere maggiore di 1", vStr8, "OK", "", "", vBmp1)
			mod1.Sub081
			Return
		End If
	End If
End Sub

