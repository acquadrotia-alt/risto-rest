			vSql1.ExecNonQuery("update pagine set colore =8,coloret =-1," & CRLF & TAB & TAB & TAB & TAB & TAB & TAB & TAB & TAB & TAB & TAB & "textsize =0,dll ='' where chiave =" & SmartStringFormatter("", vCur26.GetString("chiave")) & "")
