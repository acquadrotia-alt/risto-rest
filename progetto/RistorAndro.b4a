Sub Sub033(d As Double, d2 As Double)
	mod1.vStr2 = "Sub addRowRep(prezzo As Double,qta As Double)"
	Try
		vTmr2.Enabled = False
		vCur6.Position = vCur15.GetString("valore")
	Catch
		mod1.Sub217(LastException.Message)
	End Try
	If vCur6.GetDouble("maximpo") > 0 And (d > vCur6.GetDouble("maximpo") Or d > v_maximpo) Then
		Msgbox2("Importo troppo elevato", vStr8, "OK", "", "", vBmp1)
		lblDisplay.Text = ""
		mod1.Sub081
		Return
	End If
	If vccefdll1.vBln15 Then
		If vccefdll1.vBln10 Then
			Msgbox2("ATTENZIONE ... è necessario eseguire una Chiusura Giornaliera.", vStr8, "OK", "", "", vBmp1)
			lblDisplay.Text = ""
			vDbl19 = 1
			Return
		End If
		vCur4.Position = vCur6.GetInt("iva")
		If vCur4.GetInt("RTIva") = 0 Then
			Msgbox2("Questo reparto è legato ad una iva non attiva per RT", vStr8, "OK", "", "", vBmp1)
			lblDisplay.Text = ""
			vDbl19 = 1
			Return
		End If
	End If
	Dim vRound2 As Double = Round2(d * d2, 2)
	vBln126 = False
	vLst11.Clear
	vMap19.Clear
	vMap19.Put("codice", vCur15.GetString("valore"))
	vMap19.Put("descrizione", vCur6.GetString("descrizione"))
	vMap19.Put("brep", True)
	If v_turni Then
		vMap19.Put("turno", vInt7)
	End If
	vMap19.Put("qta", d2)
	vMap19.Put("prezzov", d)
	vMap19.Put("reparto", vCur15.GetInt("valore"))
	vMap19.Put("iva", vCur6.GetInt("iva"))
	vMap19.Put("datam", DateTime.Date(mod1.Sub058))
	vMap19.Put("datam2", DateTime.Date(mod1.Sub058) & " " & DateTime.Time(mod1.Sub058))
	vMap19.Put("datam3", mod1.Sub057(DateTime.Date(mod1.Sub058) & " " & DateTime.Time(mod1.Sub058)))
	vMap19.Put("flgNF", vCur6.GetInt("NF") = 1)
	vMap19.Put("codint", vCur15.GetString("valore"))
	vMap19.Put("cassa", v_numcassa)
	vMap19.Put("idRiga", mod1.Sub006)
	Dim i As Int = 0
	If vStr28 <> "" Then
		i = vCur17.GetInt("sconto")
	End If
	If i > 0 And vCur6.GetInt("scontabile") = 1 Then
		vMap19.Put("scop", i)
		vMap19.Put("scov", Round2(vRound2 - (1 - i / 100) * vRound2, 2))
		vMap19.Put("importo", vRound2 - Round2(vRound2 - (1 - i / 100) * vRound2, 2))
	Else
		vMap19.Put("importo", vRound2)
		vMap19.Put("scop", 0)
		vMap19.Put("scov", 0)
	End If
	If vInt25 > 0 Then
		vMap19.Put("cameriere", Operatore)
	End If
	If vBln141 Then
		vMap19.Put("sottoconto", vInt46)
		vMap19.Put("memo", " -Sottoconto " & vInt46 & "-")
	End If
	vLst11.Add(vMap19)
	dbutil.Sub007(vSql1, "Ventmp", vLst11)
	vSql1.ExecNonQuery("update Ventmp set  QtaConDecimali = chiave,totcre=chiave where chiave = (select max(chiave) from Ventmp)")
	refilltablelist(False)
	Dim length As Int = NumberFormat2(vRound2, 1, 2, 2, False).Length
	Dim left As String = modfunstr.left(vCur6.GetString("descrizione"), 20 - length - 3)
	Dim vTmp As String = modfunstr.Sub004(20 - length - modfunstr.left(vCur6.GetString("descrizione"), 20 - length - 3).Length)
	Dim vNumberFormat2 As String = NumberFormat2(vRound2, 1, 2, 2, False)
	Dim str As String = left & vTmp & vNumberFormat2
	vccefdll1.mf_display(str, "TOTALE" & modfunstr.Sub003(modfunstr.Sub004(14) & NumberFormat2(vDbl1 + vDbl12, 1, 2, 2, False), 14))
	If v_ipvis <> "" Then
		If vCur28.IsInitialized Then
			vCur28.Close
		End If
		vCur28 = vSql1.ExecQuery("select chiave,descrizione,importo,scov,codice,qta,codint,prezzov,totcre from Ventmp where chiave = (select max(chiave) from Ventmp)")
		If vCur28.RowCount > 0 Then
			vCur28.Position = 0
			Dim str2 As String = "R," & vCur28.GetString("chiave") & "," & mod1.Sub038(vCur28.GetString("descrizione"), 50, False).Replace(",", ".").Replace(" ", "_").Replace(">", "").Replace("<", "") & "," & NumberFormat2(vCur28.GetDouble("importo"), 1, 2, 2, False).Replace(",", ".") & "," & NumberFormat2(vCur28.GetDouble("scov"), 1, 2, 2, False).Replace(",", ".") & "," & vCur28.GetString("codice").Replace(" ", "_") & "," & vCur28.GetString("qta").Replace(",", ".") & "," & NumberFormat2(vCur28.GetDouble("prezzov"), 1, 2, 2, False).Replace(",", ".") & "," & vCur28.GetString("totcre").Replace(",", ".")
			CallSub2(httpclient, "UpdVis", str2)
		End If
	End If
	vDbl19 = 1
	lblDisplay.Text = ""
End Sub

