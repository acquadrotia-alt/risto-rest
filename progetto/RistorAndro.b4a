		vBln47 = False
	Else If str.Contains("Cash Management Errore" & CRLF) Then
		vBln48 = False
	End If
End Sub

'### RISTRUTTURARE: Resumable Sub convertita come macchina a stati (comportamento identico all'originale).
Sub msgboxonlya(txt As String, cancellabile As Boolean)
	Dim result As Int
	Dim rsState As Int = 0
	Do While True
		Select rsState
			Case -1
				Return
			Case 0
				rsState = 1
				Dim vObjectToCharSequence As Object = txt
				Dim vObjectToCharSequence2 As Object = vStr8
				Msgbox2Async(vObjectToCharSequence, vObjectToCharSequence2, "", "", "Ok", vBmp1, cancellabile)
				Wait For (Null) Msgbox_Result (wf7_0 As Int)
				rsState = 7
				Continue
			Case 1
				rsState = 6
				If txt.Contains("Cash Management" & CRLF & "Risultano bassi i livelli dei seguenti tagli:") Then
					rsState = 3
					Continue
				Else If Not(txt.Contains("Cash Management Errore" & CRLF)) Then
					Continue
				Else
					rsState = 5
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 3
			Case 3
				rsState = 6
				vBln47 = False
				Continue
			Case 5
				rsState = 6
				vBln48 = False
				Continue
			Case 6
				rsState = -1
				Continue
			Case 7
				rsState = 1
				result = wf7_0
				Continue
		End Select
	Loop
End Sub

'### RISTRUTTURARE: Resumable Sub convertita come macchina a stati (comportamento identico all'originale).
Sub MymsgboxLicenzaST(txt As String)
	Dim result As Int
	Dim rsState As Int = 0
	Do While True
		Select rsState
			Case -1
				Return
			Case 0
				rsState = 1
				Dim vObjectToCharSequence As Object = txt
				Dim vObjectToCharSequence2 As Object = vStr8
				Msgbox2Async(vObjectToCharSequence, vObjectToCharSequence2, "OK", "Annulla", "", vBmp1, True)
				Wait For (Null) Msgbox_Result (wf5_0 As Int)
				rsState = 5
				Continue
			Case 1
				rsState = 4
				Dim i As Int = result
				If i <> -1 Then
					Continue
				Else
					rsState = 3
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 3
			Case 3
				rsState = 4
				Sub021("7", "")
				Continue
			Case 4
				rsState = -1
				Continue
			Case 5
				rsState = 1
				result = wf5_0
				Continue
		End Select
	Loop
