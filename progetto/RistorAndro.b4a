Sub Sub112(j As Long, str As String)
	mod1.vStr2 = "Sub DeCriptaData As Long"
	Try
		Dim byteConverter As ByteConverter
		Dim bArr(0) As Byte
		Dim bArr2(0) As Byte
		Dim bArr3(0) As Byte
		Dim keyGeneratorWrapper As KeyGenerator
		Dim cipherWrapper As Cipher
		cipherWrapper.Initialize("DES/CBC/PKCS5Padding")
		cipherWrapper.InitialisationVector = Array As Byte(21, 32, 43, 54, 65, 76, 87, 98)
		keyGeneratorWrapper.Initialize("DES")
		keyGeneratorWrapper.KeyFromBytes(Array As Byte(33, 22, 43, 8, 45, 24, 43, 28))
		vSql1.ExecNonQuery("update Parameters set " & str & " ='" & byteConverter.HexFromBytes(cipherWrapper.Encrypt(byteConverter.StringToBytes(j.Trim.ToUpperCase, "UTF8"), keyGeneratorWrapper.Key, True)) & "'")
		Return
	Catch
		mod1.Sub217(LastException.Message)
		Return
	End Try
End Sub

Sub Sub113(str As String) As Long
	mod1.vStr2 = "Sub DeCriptaData As Long"
	Try
		Dim bArr(0) As Byte
		Dim bArr2(0) As Byte
		Dim bArr3(0) As Byte
		Dim byteConverter As ByteConverter
		Dim keyGeneratorWrapper As KeyGenerator
		Dim cipherWrapper As Cipher
		cipherWrapper.Initialize("DES/CBC/PKCS5Padding")
		cipherWrapper.InitialisationVector = Array As Byte(21, 32, 43, 54, 65, 76, 87, 98)
		keyGeneratorWrapper.Initialize("DES")
		keyGeneratorWrapper.KeyFromBytes(Array As Byte(33, 22, 43, 8, 45, 24, 43, 28))
		Dim vExecQuerySingleResult As String = vSql1.ExecQuerySingleResult("select " & str & " from Parameters")
		If vExecQuerySingleResult = "" Then
			Return 0
		End If
		Return byteConverter.StringFromBytes(cipherWrapper.Decrypt(byteConverter.HexToBytes(vExecQuerySingleResult), keyGeneratorWrapper.Key, True), "UTF8").ToUpperCase.Trim
	Catch
		mod1.Sub217(LastException.Message)
		Return 0
	End Try
End Sub

Sub Sub114(str As String) As String
	Dim str2 As String = ""
	Dim length As Int
	For length = str.Length - 6 To 0 Step -2
		str2 = str2 & Chr(Bit.ParseInt(str.SubString2(length, length + 2), 16))
	Next
	Return str2
End Sub

