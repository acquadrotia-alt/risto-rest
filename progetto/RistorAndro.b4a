Sub Sub175(i As Int) As String
	Select i
		Case ct_occupato
			Return "(rifheadmov>0  )"
		Case ct_bloccato
			Return "(lock=1  )"
		Case ct_libero
			Return "(rifheadmov=0 and lock=0 )"
		Case ct_ricconto
			Return "(ricconto=1 and stampap=0 )"
		Case ct_uscita
			Return "(rifheadmov>0 and uscita=1 )"
		Case Else
			Return ""
	End Select
End Sub

Sub Sub176(str As String) As String
	Select vStr6
		Case "ca", "re"
			Return "giac=round(giac + " & str & " ,3)"
		Case "au", "rf"
			Return "giac=round(giac - " & str & " ,3)"
		Case "pr"
			Return "giac=giac"
		Case "in"
			Return "giac=round(" & str & " ,3)"
		Case Else
			Return "giac=round(giac - " & str & " ,3)"
	End Select
End Sub

