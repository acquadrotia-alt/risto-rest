Sub apritavolo(strArr As String(), z As Boolean)
	Dim str As String
	Dim z2 As Boolean
	Dim str2 As String
	Try
		str = strArr(1)
		Dim str3 As String = "Tavolo " & str
		If strArr.Length > 2 Then
			str3 = strArr(2)
		End If
		If str3 = "Attiva sottoconti" Then
			z2 = True
			str2 = "Tavolo " & str
		Else
			z2 = False
			str2 = str3
		End If
		Dim equals As Boolean = IIf(strArr.Length = 4, strArr(3) = "1", False)
		If vBln25 Then
			If Not(Sub066()) Then
				Return
			End If
			If z Then
				If v_opobbligatorio And Not(equals) Then
					CallSub3(httpclient, "SendHelloDaClientPerRichiestaOperatore", str, str2)
				Else
					CallSub3(httpclient, "SendHelloDaClientPerAperturaTavolo", str, str2)
				End If
				Return
			End If
			mod1.Sub014(str)
		End If
	Catch
		vBln19 = False
		ProgressDialogHide
		mod1.Sub217(LastException.Message)
	End Try
	If Not(vBln16) And str > vInt64 Then
		vBln19 = False
		ProgressDialogHide
		Return
	End If
	If vCur24.IsInitialized Then
		vCur24.Close
	End If
	vCur24 = vSql1.ExecQuery("Select * from tavoli where tavolo = " & str)
	If vCur24.RowCount > 0 Then
		vCur24.Position = 0
		If vBln8 And Not(v_termsala) Then
			Dim vMsgbox2 As Int = Msgbox2("Non è possibile aprire tavoli senza la stampante fiscale.", vStr8, "Ok", "", "Vedi info", vBmp1)
			If vMsgbox2 = -2 Then
				vStr27 = "Tavolo_info"
