						numberDialog.ShowSign = False
						Dim vShow As Int = numberDialog.Show("Inserire il numero di copie da ristampare", "Ok", "Annulla", "", vBmp1)
						If vShow = -1 And number = numberDialog.Number > 0 Then
							If str4.Contains("MF") Then
								vccefdll1.vInt6 = number
