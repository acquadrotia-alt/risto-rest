				Else
					vCur20 = vSql1.ExecQuery("select indice,descrizione,list1,list2,list3,list4,list5,codint,colore,coloret,textsize,dll,locked from anagra where gruppov = " & vInt63 & " and bvar =0 order by indice,upper(descrizione)")
				End If
