					labelWrapper.Text = labelWrapper.Text & " (" & str2 & NumberFormat2(d, 1, 0, 0, False) & ")"
				Else
					labelWrapper.Text = labelWrapper.Text & " (" & str2 & NumberFormat2(d, 1, 3, 3, False) & ")"
				End If
				If cursorWrapper.GetInt("sottoscorta") > 0 And d < cursorWrapper.GetInt("sottoscorta") Then
					Dim vRGB6 As Int = Colors.RGB(124, 255, 192)
					labelWrapper.Background = mod1.Sub158(vRGB6, -1)
				End If
				If d <= 0 Then
					Dim vRGB7 As Int = Colors.RGB(160, 212, 255)
