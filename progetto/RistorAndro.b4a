		Dim dirDefaultExternal As String = File.DirDefaultExternal
		If File.Exists(dirDefaultExternal.Replace(Application.PackageName, "com.ttxapps.drivesync"), "") Then
			Dim dirDefaultExternal2 As String = File.DirDefaultExternal
			If File.Exists(dirDefaultExternal2.Replace(Application.PackageName, "com.ttxapps.drivesync") & "/syncitemdb", "") Then
				Dim list As List
				list.Initialize
				Dim dirDefaultExternal3 As String = File.DirDefaultExternal
