			vLbl5.Text = "Stato Attivo :Incolla"
		Case 2
			vLbl5.Text = "Stato Attivo :Copia tasto su tutte le pagine"
			vLbl6.Text = "Porta i tasti che cliccheremo in successione ad essere presenti su tutte le pagine(sono escluse le sale e le pagine con paginazione automatica)"
		Case 3
			vLbl5.Text = "Stato Attivo :Scambia Tasto"
			vLbl6.Text = "Indicare il tasto di destinazione."
		Case 4
			vLbl5.Text = "Stato Attivo :Plu Paginati"
			vLbl6.Text = "Premere in sequenza tutti i tasti su cui desideriamo avere la paginazione automatica dei PLU legati ad un reparto con funzione paginazione abilitata o ad un tasto con funzione Gruppo (saranno visualizzati tutti i PLU legati a quel gruppo)."
		Case 5
			vLbl5.Text = "Stato Attivo :Vuota tasto"
			vLbl6.Text = "Selezionare tutti i tasti che si desidera vuotare"
		Case 6
			vLbl5.Text = "Stato Attivo :Tasti NON paginati"
			vLbl6.Text = "Inserisce all'interno della paginazione automatica dei Plu la funzione dai tasti che saranno cliccati in sequenza"
	End Select
	If vInt91 > 0 Then
		If vInt91 = 1 Then
			Dim vSize As CSBuilder = vCSBuilder1.Initialize.Size(15).Append(vLbl6.Text & CRLF).Size(18)
			vSize.Color(-65536).Append("Facendo un LongClick sul tasto sarà possibile trascinarlo nella destinazione (SCAMBIA I TASTI) desiderata o ridimensionarlo tramite pinch")
		Else If vInt91 = 2 Then
			Dim vSize2 As CSBuilder = vCSBuilder1.Initialize.Size(15).Append(vLbl6.Text & CRLF).Size(18)
			vSize2.Color(-65536).Append("Facendo un LongClick sul tasto sarà possibile trascinarlo nella destinazione (IL TASTO DI ORIGINE VIENE AZZERATO) desiderata o ridimensionarlo tramite pinch")
		End If
		vLbl6.Text = vCSBuilder1.PopAll
		Return
	End If
	vLbl6.Text = vLbl6.Text & CRLF & "Facendo un LongClick sul tasto sarà possibile copiare o spostare tasti"
End Sub

