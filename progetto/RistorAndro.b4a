Sub Sub165(i As Int) As Int
	If i <= 0 Or i >= 15 Then
		Return i
	End If
	Select i
		Case c_rosso
			Return -65536
		Case c_blu
			Return -16776961
		Case c_verde
			Return -16711936
		Case c_giallo
			Return -256
		Case c_arancione
			Return Colors.RGB(255, 153, 50)
		Case c_bianco
			Return -1
		Case c_grigio
			Return -7829368
		Case c_marrone
			Return Colors.RGB(167, 25, 36)
		Case c_azzurro
			Return -16711681
		Case c_verdesmeraldo
			Return Colors.RGB(0, 255, 89)
		Case c_verdechiaro
			Return Colors.RGB(178, 255, 102)
		Case c_viola
			Return Colors.RGB(178, 0, 255)
		Case c_rosa
			Return Colors.RGB(255, 127, 237)
		Case c_nero
			Return Colors.RGB(0, 0, 0)
		Case Else
			Return -16776961
	End Select
End Sub

