				map.Put("codice", vSplit(1))
				map.Put("descrizione", vSplit(2))
				map.Put("brep", vSplit(3))
				map.Put("qta", vSplit(4))
				map.Put("prezzov", vSplit(5))
				map.Put("reparto", vSplit(6))
				map.Put("aliquota2", vSplit(7))
				map.Put("aliquota", vSplit(7))
				map.Put("iva", vSplit(8))
				map.Put("importo", vSplit(9))
				map.Put("codint", vSplit(10))
				map.Put("scop", vSplit(11))
				map.Put("scov", vSplit(12))
				map.Put("flgNF", vSplit(13))
				map.Put("nmov", parseDouble)
				list2.Add(map)
			Else If vSplit(0) = "head" Then
				Dim str3 As String = " Cassa " & str2 & ": " & vSplit(1)
				map.Put("nmov", parseDouble)
				If vSplit(2).StartsWith("F_") Then
					map.Put("nfat", vSplit(2).Replace("F_", ""))
				Else If vSplit(2).StartsWith("D_") Then
					map.Put("nddt", vSplit(2).Replace("D_", ""))
				End If
				map.Put("cliente", IIf(vSplit(3) = "null", "", vSplit(3)))
				map.Put("clides", IIf(vSplit(4) = "null", "", vSplit(4)))
				map.Put("flgNF", IIf(vSplit(5) = "false", "0", "1"))
				map.Put("totale", vSplit(6))
				map.Put("prep", IIf(vSplit(7) = "null", "0", vSplit(7)))
				map.Put("punti", IIf(vSplit(8) = "null", "0", vSplit(8)))
				map.Put("datam", vSplit(9).SubString2(0, 10))
				map.Put("memo", str3)
				map.Put("operatore", vSplit(11))
				map.Put("opdes", vSplit(12))
				map.Put("datam3", vSplit(20))
				list.Add(map)
			End If
			vReadLine = textReaderWrapper.ReadLine
		Loop
		textReaderWrapper.Close
		If list.Size > 0 Then
			dbutil.Sub007(vSql1, "headmov", list)
		End If
		If list2.Size > 0 Then
			dbutil.Sub007(vSql1, "venduto", list2)
		End If
		If list3.Size > 0 Then
			dbutil.Sub007(vSql1, "CausaliPagamenti", list3)
			Return
		End If
		Return
	Catch
		mod1.Sub217(LastException.Message)
		Return
	End Try
End Sub

