			Sub089(True, False)
			Return
		Case d_confpalmari
			If vSql1.ExecQuerySingleResult("Select count(*) from Palmari where Attivo = 1") > vInt20 Then
				Msgbox2("Raggiunto il numero massimo (" & vInt20 & ") di palmari attivabili." & CRLF & "Verranno disattivati automaticamente quelli in eccesso.", vStr8, "OK", "", "", vBmp1)
				Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select Serial from Palmari where Attivo = 1 order by Serial")
				If cursorWrapper.RowCount > 0 Then
					Dim rowCount As Int = cursorWrapper.RowCount - 1
					Dim i2 As Int
					For i2 = 0 To rowCount
						If i2 >= vInt20 Then
							cursorWrapper.Position = i2
							vSql1.ExecNonQuery("update Palmari set Attivo = 0 where Serial = '" & cursorWrapper.GetString("Serial") & "'")
						End If
					Next
				End If
				cursorWrapper.Close
			End If
			vBln136 = True
			mod1.Sub198("ConfPalmari")
			Sub089(True, False)
			Sub279()
			Return
