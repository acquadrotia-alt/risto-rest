				sf = vCustomLayoutDialog2.ShowAsync(str, "Ok", "Annulla", "", vBmp1, True)
				vCustomLayoutDialog2.SetSize(PerXToCurrent(65), PerYToCurrent(90))
				Wait For (sf) Dialog_Ready (wf9_0 As Panel)
				rsState = 9
				Continue
			Case 1
				rsState = 8
