					rsState = 9
					Continue
				End If
				Continue
			Case 9
				rsState = 12
				rsState = 14
				Continue
			Case 12
				rsState = 13
				Continue
			Case 13
				rsState = 1
				Continue
			Case 14
				rsState = -1
				Sub220(True)
				Sub209()
				vBln63 = False
				mod1.Sub081
				Continue
			Case 15
				rsState = 4
				dialogpanel = wf15_0
				dialogpanel.LoadLayout("DetailsDialog")
				lblTestoDD.Text = "Inserire il codice di sblocco (Id:" & tmpstr & ")"
				lblHeadDD.Text = "Blocco Terminale"
				ImgDD.Bitmap = vBmp1
				edtInsDataDD.PasswordMode = True
				Dim editTextWrapper2 As EditText = edtInsDataDD
				edtInsDataDD.InputType = 2
				edtInsDataDD.RequestFocus
				Wait For (sf) Dialog_Result (wf16_0 As Int)
				rsState = 16
				Continue
			Case 16
				rsState = 4
				result = wf16_0
				sresult = edtInsDataDD.Text
				Continue
		End Select
	Loop
End Sub

