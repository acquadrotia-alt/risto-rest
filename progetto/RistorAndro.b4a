Sub elaborasacchettone(z As Boolean)
	If Not(z) Then
		Dim vMsgbox2 As Int = Msgbox2("Scontrino bilancia non trovato." & CRLF & "Si desidera riprovare o inserire la vendita complessiva della bilancia ?", vStr8, "Riprova", "", "Complessivo", vBmp1)
		If vMsgbox2 <> -2 Then
			vStr46 = ""
			Dim object As Class = httpclient
			CallSub2(object, "GetSacchettone", vStr43)
			ToastMessageShow("Comunicazione con il Server in corso ...", False)
		Else
			If vSql1.ExecQuerySingleResult("SELECT count(*) FROM anagra  inner join ean on ean.codint = anagra.codint where anagra.plupeso <>0 and ean.codice= '" & vStr43.SubString2(0, 2) & "00000' and plupeso=3") = 0 Then
				Return
			End If
			Dim vExecQuerySingleResult As String = vSql1.ExecQuerySingleResult("SELECT anagra.codint FROM anagra  inner join ean on ean.codint = anagra.codint where anagra.plupeso <>0 and ean.codice= '" & vStr43.SubString2(0, 2) & "00000' and plupeso=3 limit 1")
			vDbl19 = 1
			lblDisplay.Text = vStr43.SubString2(7, 12) / 100
			addRowPlu(vExecQuerySingleResult, False, False, vStr43, True, "")
		End If
	Else
		Dim randomAccessFile As RandomAccessFile
		Try
			If File.Exists(mod1.vStr4, "Tmp.job") Then
				If File.Size(mod1.vStr4, "Tmp.job") = 0 Then
					Msgbox2("Il file dal server delle bilance risulta essere lungo 0 byte", vStr8, "OK", "", "", vBmp1)
					Return
				End If
				Initialize
				randomAccessFile.Initialize(mod1.vStr4, "Tmp.job", False)
				Dim list As List = randomAccessFile.ReadObject(randomAccessFile.CurrentPosition)
				If randomAccessFile.Size <= randomAccessFile.CurrentPosition Then
					Msgbox2("Il file dal server delle bilance risulta non essere completo", vStr8, "OK", "", "", vBmp1)
					randomAccessFile.Close
					Return
				End If
				Dim vObjectToNumber As Int = randomAccessFile.ReadObject(randomAccessFile.CurrentPosition)
				randomAccessFile.Close
				If vObjectToNumber <> vStr43.SubString2(7, 12) Then
					Dim vMsgbox22 As Int = Msgbox2("Il totale dello scontrino bilancia non corrisponde al totale indicato nel barcode." & CRLF & "Si desidera proseguire ugualmente ?", vStr8, "Si", "", "No", vBmp1)
					If vMsgbox22 = -2 Then
						Return
					End If
				End If
				If list.Size > 0 Then
					Dim size As Int = list.Size - 1
					Dim i As Int
					For i = 0 To size
						Dim map As Map = list.Get(i)
						Dim str As String = "BILA" & map.GetDefault("Code", "")
						Dim startsWith As Boolean = str.StartsWith("BILA")
						If str.StartsWith("BILA") And vSql1.ExecQuerySingleResult("Select count(*) from ean where codice = '" & str & "'") = 0 Then
							Msgbox2Async("Il codice cercato " & str & CRLF & " non è stato trovato", vStr8, "", "", "Ok", vBmp1, True)
						Else
							Dim vObjectToNumber2 As Double = map.GetDefault("Qty", 0) / 1000
							Dim vAbs As Double = Abs(map.GetDefault("Price", 0) / 100)
							vDbl11 = map.GetDefault("Amount", 0) / 100
							vDbl19 = vObjectToNumber2
							If vAbs > 0 Then
								lblDisplay.Text = vAbs
							End If
							addRowPlu(str, startsWith, False, "", False, "")
						End If
					Next
				End If
			End If
		Catch
			mod1.Sub217(LastException.Message)
			Msgbox2("Il file dal server delle bilance risulta non essere valido", vStr8, "OK", "", "", vBmp1)
		End Try
	End If
End Sub

