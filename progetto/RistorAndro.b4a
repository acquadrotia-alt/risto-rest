			lblDisplay.Text = ""
			Return False
		End If
	End If
	If Not(z) And vCur15.GetDouble("importo") > 0 And Not(vBln72) Then
		Dim vNumberToString As String = vCur15.GetDouble("importo")
		If Not(v_consideraprzintero) Then
			vNumberToString = Round2(vCur15.GetDouble("importo") * 100, 2)
		End If
		lblDisplay.Text = vNumberToString.Replace(",", ".")
	End If
	If vLng11 > 0 Then
		vBln19 = True
	End If
	If vLng9 > 0 And Not(vBln45) Then
		vLng9 = 0
	End If
	If vBln69 And vLng9 = 0 Then
		vBln18 = True
		stampasco(str, 1)
		vBln18 = vBln18
	Else If vLng9 > 0 And vBln45 Then
		v_riducimsg = True
		eseguifunzione(f_conto)
		Dim parseDouble As Double = vSql2.ExecQuerySingleResult("select case when sum(totale) is null then 0 else sum(totale) end from crediti where nmov=" & SmartStringFormatter("", vLng9) & " ")
		If parseDouble > 0 And vcustomlistviewold3.Sub008 = 0 Then
