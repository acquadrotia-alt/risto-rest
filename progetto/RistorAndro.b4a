		list.AddAll(ArrayToList(Array As String("Preso in carico", "Inviato all’intermediario/salvato in cartella", "Non inviato all’intermediario/non salvato in cartella", "Scartato dall’intermediario", "Caricato dall’intermediario", "Caricato sullo SDI", "Scartato dallo SDI", "Caricato sullo SDI ma non consegnato al destinatario")))
		Dim map As Map
		map.Initialize
