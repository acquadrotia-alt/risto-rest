		For i3 = 0 To i2
			Dim size As Int = list.Size - 1
			Dim i4 As Int
			For i4 = 0 To size
				vTmp.Sub008(list.Get(i4))
			Next
		Next
		vTmp.Sub001
	End If
End Sub

