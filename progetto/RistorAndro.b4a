Sub Turno_Click
	Dim vTmp As Int
	Dim i As Int
	mod1.vStr2 = "Sub turno_Click"
	Try
		vTmp = vcustomlistviewold3.Sub007(Sender)
	Catch
		mod1.Sub217(LastException.Message)
	End Try
	If vTmp < 0 Then
		Return
	End If
	Dim getpanel As Panel = vcustomlistviewold3.getpanel(vTmp)
	Dim labelWrapper As Label = getpanel.GetView(3)
	vCur16.Position = vTmp
	If v_turni Then
		If mod1.Sub145(vCur16.GetString("totcre")) Then
			Return
		End If
	End If
	Dim vAbs As Int = Abs(vCur16.GetInt("turno")) + 1
	If vAbs > 5 Or vInt59 >= 5 Then
		vAbs = 1
	End If
	labelWrapper.Text = vAbs
	mod1.vBln6 = True
	If vInt59 <= 0 Or vAbs > vInt59 Then
		labelWrapper.Background = mod1.Sub155(Sub165(vAbs), 50)
		If vAbs = 4 Then
			labelWrapper.TextColor = -16777216
			i = vAbs
		Else
			labelWrapper.TextColor = -1
			i = vAbs
		End If
	Else
		labelWrapper.Background = mod1.Sub155(-7829368, 50)
		i = vAbs * 1
	End If
	vSql1.ExecNonQuery("update Ventmp set turno= " & i & " where totcre = '" & vCur16.GetString("totcre") & "'")
	refilltablelist(False)
	Sub278(labelWrapper)
End Sub

