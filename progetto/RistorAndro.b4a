Sub Sub098(j As Long)
	Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select * from venduto where qta <>0 and nmov = " & j)
	If cursorWrapper.RowCount > 0 Then
		Dim rowCount As Int = cursorWrapper.RowCount - 1
		Dim i As Int
		For i = 0 To rowCount
			cursorWrapper.Position = i
			If cursorWrapper.GetInt("brep") = 0 Then
				addRowPlu("com", False, False, "", False, "")
			Else
				vfunzioni1.Sub002(cursorWrapper)
			End If
			Dim vRound2 As Double = Round2(cursorWrapper.GetDouble("prezzov") * cursorWrapper.GetDouble("qta") - cursorWrapper.GetDouble("importo"), 2)
			Dim str As String = "NODEL"
			If cursorWrapper.GetString("codice").StartsWith("vv") Then
				str = "vvNODEL"
			Else If cursorWrapper.GetString("codice").StartsWith("ww") Then
				str = "wwNODEL"
			End If
			vSql1.ExecNonQuery("update Ventmp set iva=" & SmartStringFormatter("", cursorWrapper.GetString("iva")) & ", prezzov =" & SmartStringFormatter("", cursorWrapper.GetDouble("prezzov")) & CRLF & TAB & TAB & TAB & TAB & TAB & TAB & TAB & ", qta=" & SmartStringFormatter("", Round2(cursorWrapper.GetDouble("qta"), 3)) & ",totcre='" & SmartStringFormatter("", cursorWrapper.GetString("totcre")) & "'" & CRLF & TAB & TAB & TAB & TAB & TAB & TAB & TAB & ",descrizione='" & SmartStringFormatter("", cursorWrapper.GetString("descrizione")) & "',importo=" & SmartStringFormatter("", vRound2) & ",flgusointerno=0" & CRLF & TAB & TAB & TAB & TAB & TAB & TAB & TAB & ",QtaConDecimali=" & SmartStringFormatter("", cursorWrapper.GetString("QtaConDecimali")) & ",codice='" & SmartStringFormatter("", cursorWrapper.GetString("codice")) & "'" & CRLF & TAB & TAB & TAB & TAB & TAB & TAB & TAB & ",codice='" & SmartStringFormatter("", str) & "',ingredientisumf=" & SmartStringFormatter("", cursorWrapper.GetString("ingredientisumf")) & CRLF & TAB & TAB & TAB & TAB & TAB & TAB & TAB & "  where chiave = (Select Max(chiave) from Ventmp)")
		Next
	End If
	cursorWrapper.Close
End Sub

Sub Sub099(i As Int) As Boolean
	mod1.vStr2 = "Sub CreaPagina(pagina As Int)"
	Try
		Dim vMsgbox2 As Int = Msgbox2("Attenzione ... la sala risulta essere vuota" & CRLF & "Si desidera crearla ?", vStr8, "Si", "", "No", vBmp1)
		If vMsgbox2 <> -1 Then
			Return False
		End If
		Dim i2 As Int = vInt11 - 1
		Dim i3 As Int
		For i3 = 0 To i2
			Dim i4 As Int = i3 + 1
			vSql1.ExecNonQuery("insert into pagine(riga,colonna,pagina ,tasto , dimensione ,colore ,testo ,tipo ,valore,icona) values(" & i3 / vInt13 & "," & i3 Mod vInt13 & ", " & i & " , " & i3 & " , " & 1 & " , " & c_verde & " , '" & ("Tavolo " & i4) & "' , " & t_tavolo & " , " & i4 & ",0)")
		Next
		If Sub100(i, False) Then
			Return True
		End If
		vSql1.ExecNonQuery("delete from pagine where pagina = " & i)
		Return False
	Catch
		mod1.Sub217(LastException.Message)
		Return False
	End Try
End Sub

Sub Sub100(i As Int, z As Boolean) As Boolean
	Dim i2 As Int
	Dim str As String
	Dim z2 As Boolean
	Dim i3 As Int
	Dim i4 As Int
	Dim i5 As Int
	Dim z3 As Boolean
	Dim z4 As Boolean
	mod1.vStr2 = "Private Sub CreaSalaAuto()"
	Try
		Dim inputDialog2 As InputDialog = vDlg1
		vDlg1.InputType = 2
		vDlg1.Input = ""
		vDlg1.PasswordMode = True
		vDlg1.Hint = "Password"
		vDlg1.HintColor = Colors.ARGB(196, 255, 140, 0)
		Dim str2 As String = "( Massimo " & vInt11 & " per sala ," & vInt64 & " tavoli in totale)"
		If z Then
			i2 = vDlg1.Show("Inserire la password di accesso alla funzione", vStr8, "Ok", "Annulla", "", vBmp1)
		Else
			i2 = -1
			vDlg1.Input = "147896"
		End If
		If i2 = -1 Then
			If vDlg1.Input = "147896" Then
				Dim numberDialog As NumberDialog
				numberDialog.Digits = 3
				numberDialog.Number = 1
				numberDialog.Decimal = 0
				numberDialog.ShowSign = False
				Dim vShow As Int = numberDialog.Show("Inserire il numero del primo tavolo della sala " & str2, "Ok", "Annulla", "", vBmp1)
				If vShow = -1 Then
					If numberDialog.Number > 0 And numberDialog.Number < vInt64 Then
						Dim number As Int = numberDialog.Number
						numberDialog.Digits = 3
						numberDialog.Number = number + 1
						numberDialog.Decimal = 0
						numberDialog.ShowSign = False
						Dim vShow2 As Int = numberDialog.Show("Inserire il numero dell'ultimo tavolo della sala " & str2, "Ok", "Annulla", "", vBmp1)
						If vShow2 = -1 Then
							If numberDialog.Number > number And numberDialog.Number <= vInt64 Then
								Dim vInputList1 As Int = idLib.InputList1(ArrayToList(Array As String("1x1", "2x1(Orizzontale)", "1x2(Verticale)", "2x2")), "Selezionare la dimensione dei tavoli") + 1
								If vInputList1 <= 0 Then
									Return False
								End If
								Dim inputDialog5 As InputDialog = vDlg1
								vDlg1.InputType = 1
								vDlg1.Input = "Tavolo"
								vDlg1.PasswordMode = False
								vDlg1.Hint = "Descrizione "
								vDlg1.HintColor = Colors.ARGB(196, 255, 140, 0)
								Dim vShow3 As Int = vDlg1.Show("Inserire la descrizione di default per i tavoli", vStr8, "Ok", "Annulla", "", vBmp1)
								If vShow3 <> -1 Or vDlg1.Input = "" Then
									str = "Tavolo"
								Else
									str = vDlg1.Input
								End If
								Dim number2 As Int = numberDialog.Number
								If number2 - number > vInt11 Then
									Dim i6 As Int = vInt11
								End If
								Dim i7 As Int = 0
								Dim i8 As Int = number - 1
								Dim i9 As Int = vInt12 - 1
								Dim z5 As Boolean = False
								Dim z6 As Boolean = True
								Dim i10 As Int = 0
								Do While i9 >= 0
									Dim i11 As Int = vInt13 - 1
									Dim i12 As Int = 0
									Dim i13 As Int = i7
									Dim z7 As Boolean = z5
									Dim z8 As Boolean = z6
									Do While i12 <= i11
										Dim z9 As Boolean = False
										If vInputList1 = 2 Then
											z9 = (i12 Mod 2 <> 0)
											If i12 >= vInt13 - 1 Then
												z2 = True
												i3 = i8
											End If
											z2 = z9
											i3 = i8
										Else If vInputList1 = 3 Then
											z9 = ((vInt12 + 1 - i9) Mod 2 <> 0)
											If i9 = 0 Then
												z2 = True
												i3 = i8
											End If
											z2 = z9
											i3 = i8
										Else
											If vInputList1 = 4 Then
												z9 = IIf((vInt12 + 1 - i9) Mod 2 = 0 And i12 Mod 2 = 0, False, True)
												If i9 = 0 Or i12 >= vInt13 - 1 Then
													z2 = True
													i3 = i8
												End If
											End If
											z2 = z9
											i3 = i8
										End If
										Do While True
											If i3 <= vInt64 Then
												i4 = IIf(Not(z2), i3 + 1, i3)
												i5 = IIf(i4 = 0, 1, i4)
												If Not(z2) And vSql1.ExecQuerySingleResult("select count(*) from pagine where  pagina <>" & vInt30 & " and tipo =" & t_tavolo & " and valore =" & i5) > 0 Then
													If z8 Then
														Dim vMsgbox2 As Int = Msgbox2("Attenzione ... Alcuni dei tavoli che si stanno creando esistono già in altre sale." & CRLF & "Si desidera crearli ugualmente ?", vStr8, "Si", "", "No", vBmp1)
														z3 = (vMsgbox2 = -1)
														z4 = False
													Else
														z3 = z7
														z4 = z8
													End If
													If z3 Then
														z7 = z3
														z8 = z4
														i10 = i5
														i3 = i4
														Exit
													End If
													z7 = z3
													z8 = z4
													i10 = i5
													i3 = i4
												Else
													Exit
												End If
											Else
												Exit
											End If
										Loop
										i10 = i5
										i3 = i4
										If i10 > vInt64 Then
											i10 = vInt64
										End If
										If i3 > number2 Or z2 Then
											vSql1.ExecNonQuery("update pagine set dll='',icona =0,tipo = " & t_nulla & ",testo='',colore = " & c_grigio & ",valore =0,dimensione = 1 where pagina =" & i & " and riga=" & i9 & " and colonna=" & i12)
										Else
											vSql1.ExecNonQuery("update pagine set dll='',icona =0,tipo = " & t_tavolo & ",testo='" & str & " " & i10 & "',colore = " & c_verde & ",valore =" & i10 & ",dimensione = " & vInputList1 & " where pagina =" & i & " and riga=" & i9 & " and colonna=" & i12)
										End If
										i12 = i12 + 1
										i8 = i3
										i13 = i13 + 1
									Loop
									i9 = i9 - 1
									z6 = z8
									z5 = z7
									i7 = i13
								Loop
								Return i7 > 0
							End If
							Msgbox2("Valori non corretti ...", vStr8, "OK", "", "", vBmp1)
							Return False
						End If
					Else
						Msgbox2("Valori non corretti ...", vStr8, "OK", "", "", vBmp1)
						Return False
					End If
				End If
			Else
				Msgbox2("Password Errata", vStr8, "OK", "", "", vBmp1)
			End If
		End If
		Return False
	Catch
		mod1.Sub217(LastException.Message)
		Return False
	End Try
End Sub

