Sub Sub280
	Dim i As Int
	Initialize
	Dim sb2 As String = File.DirDefaultExternal & "/ReportPersonalizzati"
	Dim vListFiles As List = File.ListFiles(sb2)
	vListFiles.Sort(True)
	Dim list As List
	list.Initialize
	Dim map As Map
	map.Initialize
	If vListFiles.Size > 0 Then
		Dim list2 As List
		list2.Initialize
		list2.Add("Stampa Parziale")
		Dim size As Int = vListFiles.Size - 1
		Dim i2 As Int = 0
		Dim i3 As Int = 0
		Do While i2 <= size
			Dim vObjectToString As String = vListFiles.Get(i2)
			If vObjectToString.ToLowerCase.StartsWith("cf") And vObjectToString.ToLowerCase.EndsWith(".txt") Then
				Dim vReadMap As Map = File.ReadMap(sb2, vObjectToString)
				Dim vObjectToBoolean As Boolean = vReadMap.GetDefault("Mail", False)
				Dim vObjectToBoolean2 As Boolean = vReadMap.GetDefault("Stampa", False)
				Dim vObjectToBoolean3 As Boolean = vReadMap.GetDefault("Copia", False)
				Dim str As String = ""
				If vObjectToBoolean Or vObjectToBoolean2 Or vObjectToBoolean3 Then
					Dim str2 As String = IIf(vObjectToBoolean, " (Mail,", " (")
					If vObjectToBoolean2 Then
						str2 = str2 & "Stampa,"
					End If
					If vObjectToBoolean3 Then
						str2 = str2 & "Copia,"
					End If
					str = str2.SubString2(0, str2.Length - 1) & ")"
				End If
				list.Add(vObjectToString.Replace(".txt", " ").Replace("CF ", "") & str)
				map.Put(i3, vObjectToString)
				i = i3 + 1
			Else
				i = i3
			End If
			i2 = i2 + 1
			i3 = i
		Loop
		If map.Size = 0 Then
			Msgbox2("Non è stata trovata nessuna stampa da eseguire", vStr8, "OK", "", "", vBmp1)
			Return
		End If
		Dim vInputList1 As Int = idLib.InputList1(list, "Selezionare la stampa")
		If vInputList1 >= 0 Then
			Sub134(map.Get(vInputList1), list2, sb2)
			Return
		End If
		Return
	End If
	Msgbox2("Non è stata trovata nessuna stampa da eseguire", vStr8, "OK", "", "", vBmp1)
End Sub

