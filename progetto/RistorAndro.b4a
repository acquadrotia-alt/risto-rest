'### RISTRUTTURARE: Resumable Sub convertita come macchina a stati (comportamento identico all'originale).
Sub RiempiGrigliaAppuntamenti(mstart As Long)
	Dim limit19 As Int
	Dim limit33 As Int
	Dim step19 As Int
	Dim step33 As Int
	Dim pp As Period
	Dim pp2 As Period
	Dim currentrow As Int
	Dim bclearclva As Boolean
	Dim bwaitvisible As Boolean
	Dim xx As Int
	Dim rsState As Int = 0
	Dim rsCatchState As Int = 0
	Do While True
		Try
			Select rsState
				Case -1
					Return
				Case 0
					rsState = 1
					Continue
				Case 1
					rsState = 30
					rsCatchState = 29
					rsState = 3
					Continue
				Case 3
					rsState = 4
					rsCatchState = 29
					'pp = Period
					'pp2 = Period
					pp2.Hours = 1
					currentrow = 0
					bclearclva = (vLst34.Size = 0)
					Continue
				Case 4
					rsState = 9
					If bclearclva Then
						rsState = 6
						Continue
					Else
						rsState = 8
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 6
				Case 6
					rsState = 9
					vcustomlistviewold1.Sub004
					Continue
				Case 8
					rsState = 9
					currentrow = vcustomlistviewold1.getvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv4
					Continue
				Case 9
					rsState = 10
					pp.Hours = 0
					bPaginaAppuntamenti.Enabled = False
					bwaitvisible = True
					pWaitLoading.Visible = True
					DoEvents
					DoEvents
					Dim vPerYToCurrent As Double = PerYToCurrent(10)
					vCustomProgressDialog1._initialize(Activity, PerXToCurrent(60), (PerXToCurrent(100) - PerXToCurrent(60)) / 2, vPerYToCurrent, "", "", -12303292, 0, "Progress", False)
					Continue
				Case 10
					rsState = 17
					step19 = 1
					limit19 = vCur33.RowCount - 1
					xx = currentrow
					rsState = 31
					Continue
				Case 12
					rsState = 13
					vCur33.Position = xx
					Sub128(pp, mstart, bclearclva, xx)
					Continue
				Case 13
					rsState = 16
					If xx >= 15 And bwaitvisible Then
						rsState = 15
						Continue
					End If
					Continue
				Case 15
					rsState = 16
					pWaitLoading.SetVisibleAnimated(300, False)
					bwaitvisible = False
					Continue
				Case 16
					rsState = 32
					Sleep(1)
					rsState = 33
					Continue
				Case 17
					rsState = 20
					If Not(bwaitvisible) Then
						Continue
					Else
						rsState = 19
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 19
				Case 19
					rsState = 20
					pWaitLoading.SetVisibleAnimated(300, False)
					DoEvents
					Continue
				Case 20
					rsState = 27
					If currentrow <= 0 Then
						Continue
					Else
						rsState = 22
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 22
				Case 22
					rsState = 23
					Continue
				Case 23
					rsState = 26
					step33 = -1
					limit33 = 0
					xx = currentrow - 1
					rsState = 34
					Continue
				Case 25
					rsState = 35
					vCur33.Position = xx
					Sub128(pp, mstart, bclearclva, xx)
					Sleep(5)
					rsState = 36
					Continue
				Case 26
					rsState = 27
					Continue
				Case 27
					rsState = 30
					Continue
				Case 29
					rsState = 30
					rsCatchState = 0
					mod1.Sub217(LastException.Message)
					Continue
				Case 30
					rsState = -1
					rsCatchState = 0
					bPaginaAppuntamenti.Enabled = True
					pWaitLoading.Visible = False
					Continue
				Case 31
					rsState = 17
					If (step19 > 0 And xx <= limit19) Or (step19 < 0 And xx >= limit19) Then
						rsState = 12
						Continue
					End If
					Continue
				Case 32
					rsState = 31
					xx = xx + 0 + step19
					Continue
				Case 33
					rsState = 32
					Continue
				Case 34
					rsState = 26
					If (step33 > 0 And xx <= limit33) Or (step33 < 0 And xx >= limit33) Then
						rsState = 25
						Continue
					End If
					Continue
				Case 35
					rsState = 34
					xx = xx + 0 + step33
					Continue
				Case 36
					rsState = 35
					Continue
			End Select
		Catch
			If rsCatchState = 0 Then
				Log(LastException)
				Return
			End If
			rsState = rsCatchState
		End Try
	Loop
End Sub

