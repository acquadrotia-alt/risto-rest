Sub Qtadividi_Click
	Dim vTmp As Int
	mod1.vStr2 = "Sub Qtadividi_Click"
	Try
		vTmp = vcustomlistviewold3.Sub007(Sender)
	Catch
		mod1.Sub217(LastException.Message)
	End Try
	If vTmp < 0 Then
		Return
	End If
	Dim getpanel As Panel = vcustomlistviewold3.getpanel(vTmp)
	Dim labelWrapper As Label = getpanel.GetView(3)
	vCur16.Position = vTmp
	Dim vGetString As String = vCur16.GetString("chiave")
	If Sub056() Then
		Return
	End If
	If vBln105 Then
		vSql1.ExecNonQuery("update Ventmp set scovd= 0,importod=" & vCur16.GetString("importo").Replace(",", ".") & ",Qtad=1 where chiave =" & vGetString)
		If vCur16.GetDouble("qta") <> 1 Then
			vSql1.ExecNonQuery("update Ventmp set descrizione=substr('" & vCur16.GetString("qta") & " X ' || descrizione ,1,49), qta=1,prezzov=importo where chiave =" & vGetString)
		End If
		labelWrapper.Text = "1"
		labelWrapper.Background = mod1.Sub155(-16711936, 25)
	Else
		Dim cursorWrapper As Cursor = vSql1.ExecQuery("Select * from Ventmp where totcre = '" & vCur16.GetString("totcre") & "'")
		If cursorWrapper.RowCount > 0 Then
			Dim vTmp_ As Boolean = Sub081()
			Dim rowCount As Int = cursorWrapper.RowCount - 1
			Dim i As Int
			For i = 0 To rowCount
				cursorWrapper.Position = i
				Dim doubleValue As Double = cursorWrapper.GetDouble("Qtad") + 1
				If vTmp_ Or cursorWrapper.GetDouble("qta") Mod 1 <> 0 Then
					doubleValue = cursorWrapper.GetDouble("qta")
				Else If doubleValue > cursorWrapper.GetDouble("qta") Then
					Exit
				End If
				If cursorWrapper.GetString("chiave") = vCur16.GetString("chiave") Then
					If cursorWrapper.GetDouble("qta") Mod 1 <> 0 Then
						labelWrapper.Text = NumberFormat2(doubleValue, 1, 3, 3, False)
					Else
						labelWrapper.Text = NumberFormat(doubleValue, 1, 0)
					End If
					If doubleValue = cursorWrapper.GetDouble("qta") Then
						labelWrapper.Background = mod1.Sub155(-16711936, 25)
					End If
				End If
				vSql1.ExecNonQuery("update Ventmp set scovd= " & Round2(cursorWrapper.GetDouble("scov") / cursorWrapper.GetDouble("qta") * doubleValue, 2).Replace(",", ".") & ",importod=" & Round2(cursorWrapper.GetDouble("importo") / cursorWrapper.GetDouble("qta") * doubleValue, 2).Replace(",", ".") & ",Qtad=" & doubleValue & " where chiave =" & cursorWrapper.GetString("chiave"))
			Next
		End If
		cursorWrapper.Close
	End If
	Sub059(False)
	Sub005(vGetString)
	Sub278(labelWrapper)
End Sub

