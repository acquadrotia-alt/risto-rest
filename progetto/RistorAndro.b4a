	Loop
End Sub

Sub Variazionimenu_Click
	Dim vTmp As Int = vcustomlistviewold2.Sub007(Sender)
	If vTmp < 0 Then
		Return
	End If
	vcustomlistviewold2.getpanel(vTmp)
	vCur30.Position = vTmp
	If vCur30.GetInt("qtatmp") <= 0 Then
		Return
	End If
	Dim getpanel As Panel = vcustomlistviewold2.getpanel(vTmp)
	Dim labelWrapper As Label = getpanel.GetView(1)
	If labelWrapper.Text.Contains(CRLF) Then
		Msgbox2(labelWrapper.Text, vStr8, "OK", "", "", vBmp1)
	End If
End Sub

Sub Variazionimenu_LongClick
	Dim vTmp As Int = vcustomlistviewold2.Sub007(Sender)
	If vTmp < 0 Then
		Return
	End If
	vCur30.Position = vTmp
	If vCur30.GetInt("qtatmp") <= 0 Then
		Return
	End If
	vStr48 = vCur30.GetString("codint")
	vCustomLayoutDialog1.CloseDialog(-1)
End Sub

