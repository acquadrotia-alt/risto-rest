'### RISTRUTTURARE: Resumable Sub convertita come macchina a stati (comportamento identico all'originale).
Sub ShowMsgBoxInfoArticolo(testo As String, title As String, b As Button, codiceart As String)
	Dim j As httpjob
	Dim msg As String
	Dim tips As Builder
	Dim rsState As Int = 0
	Do While True
		Select rsState
			Case -1
				Return
			Case 0
				rsState = 1
				Continue
			Case 1
				rsState = 8
				If Not(vBln25) Then
					Continue
				Else
					rsState = 3
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 3
			Case 3
				rsState = 4
				Dim object As Class = Me
				Wait For (mod1.Sub065(object, "http://" & v_ipserver & ":12312/giac_" & codiceart & "_" & v_mver)) Jobdone (wf14_0 As httpjob)
				rsState = 14
				Continue
			Case 4
				rsState = 7
				If Not(j.vBln1) Then
					Continue
				Else
					rsState = 6
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 6
			Case 6
				rsState = 7
				msg = ""
				msg = j.Sub012
				testo = testo & msg
				Continue
			Case 7
				rsState = 8
				j.Sub024
				Continue
			Case 8
				rsState = 13
				If title <> "" Then
					rsState = 10
					Continue
				Else
					rsState = 12
					Continue
				End If
				'(fallthrough java verso il case successivo)
				rsState = 10
			Case 10
				rsState = 13
				'tips = Builder
				tips.Initialize("Tips")
				tips.Target = b.Title = title
				tips.Description = testo
				Dim builderWrapper As Builder = tips
				builderWrapper.DescriptionColor = -256
				Dim builderWrapper2 As Builder = tips
				builderWrapper2.CircleColor = -256
				tips.ButtonText = "Chiudi"
				tips.show
				Continue
			Case 12
				rsState = 13
				Dim vObjectToCharSequence As Object = testo
				Dim vObjectToCharSequence2 As Object = vStr8
				Msgbox2(vObjectToCharSequence, vObjectToCharSequence2, "OK", "", "", vBmp1)
				Continue
			Case 13
				rsState = -1
				Continue
			Case 14
				rsState = 4
				j = wf14_0
				Continue
		End Select
	Loop
End Sub

