		vCSBuilder1.Size(18).Bold.Color(-16776961).Append(str.SubString2(0, str.IndexOf(CRLF)).Replace("Turno Attivo: ", "Turno:")).PopAll
		str = str.SubString(str.IndexOf(CRLF))
	End If
	lblStato.Text = vCSBuilder1.Append(str)
End Sub

