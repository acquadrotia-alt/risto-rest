				End If
				Dim vTmp__ As Long = mod1.Sub058
				Dim vGetYear2 As Int = DateTime.GetYear(vTmp__)
				Dim vGetMonth2 As Int = DateTime.GetMonth(vTmp__)
				Dim setdate2 As Long = DateUtils.setdate(vGetYear2, vGetMonth2, DateTime.GetDayOfMonth(vTmp__))
				If Not(cursorWrapper3.GetLong("DataInizio") <= setdate2 And cursorWrapper3.GetLong("DataFine") >= setdate2) Then
					Dim vMsgbox23 As Int = Msgbox2("La prenotazione non è attiva in data odierna." & CRLF & "Si desidera comunque generare un documento ?", vStr8, "Si", "", "No", vBmp1)
