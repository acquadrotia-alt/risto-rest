Sub PagamentoMP
	Dim limit17 As Int
	Dim limit26 As Int
	Dim step17 As Int
	Dim step26 As Int
	Dim tmpccou As Cursor
	Dim listaconline As List
	Dim x As Int
	Dim reslst As List
	Dim tmpgrpcli As Int
	Dim rsState As Int = 0
	Dim rsCatchState As Int = 0
	Do While True
		Try
			Select rsState
				Case -1
					Return
				Case 0
					rsState = 1
					Continue
				Case 1
					rsState = 53
					rsCatchState = 52
					rsState = 3
					Continue
				Case 3
					rsState = 4
					rsCatchState = 52
					Continue
				Case 4
					rsState = 9
					If v_attivamp Then
						Continue
					Else
						rsState = 6
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 6
				Case 6
					rsState = 9
					Return
				Case 9
					rsState = 10
					vSql1.ExecNonQuery("DROP TABLE IF EXISTS TEMP.TmpVentmp")
					vSql1.ExecNonQuery("CREATE TEMP TABLE TmpVentmp AS SELECT * FROM Ventmp")
					vSql1.ExecNonQuery("DROP TABLE IF EXISTS TEMP.TmpVincoli")
					vSql1.ExecNonQuery("CREATE TEMP TABLE [TmpVincoli] (" & CRLF & TAB & TAB & TAB & TAB & TAB & "[chiave] integer Not Null DEFAULT 0 PRIMARY KEY AUTOINCREMENT," & CRLF & TAB & TAB & TAB & TAB & TAB & "[GruppoVincolo] int not NULL default 0, " & CRLF & TAB & TAB & TAB & TAB & TAB & "[Esito] int not NULL default 0" & CRLF & TAB & TAB & TAB & TAB & ")")
					Continue
				Case 10
					rsState = 44
					If vSql1.ExecQuerySingleResult("select count(*) from Ventmp  where codint = 'cou'") <= 0 Then
						Continue
					Else
						rsState = 12
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 12
				Case 12
					rsState = 13
					vSql1.ExecNonQuery("update Ventmp set memo ='NON NECESSARIO' where codint = 'cou'")
					Continue
				Case 13
					rsState = 43
					If Not(vBln20) Then
						Continue
					Else
						If Not(v_attivaterminale) Then
							Continue
						Else
							rsState = 15
							Continue
						End If
					End If
					'(fallthrough java verso il case successivo)
					rsState = 15
				Case 15
					rsState = 16
					Continue
				Case 16
					rsState = 42
					If vBln14 Then
						rsState = 18
						Continue
					Else
						rsState = 20
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 18
				Case 18
					rsState = 42
					Dim vObjectToCharSequence As Object = "Attenzione .... Il terminale è in stato Offline." & CRLF & "Restituire i coupon al cliente."
					Dim vObjectToCharSequence2 As Object = vStr8
					Msgbox2(vObjectToCharSequence, vObjectToCharSequence2, "OK", "", "", vBmp1)
					vSql1.ExecNonQuery("delete from Ventmp where codint = 'cou'")
					Continue
				Case 20
					rsState = 21
					'tmpccou = Cursor
					Dim cursorWrapper As Cursor
					tmpccou = vSql1.ExecQuery("select codice,chiave from Ventmp where codint = 'cou'")
					'listaconline = List
					listaconline.Initialize
					Continue
				Case 21
					rsState = 28
					step17 = 1
					limit17 = tmpccou.RowCount - 1
					x = 0
					rsState = 54
					Continue
				Case 23
					rsState = 24
					tmpccou.Position = x
					Continue
				Case 24
					rsState = 27
					If tmpccou.GetString("codice").SubString2(3, 4) <> "1" Then
						Continue
					Else
						rsState = 26
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 26
				Case 26
					rsState = 27
					listaconline.Add(tmpccou.GetString("codice"))
					Continue
				Case 27
					rsState = 55
					Continue
				Case 28
					rsState = 41
					If listaconline.Size <= 0 Then
						Continue
					Else
						rsState = 30
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 30
				Case 30
					rsState = 31
					CallSub3(ftpmanager, "SendObj", listaconline, "ValidaCoupon")
					Wait For (Null) Resvalidacoupon (wf56_0 As List)
					rsState = 56
					Continue
				Case 31
					rsState = 40
					step26 = 1
					limit26 = reslst.Size - 1
					x = 0
					rsState = 57
					Continue
				Case 33
					rsState = 34
					tmpccou.Position = x
					Continue
				Case 34
					rsState = 39
					If reslst.Get(x) = "0" Then
						rsState = 36
						Continue
					Else
						rsState = 38
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 36
				Case 36
					rsState = 39
					Dim vObjectToCharSequence3 As Object = "Attenzione .... il Coupon codice " & tmpccou.GetString("codice") & " non è valido."
					Dim vObjectToCharSequence4 As Object = vStr8
					Msgbox2(vObjectToCharSequence3, vObjectToCharSequence4, "OK", "", "", vBmp1)
					vSql1.ExecNonQuery("delete from Ventmp where chiave = " & tmpccou.GetString("chiave"))
					Continue
				Case 38
					rsState = 39
					vSql1.ExecNonQuery("update Ventmp set memo = codice  where chiave = " & tmpccou.GetString("chiave"))
					vSql1.ExecNonQuery("update Ventmp set codice = '" & v_prefissocoupon & "1" & reslst.Get(x) & "' where chiave = " & tmpccou.GetString("chiave"))
					Continue
				Case 39
					rsState = 58
					Continue
				Case 40
					rsState = 41
					Continue
				Case 41
					rsState = 42
					tmpccou.Close
					Continue
				Case 42
					rsState = 43
					Continue
				Case 43
					rsState = 44
					Continue
				Case 44
					rsState = 45
					tmpgrpcli = 0
					Continue
				Case 45
					rsState = 50
					If vStr28 <> "" Then
						rsState = 47
						Continue
					Else
						Continue
					End If
					'(fallthrough java verso il case successivo)
					rsState = 47
				Case 47
					rsState = 50
					tmpgrpcli = vCur17.GetInt("grpcli")
					Continue
				Case 50
					rsState = 53
					mod1.Sub149(vStr28, tmpgrpcli)
					Continue
				Case 52
					rsState = 53
					rsCatchState = 0
					mod1.Sub217(LastException.Message)
					Continue
				Case 53
					rsState = -1
					rsCatchState = 0
					Continue
				Case 54
					rsState = 28
					If (step17 > 0 And x <= limit17) Or (step17 < 0 And x >= limit17) Then
						rsState = 23
						Continue
					End If
					Continue
				Case 55
					rsState = 54
					x = x + 0 + step17
					Continue
				Case 56
					rsState = 31
					reslst = wf56_0
					Continue
				Case 57
					rsState = 40
					If (step26 > 0 And x <= limit26) Or (step26 < 0 And x >= limit26) Then
						rsState = 33
						Continue
					End If
					Continue
				Case 58
					rsState = 57
					x = x + 0 + step26
					Continue
			End Select
		Catch
			If rsCatchState = 0 Then
				Log(LastException)
				Return
			End If
			rsState = rsCatchState
		End Try
	Loop
End Sub

