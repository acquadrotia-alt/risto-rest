					j5 = vSql2.ExecQuerySingleResult("Select min(DataInizio) from PrenotaRisorsa where ID =" & SmartStringFormatter("", tappspiaggeVar.Risorsa) & " and DataInizio >" & SmartStringFormatter("", tappspiaggeVar.Data) & "")
