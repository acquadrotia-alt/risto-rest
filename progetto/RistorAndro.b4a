		If cursorWrapper.RowCount = 1 Then
			Return False
		End If
		Dim rowCount As Int = cursorWrapper.RowCount - 1
		Dim d As Double = 0
		Dim i As Int
		For i = 0 To rowCount
			cursorWrapper.Position = i
			If i = 0 Then
				d = cursorWrapper.GetDouble("qta")
			End If
			If cursorWrapper.GetDouble("importo") > 0 And d <> cursorWrapper.GetDouble("qta") Then
				Return True
			End If
		Next
		cursorWrapper.Close
		Return False
	End If
	cursorWrapper.Close
	Return False
End Sub

Sub Sub082(i As Int) As String
