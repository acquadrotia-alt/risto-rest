Sub Sub006
	Try
		Dim vGetDayOfWeek As Int = DateTime.GetDayOfWeek(vLng13) - 2
		Dim j As Long = vLng13
		Dim periodVar As Period
		periodVar.Days = vGetDayOfWeek * 1
		periodVar.Hours = DateTime.GetHour(j) * 1
		periodVar.Minutes = DateTime.GetMinute(j) * 1
		periodVar.Seconds = DateTime.GetSecond(j) * 1
		Dim addperiod As Long = DateUtils.addperiod(j, periodVar)
		lHeadAppuntamenti.Text = DateUtils.getmonthname(addperiod) & " "
		Dim periodVar2 As Period
		periodVar2.Days = 7
		Dim getmonthname As String = DateUtils.getmonthname(DateUtils.addperiod(addperiod, periodVar2))
		If getmonthname.Trim <> lHeadAppuntamenti.Text.Trim Then
			lHeadAppuntamenti.Text = lHeadAppuntamenti.Text & "- " & getmonthname
		End If
		lHeadAppuntamenti.Text = lHeadAppuntamenti.Text & " " & DateTime.GetYear(addperiod)
		periodVar.Days = 1
		periodVar.Hours = 0
		periodVar.Minutes = 0
		periodVar.Seconds = 0
		Dim i As Int = vInt96 - 1
		Dim j2 As Long = addperiod
		Dim i2 As Int
		For i2 = 0 To i
			Dim labelWrapper As Label = vLabelArr3(i2)
			labelWrapper.Text = DateUtils.getdayofweekname(j2) & " " & DateTime.GetDayOfMonth(j2)
			Dim vGetDayOfYear As Int = DateTime.GetDayOfYear(j2)
			If vGetDayOfYear = DateTime.GetDayOfYear(mod1.Sub058) Then
				Dim vGetYear As Int = DateTime.GetYear(j2)
				If vGetYear = DateTime.GetYear(mod1.Sub058) Then
					labelWrapper.TextColor = -16711936
					labelWrapper.Typeface = Typeface.DEFAULT_BOLD
					j2 = DateUtils.addperiod(j2, periodVar)
				End If
			End If
			labelWrapper.TextColor = -1
			If DateTime.GetDayOfMonth(j2) = 1 Then
				labelWrapper.Text = DateUtils.getmonthname(j2) & " " & labelWrapper.Text
				labelWrapper.Typeface = Typeface.DEFAULT_BOLD
			Else
				labelWrapper.Typeface = Typeface.DEFAULT
			End If
			j2 = DateUtils.addperiod(j2, periodVar)
		Next
		RiempiGrigliaAppuntamenti(addperiod)
		Return
	Catch
		mod1.Sub217(LastException.Message)
		Return
	End Try
End Sub

Sub Sub007(buttonWrapper As Button)
	Dim vSplit() As String = Regex.Split(",", buttonWrapper.Tag)
	If vSplit(2) = vInt13 - 1 Then
		Sub232(c_blu, c_blu, buttonWrapper, True, 15)
		Return
	End If
	Dim parseDouble As Int = vSplit(0)
	buttonWrapper.Visible = parseDouble > 0 Or vBln134
	If buttonWrapper.Visible Then
		Dim parseDouble2 As Int = vSplit(1)
		If parseDouble = t_funzione Then
			Sub232(c_blu, c_blu, buttonWrapper, True, 15)
			buttonWrapper.Text = mod1.Sub097(t_funzione, parseDouble2)
		Else If parseDouble = t_pagina Then
			Sub232(c_arancione, c_arancione, buttonWrapper, True, 15)
			buttonWrapper.Text = vSql1.ExecQuerySingleResult("Select descrizione from Despagine where codice =" & parseDouble2)
		Else If parseDouble = 0 Then
			buttonWrapper.Text = ""
		End If
		Sub253(buttonWrapper, buttonWrapper.Text)
	End If
End Sub

